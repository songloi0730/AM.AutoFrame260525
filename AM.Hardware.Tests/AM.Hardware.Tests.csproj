<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AnalysisMode>None</AnalysisMode>
    <NoWarn>$(NoWarn);CA2007;CA1707;xUnit1031;S108</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AM.Core\AM.Core.csproj" />
    <ProjectReference Include="..\AM.Core.Abstractions\AM.Core.Abstractions.csproj" />
    <ProjectReference Include="..\AM.Hardware.Comm\AM.Hardware.Comm.csproj" />
    <ProjectReference Include="..\AM.Hardware.IO\AM.Hardware.IO.csproj" />
    <ProjectReference Include="..\AM.Hardware.Motion\AM.Hardware.Motion.csproj" />
    <ProjectReference Include="..\AM.Hardware.Scanner\AM.Hardware.Scanner.csproj" />
    <ProjectReference Include="..\AM.Hardware.Vision\AM.Hardware.Vision.csproj" />
  </ItemGroup>

</Project>
