{
  "permissions": {
    "allow": [
      "Bash(dotnet build *)",
      "Bash(dotnet restore *)",
      "Bash(dotnet test *)",
      "Bash(dotnet run *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git mv *)",
      "Bash(mv .git/index.lock*)",
      "Bash(mv .git/HEAD.lock*)",
      "Bash(bash scripts/am-commit.sh *)",
      "Bash(bash .claude/hooks/*.sh)",
      "Bash(grep -viE \"obj/|bin/|RecipeService|IRecipeService|RecipeEventArgs|RecipeValidator|RecipeChanged|recipeService|RecipeNames|LoadRecipe|SaveRecipe|DeleteRecipe|GetRecipe|\\\\.Recipe\\\\b|RecipeModule|Recipe/|//|ActiveRecipe|SelectedRecipe|EditingRecipe|ChangeRecipe|RecipeText|recipe\\\\b\")",
      "Bash(git rm *)",
      "Bash(dotnet sln *)",
      "PowerShell(dotnet build AM.AutoFrame.sln -v:m -nologo 2>$null)",
      "PowerShell(\\(Get-Content PROJECT_STATUS.md -Encoding UTF8 | Measure-Object -Line\\).Lines; Get-Content PROJECT_STATUS.md -Encoding UTF8 -Tail 30)",
      "Bash(cd \"/c/Users/dinhn/OneDrive/C/VS/AM.AutoFrame\" && echo \"=== PointTable test refs to MotionPoint ===\" && grep -rn \"SetPositions\\\\|new MotionPoint\\\\|Positions =\" AM.Services.Tests/PointTableServiceTests.cs 2>/dev/null | head -20; echo \"=== Architecture tests ===\" && ls AM.Architecture.Tests/ && echo \"---\" && grep -rn \"IAxisDiagnostics\\\\|IMotionController\\\\|Abstractions\" AM.Architecture.Tests/*.cs | head -20)",
      "Bash(cd \"/c/Users/dinhn/OneDrive/C/VS/AM.AutoFrame\" && grep -rn \"TODO\" AM.Modules.Motion/*.cs AM.Core/Models/AxisSignals.cs AM.Core/Models/AxisFeedback.cs AM.Core.Abstractions/Interfaces/Hardware/IAxisDiagnostics.cs AM.Hardware.Motion/SimulatedMotionController.cs 2>/dev/null)",
      "PowerShell(Get-Process | Where-Object { $_.ProcessName -match \"AM.Application|autoframe|dotnet\" } | Select-Object ProcessName, Id, SessionId, MainWindowTitle | Format-Table -AutoSize)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-write-arch.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/post-write-cs.sh"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/post-write-cs.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/post-build.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-session-end.sh"
          }
        ]
      }
    ]
  }
}
