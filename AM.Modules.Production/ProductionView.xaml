<UserControl x:Class="AM.Modules.Production.ProductionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:AM.UI.Localization;assembly=AM.UI.Localization"
             xmlns:conv="clr-namespace:AM.Modules.Production.Converters"
             mc:Ignorable="d"
             Background="{DynamicResource Screen.BackgroundBrush}">

    <UserControl.Resources>
        <conv:IndexToVisibilityConverter x:Key="IndexToVis"/>
        <!-- Sub-tab pill (giống màn Cảnh báo S90) -->
        <Style x:Key="ProdTab" TargetType="RadioButton">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.SecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource Panel.BackgroundAltBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource Text.PrimaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: title + sub-tab + chọn cửa sổ + refresh -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{Binding [Nav.Production], Source={x:Static loc:Loc.Strings}}"
                       FontSize="18" FontWeight="Bold" VerticalAlignment="Center"
                       Foreground="{DynamicResource Text.HeadingBrush}"/>
            <!-- Sub-tab Tổng quan / Chi tiết sản phẩm (S92) -->
            <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                <RadioButton Style="{StaticResource ProdTab}" GroupName="prodtab" IsChecked="True"
                             Command="{Binding SelectSubTabCommand}" CommandParameter="0"
                             Content="{Binding [Prod.TabOverview], Source={x:Static loc:Loc.Strings}}"/>
                <RadioButton Style="{StaticResource ProdTab}" GroupName="prodtab" Margin="4,0,0,0"
                             Command="{Binding SelectSubTabCommand}" CommandParameter="1"
                             Content="{Binding [Prod.TabDetail], Source={x:Static loc:Loc.Strings}}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ComboBox Width="140" Height="30" VerticalContentAlignment="Center"
                          ItemsSource="{Binding WindowOptions}"
                          SelectedItem="{Binding SelectedWindow, Mode=TwoWay}"/>
                <Button Content="{Binding [Prod.Refresh], Source={x:Static loc:Loc.Strings}}"
                        Width="90" Height="30" Margin="8,0,0,0" Command="{Binding RefreshCommand}"
                        Background="{DynamicResource Button.PrimaryBrush}"
                        Foreground="{DynamicResource Status.ForegroundBrush}" BorderThickness="0"/>
                <!-- Export CSV record trong cửa sổ (P4.4) -->
                <Button Content="{Binding [Prod.Export], Source={x:Static loc:Loc.Strings}}"
                        Height="30" Padding="12,0" Margin="8,0,0,0" Command="{Binding ExportCsvCommand}"
                        Background="{DynamicResource Panel.BackgroundAltBrush}"
                        BorderBrush="{DynamicResource Border.DefaultBrush}" BorderThickness="1"
                        Foreground="{DynamicResource Text.PrimaryBrush}"/>
            </StackPanel>
        </DockPanel>

        <!-- KPI cards (pane Tổng quan) -->
        <UniformGrid Grid.Row="1" Columns="3" Rows="2"
                     Visibility="{Binding SubTab, Converter={StaticResource IndexToVis}, ConverterParameter=0}">
            <!-- Total -->
            <Border Margin="4" CornerRadius="6" Padding="16" Background="{DynamicResource Panel.BackgroundBrush}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Total}" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center"
                               Foreground="{DynamicResource Text.LiveValueBrush}"/>
                    <TextBlock Text="{Binding [Prod.Total], Source={x:Static loc:Loc.Strings}}" FontSize="12"
                               HorizontalAlignment="Center" Foreground="{DynamicResource Text.SecondaryBrush}"/>
                </StackPanel>
            </Border>
            <!-- OK -->
            <Border Margin="4" CornerRadius="6" Padding="16" Background="{DynamicResource Panel.BackgroundBrush}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Passed}" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center"
                               Foreground="{DynamicResource Status.NormalBrush}"/>
                    <TextBlock Text="{Binding [Prod.OK], Source={x:Static loc:Loc.Strings}}" FontSize="12"
                               HorizontalAlignment="Center" Foreground="{DynamicResource Text.SecondaryBrush}"/>
                </StackPanel>
            </Border>
            <!-- NG -->
            <Border Margin="4" CornerRadius="6" Padding="16" Background="{DynamicResource Panel.BackgroundBrush}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Failed}" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center"
                               Foreground="{DynamicResource Status.AlarmBrush}"/>
                    <TextBlock Text="{Binding [Prod.NG], Source={x:Static loc:Loc.Strings}}" FontSize="12"
                               HorizontalAlignment="Center" Foreground="{DynamicResource Text.SecondaryBrush}"/>
                </StackPanel>
            </Border>
            <!-- Yield — màu-khi-có-nghĩa theo ngưỡng config (P4.4): vàng dưới Warn, đỏ dưới Alarm -->
            <Border Margin="4" CornerRadius="6" Padding="16" Background="{DynamicResource Panel.BackgroundBrush}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding YieldPercent, StringFormat={}{0:F1}%}" FontSize="34" FontWeight="Bold"
                               HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Text.LiveValueBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding YieldLevel}" Value="1">
                                        <Setter Property="Foreground" Value="{StaticResource Warn.TextBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding YieldLevel}" Value="2">
                                        <Setter Property="Foreground" Value="{StaticResource Status.AlarmBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding [Prod.Yield], Source={x:Static loc:Loc.Strings}}" FontSize="12"
                               HorizontalAlignment="Center" Foreground="{DynamicResource Text.SecondaryBrush}"/>
                </StackPanel>
            </Border>
            <!-- UPH -->
            <Border Margin="4" CornerRadius="6" Padding="16" Background="{DynamicResource Panel.BackgroundBrush}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding UnitsPerHour, StringFormat={}{0:F1}}" FontSize="34" FontWeight="Bold"
                               HorizontalAlignment="Center" Foreground="{DynamicResource Text.LiveValueBrush}"/>
                    <TextBlock Text="{Binding [Prod.UPH], Source={x:Static loc:Loc.Strings}}" FontSize="12"
                               HorizontalAlignment="Center" Foreground="{DynamicResource Text.SecondaryBrush}"/>
                </StackPanel>
            </Border>
            <!-- Avg cycle -->
            <Border Margin="4" CornerRadius="6" Padding="16" Background="{DynamicResource Panel.BackgroundBrush}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding AvgCycleTimeMs, StringFormat={}{0:F0} ms}" FontSize="34" FontWeight="Bold"
                               HorizontalAlignment="Center" Foreground="{DynamicResource Text.LiveValueBrush}"/>
                    <TextBlock Text="{Binding [Prod.Cycle], Source={x:Static loc:Loc.Strings}}" FontSize="12"
                               HorizontalAlignment="Center" Foreground="{DynamicResource Text.SecondaryBrush}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Trend theo giờ (P4.4 — SPC đơn giản, pane Tổng quan) -->
        <Border Grid.Row="2" Margin="4,12,4,0" CornerRadius="6" Padding="16"
                Visibility="{Binding SubTab, Converter={StaticResource IndexToVis}, ConverterParameter=0}"
                Background="{DynamicResource Panel.BackgroundBrush}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"
                           Text="{Binding [Prod.TrendTitle], Source={x:Static loc:Loc.Strings}}"
                           Foreground="{DynamicResource Text.HeadingBrush}"/>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" FontSize="12"
                           Margin="0,8,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource Text.SecondaryBrush}"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <TextBlock Text="{Binding [Prod.NoData], Source={x:Static loc:Loc.Strings}}"
                                   FontSize="13" Foreground="{DynamicResource Text.SecondaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HourStats.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding HourStats}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding HourLabel}" FontFamily="Consolas"
                                                   FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Text.SecondaryBrush}"/>
                                        <!-- Thanh yield 0–100% (scale 3px/1%) — màu theo mức -->
                                        <Border Grid.Column="1" Height="14" CornerRadius="2" HorizontalAlignment="Left"
                                                Width="{Binding BarWidth}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource Status.NormalBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding YieldLevel}" Value="1">
                                                            <Setter Property="Background" Value="{StaticResource Warn.TextBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding YieldLevel}" Value="2">
                                                            <Setter Property="Background" Value="{StaticResource Status.AlarmBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding YieldText}" FontSize="12"
                                                   FontFamily="Consolas" VerticalAlignment="Center" Margin="8,0,0,0"
                                                   Foreground="{DynamicResource Text.PrimaryBrush}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding CycleText}" FontSize="12"
                                                   FontFamily="Consolas" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Text.PrimaryBrush}"/>
                                        <TextBlock Grid.Column="4" FontSize="12" FontFamily="Consolas"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Text.SecondaryBrush}">
                                            <Run Text="n="/><Run Text="{Binding Total, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ═══ PANE Chi tiết sản phẩm (S92): lọc SN/KQ + bảng từng SP + Pareto NG theo lý do ═══ -->
        <Grid Grid.Row="1" Grid.RowSpan="2" Margin="4,0,4,0"
              Visibility="{Binding SubTab, Converter={StaticResource IndexToVis}, ConverterParameter=1}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Bộ lọc: SN + kết quả — label luôn hiện (RefUX-A) -->
            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="{Binding [Prod.SnFilter], Source={x:Static loc:Loc.Strings}}"
                           VerticalAlignment="Center" Margin="0,0,6,0"
                           Foreground="{DynamicResource Text.SecondaryBrush}"/>
                <TextBox Width="180" Height="30" VerticalContentAlignment="Center" Padding="6,0"
                         Text="{Binding SnFilter, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="{Binding [Prod.Result], Source={x:Static loc:Loc.Strings}}"
                           VerticalAlignment="Center" Margin="16,0,6,0"
                           Foreground="{DynamicResource Text.SecondaryBrush}"/>
                <ComboBox Width="110" Height="30" VerticalContentAlignment="Center"
                          SelectedIndex="{Binding ResultFilterIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="{Binding [Prod.ResultAll], Source={x:Static loc:Loc.Strings}}"/>
                    <ComboBoxItem Content="OK"/>
                    <ComboBoxItem Content="NG"/>
                </ComboBox>
                <TextBlock Text="{Binding DetailCountText}" VerticalAlignment="Center" Margin="16,0,0,0"
                           FontSize="12" Foreground="{DynamicResource Text.SecondaryBrush}"/>
            </StackPanel>

            <!-- Bảng chi tiết (virtualized 500 dòng, read-only — mọi cột OneWay) -->
            <DataGrid Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Records}"
                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" CanUserAddRows="False" CanUserResizeRows="False"
                      EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      Background="{DynamicResource Panel.BackgroundBrush}" BorderThickness="0"
                      RowHeight="30" FontSize="13">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{Binding [Prod.ColTime], Source={x:Static loc:Loc.Strings}}"
                                        Binding="{Binding TimeText, Mode=OneWay}" Width="130"/>
                    <DataGridTextColumn Header="SN" Binding="{Binding SerialNumber, Mode=OneWay}" Width="170"/>
                    <DataGridTextColumn Header="Recipe" Binding="{Binding RecipeName, Mode=OneWay}" Width="110"/>
                    <DataGridTemplateColumn Header="{Binding [Prod.Result], Source={x:Static loc:Loc.Strings}}" Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ResultText, Mode=OneWay}" FontWeight="SemiBold"
                                           VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Status.NormalBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPassed}" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource Status.AlarmBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Cycle" Binding="{Binding CycleText, Mode=OneWay}" Width="80"/>
                    <DataGridTextColumn Header="Vision" Binding="{Binding ScoreText, Mode=OneWay}" Width="60"/>
                    <DataGridTextColumn Header="{Binding [Prod.ColReason], Source={x:Static loc:Loc.Strings}}"
                                        Binding="{Binding FailReason, Mode=OneWay}" Width="*"/>
                    <DataGridTextColumn Header="{Binding [Prod.ColOperator], Source={x:Static loc:Loc.Strings}}"
                                        Binding="{Binding OperatorId, Mode=OneWay}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Pareto NG theo lý do — trả lời "lỗi nào hay rớt" -->
            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="12,0,0,0" CornerRadius="6"
                    Padding="14" VerticalAlignment="Stretch"
                    Background="{DynamicResource Panel.BackgroundBrush}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"
                               Text="{Binding [Prod.FailPareto], Source={x:Static loc:Loc.Strings}}"
                               Foreground="{DynamicResource Text.HeadingBrush}"/>
                    <Grid>
                        <TextBlock Text="{Binding [Prod.NoNg], Source={x:Static loc:Loc.Strings}}" FontSize="12"
                                   Foreground="{DynamicResource Text.SecondaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FailStats.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding FailStats}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,8">
                                        <DockPanel>
                                            <TextBlock Text="{Binding Reason}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Reason}"
                                                       Foreground="{DynamicResource Text.PrimaryBrush}"/>
                                            <TextBlock HorizontalAlignment="Right" FontSize="12" FontFamily="Consolas"
                                                       Foreground="{DynamicResource Text.SecondaryBrush}">
                                                <Run Text="{Binding Count, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding PercentText, Mode=OneWay}"/>
                                            </TextBlock>
                                        </DockPanel>
                                        <Border Height="8" CornerRadius="3" Margin="0,3,0,0" HorizontalAlignment="Left"
                                                Width="{Binding BarWidth}"
                                                Background="{DynamicResource Status.AlarmBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
