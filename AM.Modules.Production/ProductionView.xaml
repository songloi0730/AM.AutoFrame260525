<UserControl x:Class="AM.Modules.Production.ProductionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:AM.UI.Localization;assembly=AM.UI.Localization"
             mc:Ignorable="d"
             Background="{DynamicResource Screen.BackgroundBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: title + chọn cửa sổ + refresh -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{Binding [Nav.Production], Source={x:Static loc:Loc.Strings}}"
                       FontSize="18" FontWeight="Bold" VerticalAlignment="Center"
                       Foreground="{DynamicResource Text.HeadingBrush}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ComboBox Width="140" Height="30" VerticalContentAlignment="Center"
                          ItemsSource="{Binding WindowOptions}"
                          SelectedItem="{Binding SelectedWindow, Mode=TwoWay}"/>
                <Button Content="{Binding [Prod.Refresh], Source={x:Static loc:Loc.Strings}}"
                        Width="90" Height="30" Margin="8,0,0,0" Command="{Binding RefreshCommand}"
                        Background="{DynamicResource Button.PrimaryBrush}"
                        Foreground="{DynamicResource Status.ForegroundBrush}" BorderThickness="0"/>
            </StackPanel>
        </DockPanel>

        <!-- KPI cards -->
        <UniformGrid Grid.Row="1" Columns="3" Rows="2">
            <!-- Total -->
            <Border Margin="4" CornerRadius="6" Padding="16" Background="{DynamicResource Panel.BackgroundBrush}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Total}" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center"
                               Foreground="{DynamicResource Text.LiveValueBrush}"/>
                    <TextBlock Text="{Binding [Prod.Total], Source={x:Static loc:Loc.Strings}}" FontSize="12"
                               HorizontalAlignment="Center" Foreground="{DynamicResource Text.SecondaryBrush}"/>
                </StackPanel>
            </Border>
            <!-- OK -->
            <Border Margin="4" CornerRadius="6" Padding="16" Background="{DynamicResource Panel.BackgroundBrush}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Passed}" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center"
                               Foreground="{DynamicResource Status.NormalBrush}"/>
                    <TextBlock Text="{Binding [Prod.OK], Source={x:Static loc:Loc.Strings}}" FontSize="12"
                               HorizontalAlignment="Center" Foreground="{DynamicResource Text.SecondaryBrush}"/>
                </StackPanel>
            </Border>
            <!-- NG -->
            <Border Margin="4" CornerRadius="6" Padding="16" Background="{DynamicResource Panel.BackgroundBrush}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Failed}" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center"
                               Foreground="{DynamicResource Status.AlarmBrush}"/>
                    <TextBlock Text="{Binding [Prod.NG], Source={x:Static loc:Loc.Strings}}" FontSize="12"
                               HorizontalAlignment="Center" Foreground="{DynamicResource Text.SecondaryBrush}"/>
                </StackPanel>
            </Border>
            <!-- Yield -->
            <Border Margin="4" CornerRadius="6" Padding="16" Background="{DynamicResource Panel.BackgroundBrush}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding YieldPercent, StringFormat={}{0:F1}%}" FontSize="34" FontWeight="Bold"
                               HorizontalAlignment="Center" Foreground="{DynamicResource Text.LiveValueBrush}"/>
                    <TextBlock Text="{Binding [Prod.Yield], Source={x:Static loc:Loc.Strings}}" FontSize="12"
                               HorizontalAlignment="Center" Foreground="{DynamicResource Text.SecondaryBrush}"/>
                </StackPanel>
            </Border>
            <!-- UPH -->
            <Border Margin="4" CornerRadius="6" Padding="16" Background="{DynamicResource Panel.BackgroundBrush}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding UnitsPerHour, StringFormat={}{0:F1}}" FontSize="34" FontWeight="Bold"
                               HorizontalAlignment="Center" Foreground="{DynamicResource Text.LiveValueBrush}"/>
                    <TextBlock Text="{Binding [Prod.UPH], Source={x:Static loc:Loc.Strings}}" FontSize="12"
                               HorizontalAlignment="Center" Foreground="{DynamicResource Text.SecondaryBrush}"/>
                </StackPanel>
            </Border>
            <!-- Avg cycle -->
            <Border Margin="4" CornerRadius="6" Padding="16" Background="{DynamicResource Panel.BackgroundBrush}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding AvgCycleTimeMs, StringFormat={}{0:F0} ms}" FontSize="34" FontWeight="Bold"
                               HorizontalAlignment="Center" Foreground="{DynamicResource Text.LiveValueBrush}"/>
                    <TextBlock Text="{Binding [Prod.Cycle], Source={x:Static loc:Loc.Strings}}" FontSize="12"
                               HorizontalAlignment="Center" Foreground="{DynamicResource Text.SecondaryBrush}"/>
                </StackPanel>
            </Border>
        </UniformGrid>
    </Grid>
</UserControl>
