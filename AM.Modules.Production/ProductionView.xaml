<!--
    ProductionView.xaml — AM.Modules.Production
    ISA-101 Level-1/2 Screen: Production Dashboard (KPI + Batch + History)
    ════════════════════════════════════════════════════════════════════════
    Layout:
      [KPI Row  ] UPH | Today | Yield% | Cycle Time | Uptime — large numbers
      [Body     ]
        Left (50%): Hourly UPH trend (bar chart placeholder)
        Right(50%): Batch info + recent production records table
      [Footer   ] Shift selector + Export button
    ════════════════════════════════════════════════════════════════════════
-->
<UserControl x:Class="AM.Modules.Production.ProductionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{DynamicResource Screen.BackgroundBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- KPI row -->
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>      <!-- Charts + tables -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>   <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- ═══ KPI Row (SEMI S95: Equipment performance metrics) ════════════ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- UPH -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding CurrentUph}" Style="{StaticResource KpiValue}"/>
                    <TextBlock Text="UPH (hiện tại)" Style="{StaticResource KpiLabel}"/>
                </StackPanel>
            </Border>

            <!-- Today count -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding TodayCount}"
                               Style="{StaticResource KpiValue}"
                               Foreground="{DynamicResource Text.PrimaryBrush}"/>
                    <TextBlock Text="Hôm nay" Style="{StaticResource KpiLabel}"/>
                </StackPanel>
            </Border>

            <!-- Yield -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding YieldPercent, StringFormat='{}{0:F1}%'}"
                               Style="{StaticResource KpiValue}"
                               Foreground="{StaticResource Status.NormalBrush}"/>
                    <TextBlock Text="Yield" Style="{StaticResource KpiLabel}"/>
                </StackPanel>
            </Border>

            <!-- Cycle time -->
            <Border Grid.Column="3" Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding AvgCycleTime, StringFormat='{}{0:F1}s'}"
                               Style="{StaticResource KpiValue}"/>
                    <TextBlock Text="Cycle Time (avg)" Style="{StaticResource KpiLabel}"/>
                </StackPanel>
            </Border>

            <!-- Machine uptime -->
            <Border Grid.Column="4" Style="{StaticResource Card}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding UptimePercent, StringFormat='{}{0:F1}%'}"
                               Style="{StaticResource KpiValue}"
                               Foreground="{StaticResource Status.InfoBrush}"/>
                    <TextBlock Text="Uptime" Style="{StaticResource KpiLabel}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ Body ════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ─── Left: UPH hourly trend (bar chart using ItemsControl) ── -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="UPH theo giờ"
                               Style="{StaticResource SectionHeader}"/>

                    <!-- Bar chart (simplified — ItemsControl with scaled bar widths) -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding HourlyUph}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Bottom"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Vertical" Margin="4,0"
                                                VerticalAlignment="Bottom"
                                                HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Uph}"
                                                   FontSize="10" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource Text.LiveValueBrush}"/>
                                        <Rectangle Width="28"
                                                   Height="{Binding BarHeight}"
                                                   Fill="{DynamicResource Status.NormalBrush}"
                                                   RadiusX="2" RadiusY="2"/>
                                        <TextBlock Text="{Binding Hour}"
                                                   FontSize="9" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource Text.SecondaryBrush}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ─── Right: Batch info + production records table ────────── -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- Batch info card -->
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>      <!-- History table -->
                </Grid.RowDefinitions>

                <!-- Batch info -->
                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Lô hiện tại" Style="{StaticResource KpiLabel}"
                                       HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding CurrentBatchId}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text.HeadingBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Mục tiêu" Style="{StaticResource KpiLabel}"
                                       HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding BatchTarget}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text.PrimaryBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Production records history -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Lịch sử sản xuất"
                                   Style="{StaticResource SectionHeader}"/>
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding RecentRecords}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" GridLinesVisibility="Horizontal"
                                  Background="{DynamicResource Panel.BackgroundBrush}"
                                  Foreground="{DynamicResource Text.PrimaryBrush}"
                                  BorderBrush="{DynamicResource Border.DefaultBrush}"
                                  RowBackground="{DynamicResource Grid.RowBrush}"
                                  AlternatingRowBackground="{DynamicResource Grid.AltRowBrush}"
                                  ColumnHeaderStyle="{StaticResource GridHeaderStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Thời gian"
                                                    Binding="{Binding Timestamp, StringFormat='HH:mm:ss'}"
                                                    Width="80"/>
                                <DataGridTextColumn Header="OK" Binding="{Binding OkCount}" Width="60"/>
                                <DataGridTextColumn Header="NG" Binding="{Binding NgCount}" Width="60"/>
                                <DataGridTextColumn Header="CT (s)"
                                                    Binding="{Binding CycleTimeMs, StringFormat='{}{0:F1}'}"
                                                    Width="70"/>
                                <DataGridTextColumn Header="Lô" Binding="{Binding BatchId}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ═══ Footer ══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="Ca:" Foreground="{DynamicResource Text.SecondaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                <ComboBox ItemsSource="{Binding Shifts}"
                          SelectedItem="{Binding SelectedShift}"
                          Style="{StaticResource InputCombo}" Width="120"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="📤 Export CSV"
                        Command="{Binding ExportCommand}"
                        Style="{StaticResource ButtonBase}"
                        Width="110" Height="36"
                        Background="{DynamicResource Button.NeutralBrush}"/>
                <Button Content="🗑 Reset Shift"
                        Command="{Binding ResetShiftCommand}"
                        Style="{StaticResource ButtonBase}"
                        Width="110" Height="36" Margin="8,0,0,0"
                        Background="{DynamicResource Button.DangerBrush}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
