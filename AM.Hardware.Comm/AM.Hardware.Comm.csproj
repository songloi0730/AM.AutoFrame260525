<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AM.Hardware.Comm</RootNamespace>
    <AssemblyName>AM.Hardware.Comm</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />

    <!-- Serial port support (System.IO.Ports là separate NuGet trên .NET) -->
    <PackageReference Include="System.IO.Ports" />

    <!--
      Real Modbus TCP driver — uncomment khi cần:
      <PackageReference Include="FluentModbus" />
      hoặc: <PackageReference Include="NModbus4" />

      Real OPC UA driver — uncomment khi cần:
      <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua" />

      Real Ethernet/IP driver — uncomment khi cần:
      <PackageReference Include="libplctag.NETCore" />
    -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AM.Core\AM.Core.csproj" />
    <ProjectReference Include="..\AM.Core.Abstractions\AM.Core.Abstractions.csproj" />
  </ItemGroup>

</Project>
