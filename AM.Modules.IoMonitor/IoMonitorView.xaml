<UserControl x:Class="AM.Modules.IoMonitor.IoMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:AM.Modules.IoMonitor.Converters"
             xmlns:loc="clr-namespace:AM.UI.Localization;assembly=AM.UI.Localization"
             mc:Ignorable="d"
             Background="{DynamicResource Screen.BackgroundBrush}">

    <UserControl.Resources>
        <conv:BoolToIoBrushConverter x:Key="IoBrush"/>
        <conv:IoIndicatorToBrushConverter x:Key="IndBrush"/>
        <!-- Nền nhạt cảnh báo cho panel Output khi ở Chế độ Force (đỏ alpha thấp). -->
        <SolidColorBrush x:Key="Io.ForceBackgroundBrush" Color="#22C0392B"/>

        <!-- Chỉ báo trạng thái kênh: đèn tròn (off/on/pending) hoặc ô vuông đỏ chữ F (forced) -->
        <DataTemplate x:Key="IoIndicatorTemplate">
            <Grid Width="18" Height="18" VerticalAlignment="Center">
                <Ellipse Width="14" Height="14" Stroke="#33000000" StrokeThickness="1"
                         Fill="{Binding Indicator, Converter={StaticResource IndBrush}}">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Indicator}" Value="Forced">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <!-- Pending: nhấp nháy -->
                                <DataTrigger Binding="{Binding Indicator}" Value="Pending">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard Name="Blink">
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="1" To="0.25" Duration="0:0:0.6"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="Blink"/>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <!-- FORCED: ô vuông đỏ chữ F -->
                <Border Width="14" Height="14" CornerRadius="2" BorderThickness="2"
                        BorderBrush="{DynamicResource Status.AlarmBrush}" Background="#1FC0392B">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Indicator}" Value="Forced">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="F" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Foreground="{DynamicResource Status.AlarmBrush}"/>
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding [Nav.IoMonitor], Source={x:Static loc:Loc.Strings}}"
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,12"
                   Foreground="{DynamicResource Text.HeadingBrush}"/>

        <!-- Dải khóa set/reset: giải thích khả dụng/lý do thay vì ẩn nút -->
        <Border Grid.Row="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,10"
                Background="{DynamicResource Panel.BackgroundAltBrush}">
            <TextBlock Text="{Binding LockText}" FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource Text.SecondaryBrush}"/>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ════ Digital Inputs (chỉ đọc) + nhóm Xi lanh ════ -->
            <Border Grid.Column="0" Margin="0,0,8,0" CornerRadius="6" Padding="12"
                    Background="{DynamicResource Panel.BackgroundBrush}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding [Io.DigitalInputs], Source={x:Static loc:Loc.Strings}}"
                               FontWeight="SemiBold" Margin="0,0,0,8"
                               Foreground="{DynamicResource Text.SecondaryBrush}"/>
                    <!-- Ô lọc -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Grid.Column="1" Height="30" VerticalContentAlignment="Center"
                                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                                 ToolTip="{Binding [Io.FilterHint], Source={x:Static loc:Loc.Strings}}"/>
                    </Grid>

                    <!-- Nhóm Xi lanh (suy từ cặp cảm biến) -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasCylinders}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{Binding [Io.Cylinders], Source={x:Static loc:Loc.Strings}}"
                                   FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource Text.SecondaryBrush}"/>
                        <ItemsControl ItemsSource="{Binding Cylinders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,2" Padding="8,5" CornerRadius="4"
                                            Background="{DynamicResource Panel.BackgroundAltBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- chỉ báo: đèn (kẹp/nhả) hoặc ▲ (giữa) -->
                                            <Grid Grid.Column="0" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <Ellipse Width="14" Height="14" Stroke="#33000000" StrokeThickness="1">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{DynamicResource Status.DisabledBrush}"/>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding State}" Value="Clamped">
                                                                    <Setter Property="Fill" Value="{DynamicResource Status.NormalBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="Mid">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <!-- ▲ giữa (nghi kẹt) -->
                                                <Path Data="M 7,0 L 14,14 L 0,14 Z" Fill="{DynamicResource Status.WarningBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding State}" Value="Mid">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </Grid>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding DisplayName}"
                                                       Foreground="{DynamicResource Text.PrimaryBrush}"/>
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold"
                                                       Text="{Binding StateText}" Foreground="{DynamicResource Text.SecondaryBrush}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding DigitalInputs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1" Height="34" ToolTip="{Binding Tag}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ContentControl Grid.Column="0" Content="{Binding}" Margin="2,0,8,0"
                                                        ContentTemplate="{StaticResource IoIndicatorTemplate}"/>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Address}"
                                                   FontFamily="Consolas" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Text.PrimaryBrush}"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource Text.SecondaryBrush}"/>
                                            <TextBlock Text="{Binding RawName, StringFormat=' / {0}'}"
                                                       Foreground="{DynamicResource Text.DisabledBrush}" FontSize="12">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RawName}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ════ Digital Outputs: set/reset thường + Chế độ Force ════ -->
            <Border Grid.Column="1" Margin="8,0,0,0" CornerRadius="6" Padding="12" BorderThickness="2">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource Panel.BackgroundBrush}"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ForceMode}" Value="True">
                                <Setter Property="Background" Value="{StaticResource Io.ForceBackgroundBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Status.AlarmBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <!-- Thanh đầu bảng: tiêu đề + toggle Chế độ Force (Admin) -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                   Text="{Binding [Io.DigitalOutputs], Source={x:Static loc:Loc.Strings}}"
                                   FontWeight="SemiBold" Foreground="{DynamicResource Text.SecondaryBrush}"/>
                        <ToggleButton Grid.Column="1" Padding="12,4" Cursor="Hand"
                                      Content="{Binding [Io.ForceMode], Source={x:Static loc:Loc.Strings}}"
                                      IsChecked="{Binding ForceMode}"
                                      IsEnabled="{Binding IsForceModeAllowed}"
                                      ToolTip="{Binding [Io.ForceModeHint], Source={x:Static loc:Loc.Strings}}"/>
                    </Grid>

                    <!-- Bộ đếm "đang FORCE N IO — nhớ gỡ" -->
                    <Border DockPanel.Dock="Top" Margin="0,0,0,8" CornerRadius="4" Padding="8,5"
                            Background="{DynamicResource Status.AlarmBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ForcedCount}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ForcedCountText}" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Status.ForegroundBrush}"/>
                    </Border>

                    <!-- Ô lọc -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Grid.Column="1" Height="30" VerticalContentAlignment="Center"
                                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                                 ToolTip="{Binding [Io.FilterHint], Source={x:Static loc:Loc.Strings}}"/>
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding DigitalOutputs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,1" Padding="8,5" HorizontalContentAlignment="Stretch"
                                            BorderThickness="0" Background="Transparent" Cursor="Hand"
                                            ToolTip="{Binding Tag}">
                                        <!-- Command đổi theo chế độ: thường=ToggleOutput, force=ForceOutput -->
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Command"
                                                        Value="{Binding DataContext.ToggleOutputCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                <Setter Property="IsEnabled"
                                                        Value="{Binding DataContext.IsWriteAllowed, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.ForceMode, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                        <Setter Property="Command"
                                                                Value="{Binding DataContext.ForceOutputCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                        <Setter Property="IsEnabled" Value="True"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Button.CommandParameter>
                                            <Binding/>
                                        </Button.CommandParameter>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ContentControl Grid.Column="0" Content="{Binding}" Margin="2,0,8,0"
                                                            ContentTemplate="{StaticResource IoIndicatorTemplate}"/>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Address}"
                                                       FontFamily="Consolas" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Text.PrimaryBrush}"/>
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding DisplayName}"
                                                       Foreground="{DynamicResource Text.SecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <!-- Hint động theo chế độ/trạng thái -->
                                            <TextBlock Grid.Column="3" VerticalAlignment="Center" Margin="8,0" FontSize="12">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding [Io.HintOff], Source={x:Static loc:Loc.Strings}}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource Text.DisabledBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Value}" Value="True">
                                                                <Setter Property="Text" Value="{Binding [Io.HintOn], Source={x:Static loc:Loc.Strings}}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Indicator}" Value="Pending">
                                                                <Setter Property="Text" Value="{Binding [Io.HintPending], Source={x:Static loc:Loc.Strings}}"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource Status.WarningBrush}"/>
                                                            </DataTrigger>
                                                            <!-- Chế độ thường: kênh có hậu quả đã arm → xác nhận set/reset -->
                                                            <DataTrigger Binding="{Binding IsArmed}" Value="True">
                                                                <Setter Property="Text" Value="{Binding [Io.ConfirmSet], Source={x:Static loc:Loc.Strings}}"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource Status.AlarmBrush}"/>
                                                            </DataTrigger>
                                                            <!-- Chế độ Force (chưa arm) → gợi ý đóng băng -->
                                                            <DataTrigger Binding="{Binding DataContext.ForceMode, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                                <Setter Property="Text" Value="{Binding [Io.HintFreeze], Source={x:Static loc:Loc.Strings}}"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource Status.WarningBrush}"/>
                                                            </DataTrigger>
                                                            <!-- Chế độ Force đã arm → xác nhận đóng băng (đè HintFreeze) -->
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding DataContext.ForceMode, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True"/>
                                                                    <Condition Binding="{Binding IsArmed}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Text" Value="{Binding [Io.ConfirmFreeze], Source={x:Static loc:Loc.Strings}}"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource Status.AlarmBrush}"/>
                                                            </MultiDataTrigger>
                                                            <DataTrigger Binding="{Binding IsForced}" Value="True">
                                                                <Setter Property="Text" Value="{Binding [Io.HintForced], Source={x:Static loc:Loc.Strings}}"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource Status.AlarmBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <!-- Nút Gỡ (Force mode + đang forced) -->
                                            <Button Grid.Column="4" Padding="8,1" FontSize="11" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.UnforceOutputCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="{Binding [Io.Unforce], Source={x:Static loc:Loc.Strings}}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding DataContext.ForceMode, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True"/>
                                                                    <Condition Binding="{Binding IsForced}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
