<UserControl x:Class="AM.Modules.Settings.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:AM.UI.Localization;assembly=AM.UI.Localization"
             mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <!-- Gate: cần Administrator -->
        <TextBlock Text="{Binding [Backup.NeedAdmin], Source={x:Static loc:Loc.Strings}}"
                   Foreground="{DynamicResource Text.SecondaryBrush}" FontSize="14" Margin="4,8"
                   TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAdmin}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <StackPanel Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}" MaxWidth="860"
                    HorizontalAlignment="Left">

            <!-- Nội dung sẽ sao lưu + nút backup -->
            <Border CornerRadius="8" Padding="16" Margin="0,0,0,12"
                    Background="{DynamicResource Panel.BackgroundBrush}"
                    BorderBrush="{DynamicResource Border.DefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding [Backup.TargetsTitle], Source={x:Static loc:Loc.Strings}}"
                               FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"
                               Foreground="{DynamicResource Text.HeadingBrush}"/>
                    <TextBlock Text="{Binding TargetsText}" FontSize="12" TextWrapping="Wrap"
                               FontFamily="Consolas" Margin="0,0,0,12"
                               Foreground="{DynamicResource Text.SecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Height="44" Padding="20,0" FontSize="14" FontWeight="SemiBold" Cursor="Hand"
                                Command="{Binding BackupNowCommand}"
                                Content="{Binding [Backup.Now], Source={x:Static loc:Loc.Strings}}"/>
                        <Button Height="44" Padding="16,0" Margin="10,0,0,0" FontSize="14" Cursor="Hand"
                                Command="{Binding RefreshListCommand}"
                                Content="{Binding [Audit.Refresh], Source={x:Static loc:Loc.Strings}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Danh sách bản sao lưu + nút phục hồi từng dòng -->
            <TextBlock Text="{Binding [Backup.ListTitle], Source={x:Static loc:Loc.Strings}}"
                       FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"
                       Foreground="{DynamicResource Text.HeadingBrush}"/>
            <ItemsControl ItemsSource="{Binding Backups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="6" Padding="12,8" Margin="0,3"
                                Background="{DynamicResource Panel.BackgroundAltBrush}"
                                BorderBrush="{DynamicResource Border.DefaultBrush}" BorderThickness="1">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Height="36" Padding="14,0" Cursor="Hand"
                                        Command="{Binding DataContext.StartRestoreCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Content="{Binding [Backup.Restore], Source={x:Static loc:Loc.Strings}}"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text.PrimaryBrush}"/>
                                    <TextBlock Text="{Binding Meta}" FontSize="12"
                                               Foreground="{DynamicResource Text.SecondaryBrush}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding [Backup.Empty], Source={x:Static loc:Loc.Strings}}"
                       FontSize="13" Margin="4,6" Foreground="{DynamicResource Text.SecondaryBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Backups.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Xác nhận 2 bước (đỏ) -->
            <Border CornerRadius="6" Padding="16" Margin="0,10,0,0" BorderThickness="2"
                    BorderBrush="{DynamicResource Status.AlarmBrush}" Background="#1FC0392B"
                    Visibility="{Binding IsConfirmingRestore, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding [Backup.ConfirmWarn], Source={x:Static loc:Loc.Strings}}"
                               TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,6"
                               Foreground="{DynamicResource Status.AlarmBrush}"/>
                    <TextBlock Text="{Binding PendingRestore.Name}" FontFamily="Consolas" FontSize="13"
                               Margin="0,0,0,12" Foreground="{DynamicResource Text.PrimaryBrush}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{Binding [Override.Cancel], Source={x:Static loc:Loc.Strings}}"
                                Command="{Binding CancelRestoreCommand}" Padding="16,6" Margin="0,0,10,0"
                                Cursor="Hand"/>
                        <Button Content="{Binding [Backup.ConfirmRestore], Source={x:Static loc:Loc.Strings}}"
                                Command="{Binding ConfirmRestoreCommand}" Padding="16,6" Cursor="Hand"
                                Background="{DynamicResource Status.AlarmBrush}"
                                Foreground="{DynamicResource Status.ForegroundBrush}" BorderThickness="0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatusText}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource Text.SecondaryBrush}"/>
        </StackPanel>
    </Grid>
</UserControl>
