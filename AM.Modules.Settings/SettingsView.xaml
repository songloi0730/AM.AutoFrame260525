<UserControl x:Class="AM.Modules.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:AM.UI.Localization;assembly=AM.UI.Localization"
             xmlns:diag="clr-namespace:AM.Modules.Diagnostics;assembly=AM.Modules.Diagnostics"
             xmlns:eng="clr-namespace:AM.Modules.Engineering;assembly=AM.Modules.Engineering"
             mc:Ignorable="d"
             Background="{DynamicResource Screen.BackgroundBrush}">

    <!-- Cài đặt: container gom các màn kỹ thuật (Chẩn đoán, Kỹ thuật) làm sub-tab -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="SubTab" TargetType="RadioButton">
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.SecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" Padding="18,0"
                                BorderThickness="0,0,0,3" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Panel.BackgroundHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Status.InfoBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text.PrimaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- thanh sub-tab -->
            <RowDefinition Height="*"/>     <!-- nội dung -->
        </Grid.RowDefinitions>

        <!-- Thanh sub-tab: Chẩn đoán · Kỹ thuật -->
        <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Border.DefaultBrush}"
                Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource SubTab}" GroupName="settab" IsChecked="True"
                             Command="{Binding SelectSubTabCommand}" CommandParameter="0"
                             Content="{Binding [Nav.Diagnostics], Source={x:Static loc:Loc.Strings}}"/>
                <RadioButton Style="{StaticResource SubTab}" GroupName="settab"
                             Command="{Binding SelectSubTabCommand}" CommandParameter="1"
                             Content="{Binding [Nav.Engineering], Source={x:Static loc:Loc.Strings}}"/>
            </StackPanel>
        </Border>

        <!-- Nội dung: nhúng view tương ứng -->
        <Grid Grid.Row="1">
            <diag:DiagnosticsView DataContext="{Binding Diagnostics}"
                                  Visibility="{Binding ShowDiagnostics, Converter={StaticResource BoolToVis}}"/>
            <eng:EngineeringView DataContext="{Binding Engineering}"
                                 Visibility="{Binding ShowEngineering, Converter={StaticResource BoolToVis}}"/>
        </Grid>
    </Grid>
</UserControl>
