<UserControl x:Class="AM.Modules.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:AM.UI.Localization;assembly=AM.UI.Localization"
             xmlns:diag="clr-namespace:AM.Modules.Diagnostics;assembly=AM.Modules.Diagnostics"
             xmlns:eng="clr-namespace:AM.Modules.Engineering;assembly=AM.Modules.Engineering"
             xmlns:calib="clr-namespace:AM.Modules.Calibration;assembly=AM.Modules.Calibration"
             xmlns:local="clr-namespace:AM.Modules.Settings"
             mc:Ignorable="d"
             Background="{DynamicResource Screen.BackgroundBrush}">

    <!-- Cài đặt = GridMenu: landing lưới thẻ → chọn thẻ mở mục đó + nút quay lại -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Thẻ chức năng (icon trên + tên + mô tả); placeholder mờ -->
        <Style x:Key="MenuCard" TargetType="Button">
            <Setter Property="Height" Value="120"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Padding="16"
                                Background="{DynamicResource Panel.BackgroundAltBrush}"
                                BorderBrush="{DynamicResource Border.DefaultBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="Ico" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                           Margin="0,0,0,10"
                                           Foreground="{DynamicResource Status.InfoBrush}"
                                           Text="{TemplateBinding Tag}"/>
                                <ContentPresenter/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Panel.BackgroundHoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Status.InfoBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                <Setter TargetName="Ico" Property="Foreground" Value="{DynamicResource Text.PlaceholderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.PrimaryBrush}"/>
        </Style>
        <Style x:Key="CardDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.SecondaryBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,12">

        <!-- ═══ LANDING — lưới thẻ ═══════════════════════════════════════════════ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsLanding, Converter={StaticResource BoolToVis}}">
            <StackPanel MaxWidth="1100" HorizontalAlignment="Left">
                <TextBlock Text="{Binding [Nav.Settings], Source={x:Static loc:Loc.Strings}}"
                           FontSize="18" FontWeight="Bold" Margin="0,0,0,12"
                           Foreground="{DynamicResource Text.HeadingBrush}"/>
                <UniformGrid Columns="3">
                    <!-- Có chức năng -->
                    <Button Style="{StaticResource MenuCard}" Tag="&#xE950;"
                            Command="{Binding OpenCommand}" CommandParameter="diagnostics">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [Nav.Diagnostics], Source={x:Static loc:Loc.Strings}}"/>
                            <TextBlock Style="{StaticResource CardDesc}" Text="{Binding [Set.DiagDesc], Source={x:Static loc:Loc.Strings}}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuCard}" Tag="&#xE90F;"
                            Command="{Binding OpenCommand}" CommandParameter="engineering">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [Nav.Engineering], Source={x:Static loc:Loc.Strings}}"/>
                            <TextBlock Style="{StaticResource CardDesc}" Text="{Binding [Set.EngDesc], Source={x:Static loc:Loc.Strings}}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuCard}" Tag="&#xE946;"
                            Command="{Binding OpenCommand}" CommandParameter="about">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [Set.About], Source={x:Static loc:Loc.Strings}}"/>
                            <TextBlock Style="{StaticResource CardDesc}" Text="{Binding [Set.AboutDesc], Source={x:Static loc:Loc.Strings}}"/>
                        </StackPanel>
                    </Button>

                    <!-- Placeholder (mờ + "đang phát triển") -->
                    <Button Style="{StaticResource MenuCard}" Tag="&#xE72E;" IsEnabled="False"
                            ToolTip="{Binding [Set.Pending], Source={x:Static loc:Loc.Strings}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [Set.Hardware], Source={x:Static loc:Loc.Strings}}"/>
                            <TextBlock Style="{StaticResource CardDesc}" Text="{Binding [Set.Pending], Source={x:Static loc:Loc.Strings}}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuCard}" Tag="&#xE9D9;"
                            Command="{Binding OpenCommand}" CommandParameter="calib">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [Set.Calib], Source={x:Static loc:Loc.Strings}}"/>
                            <TextBlock Style="{StaticResource CardDesc}" Text="{Binding [Set.CalibDesc], Source={x:Static loc:Loc.Strings}}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuCard}" Tag="&#xE81C;"
                            Command="{Binding OpenCommand}" CommandParameter="audit">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [Set.Audit], Source={x:Static loc:Loc.Strings}}"/>
                            <TextBlock Style="{StaticResource CardDesc}" Text="{Binding [Set.AuditDesc], Source={x:Static loc:Loc.Strings}}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuCard}" Tag="&#xE77B;"
                            Command="{Binding OpenCommand}" CommandParameter="users">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [Set.Users], Source={x:Static loc:Loc.Strings}}"/>
                            <TextBlock Style="{StaticResource CardDesc}" Text="{Binding [Set.UsersDesc], Source={x:Static loc:Loc.Strings}}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuCard}" Tag="&#xE72E;" IsEnabled="False"
                            ToolTip="{Binding [Set.Pending], Source={x:Static loc:Loc.Strings}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [Set.Host], Source={x:Static loc:Loc.Strings}}"/>
                            <TextBlock Style="{StaticResource CardDesc}" Text="{Binding [Set.Pending], Source={x:Static loc:Loc.Strings}}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuCard}" Tag="&#xE72E;" IsEnabled="False"
                            ToolTip="{Binding [Set.Pending], Source={x:Static loc:Loc.Strings}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="{Binding [Set.Backup], Source={x:Static loc:Loc.Strings}}"/>
                            <TextBlock Style="{StaticResource CardDesc}" Text="{Binding [Set.Pending], Source={x:Static loc:Loc.Strings}}"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>

        <!-- ═══ DETAIL — mục đang mở + nút quay lại ══════════════════════════════ -->
        <DockPanel Visibility="{Binding IsDetail, Converter={StaticResource BoolToVis}}">
            <Button DockPanel.Dock="Top" HorizontalAlignment="Left" Height="36" Padding="14,0"
                    Margin="0,0,0,8" Cursor="Hand" Command="{Binding BackCommand}"
                    Content="{Binding [Set.Back], Source={x:Static loc:Loc.Strings}}"
                    Background="{DynamicResource Panel.BackgroundAltBrush}"
                    BorderBrush="{DynamicResource Border.DefaultBrush}" BorderThickness="1"
                    Foreground="{DynamicResource Text.PrimaryBrush}"/>
            <Grid>
                <!-- DataContext của mỗi view trỏ vào VM con → Visibility PHẢI resolve theo
                     DataContext của SettingsView (UserControl gốc), không theo VM con. -->
                <diag:DiagnosticsView DataContext="{Binding Diagnostics}"
                                      Visibility="{Binding DataContext.ShowDiagnostics, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource BoolToVis}}"/>
                <eng:EngineeringView DataContext="{Binding Engineering}"
                                     Visibility="{Binding DataContext.ShowEngineering, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource BoolToVis}}"/>
                <local:UserAdminView DataContext="{Binding Users}"
                                     Visibility="{Binding DataContext.ShowUsers, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource BoolToVis}}"/>
                <calib:CalibrationPanelView DataContext="{Binding Calib}"
                                            Visibility="{Binding DataContext.ShowCalib, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource BoolToVis}}"/>
                <local:AuditView DataContext="{Binding Audit}"
                                 Visibility="{Binding DataContext.ShowAudit, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource BoolToVis}}"/>
                <Border VerticalAlignment="Top" HorizontalAlignment="Left" CornerRadius="8" Padding="20"
                        Background="{DynamicResource Panel.BackgroundBrush}"
                        BorderBrush="{DynamicResource Border.DefaultBrush}" BorderThickness="1"
                        Visibility="{Binding ShowAbout, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding AboutText}" FontFamily="Consolas" FontSize="14"
                               Foreground="{DynamicResource Text.PrimaryBrush}"/>
                </Border>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
