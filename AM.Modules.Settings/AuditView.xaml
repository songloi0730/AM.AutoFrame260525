<UserControl x:Class="AM.Modules.Settings.AuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:AM.UI.Localization;assembly=AM.UI.Localization"
             mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <!-- Gate: cần Administrator -->
        <TextBlock Text="{Binding [Audit.NeedAdmin], Source={x:Static loc:Loc.Strings}}"
                   Foreground="{DynamicResource Text.SecondaryBrush}" FontSize="14" Margin="4,8"
                   TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAdmin}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <DockPanel Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
            <!-- Bộ lọc + nút -->
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBlock Text="{Binding [Audit.From], Source={x:Static loc:Loc.Strings}}"
                           VerticalAlignment="Center" Margin="0,0,6,0"
                           Foreground="{DynamicResource Text.SecondaryBrush}"/>
                <DatePicker SelectedDate="{Binding FromDate}" Width="130" Height="36" Margin="0,0,14,0"
                            VerticalContentAlignment="Center"/>
                <TextBlock Text="{Binding [Audit.To], Source={x:Static loc:Loc.Strings}}"
                           VerticalAlignment="Center" Margin="0,0,6,0"
                           Foreground="{DynamicResource Text.SecondaryBrush}"/>
                <DatePicker SelectedDate="{Binding ToDate}" Width="130" Height="36" Margin="0,0,14,0"
                            VerticalContentAlignment="Center"/>
                <TextBlock Text="{Binding [Audit.User], Source={x:Static loc:Loc.Strings}}"
                           VerticalAlignment="Center" Margin="0,0,6,0"
                           Foreground="{DynamicResource Text.SecondaryBrush}"/>
                <TextBox Text="{Binding UserFilter, UpdateSourceTrigger=PropertyChanged}" Width="140"
                         Height="36" VerticalContentAlignment="Center" Margin="0,0,14,0"/>
                <Button Content="{Binding [Audit.Refresh], Source={x:Static loc:Loc.Strings}}"
                        Command="{Binding RefreshCommand}" Height="36" Padding="16,0" Cursor="Hand"/>
                <Button Content="{Binding [Audit.Export], Source={x:Static loc:Loc.Strings}}"
                        Command="{Binding ExportCsvCommand}" Height="36" Padding="16,0" Margin="10,0,0,0"
                        Cursor="Hand"/>
            </WrapPanel>

            <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" FontSize="12" Margin="0,6,0,0"
                       Foreground="{DynamicResource Text.SecondaryBrush}"/>

            <!-- Bảng -->
            <ListView ItemsSource="{Binding Rows}"
                      Background="{DynamicResource Panel.BackgroundBrush}"
                      BorderBrush="{DynamicResource Border.DefaultBrush}" BorderThickness="1"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      VirtualizingPanel.IsVirtualizing="True">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="150" Header="{Binding [Col.Time], Source={x:Static loc:Loc.Strings}}"
                                        DisplayMemberBinding="{Binding TimeText}"/>
                        <GridViewColumn Width="110" Header="{Binding [Audit.ColUser], Source={x:Static loc:Loc.Strings}}"
                                        DisplayMemberBinding="{Binding User}"/>
                        <GridViewColumn Width="240" Header="{Binding [Audit.ColAction], Source={x:Static loc:Loc.Strings}}"
                                        DisplayMemberBinding="{Binding Action}"/>
                        <GridViewColumn Width="90" Header="{Binding [Audit.ColResult], Source={x:Static loc:Loc.Strings}}">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ResultText}" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Text.PrimaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDenied}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Status.AlarmBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="420" Header="{Binding [Audit.ColDetail], Source={x:Static loc:Loc.Strings}}"
                                        DisplayMemberBinding="{Binding Detail}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </DockPanel>
    </Grid>
</UserControl>
