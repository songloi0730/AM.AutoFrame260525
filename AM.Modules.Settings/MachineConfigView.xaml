<UserControl x:Class="AM.Modules.Settings.MachineConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:AM.UI.Localization;assembly=AM.UI.Localization"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- Ô nhập có label luôn hiện (RefUX-A) -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.SecondaryBrush}"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="IsEnabled" Value="{Binding CanEdit}"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.HeadingBrush}"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Background" Value="{DynamicResource Panel.BackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.DefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="{Binding [Set.Machine], Source={x:Static loc:Loc.Strings}}"
                       FontSize="18" FontWeight="Bold" Margin="0,0,0,12"
                       Foreground="{DynamicResource Text.HeadingBrush}"/>

            <!-- Dưới quyền: giải thích thay vì form chết câm -->
            <Border Background="{DynamicResource Panel.BackgroundAltBrush}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CanEdit}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding [Machine.NeedAdmin], Source={x:Static loc:Loc.Strings}}"
                           TextWrapping="Wrap" Foreground="{DynamicResource Status.WarningBrush}"/>
            </Border>

            <!-- Banner cần khởi động lại (sau khi lưu) -->
            <Border CornerRadius="6" Padding="12,8" Margin="0,0,0,12"
                    Background="{DynamicResource Warn.BackgroundBrush}"
                    Visibility="{Binding RestartRequired, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding [Machine.RestartNote], Source={x:Static loc:Loc.Strings}}"
                           TextWrapping="Wrap" FontWeight="SemiBold"
                           Foreground="{StaticResource Warn.TextBrush}"/>
            </Border>

            <!-- ═ Nhận diện máy ═ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}"
                               Text="{Binding [Machine.Ident], Source={x:Static loc:Loc.Strings}}"/>
                    <UniformGrid Columns="4">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource FieldLabel}"
                                       Text="{Binding [Machine.Name], Source={x:Static loc:Loc.Strings}}"/>
                            <TextBox Style="{StaticResource FieldBox}"
                                     Text="{Binding MachineName, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource FieldLabel}"
                                       Text="{Binding [Machine.Line], Source={x:Static loc:Loc.Strings}}"/>
                            <TextBox Style="{StaticResource FieldBox}"
                                     Text="{Binding Line, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource FieldLabel}"
                                       Text="{Binding [Machine.Location], Source={x:Static loc:Loc.Strings}}"/>
                            <TextBox Style="{StaticResource FieldBox}"
                                     Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}"
                                       Text="{Binding [Machine.Id], Source={x:Static loc:Loc.Strings}}"/>
                            <!-- MachineId gắn day-code break-glass — chỉ hiển thị, đổi trong appsettings -->
                            <TextBox Style="{StaticResource FieldBox}" IsEnabled="False"
                                     Text="{Binding MachineId, Mode=OneWay}"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- ═ Kết nối thiết bị (IP/cổng — cần khởi động lại) ═ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}"
                               Text="{Binding [Machine.Network], Source={x:Static loc:Loc.Strings}}"/>
                    <CheckBox Margin="0,0,0,12" IsEnabled="{Binding CanEdit}"
                              IsChecked="{Binding UseSimulation, Mode=TwoWay}"
                              Content="{Binding [Machine.UseSim], Source={x:Static loc:Loc.Strings}}"
                              Foreground="{DynamicResource Text.PrimaryBrush}"/>
                    <!-- 6 thiết bị × (host + port) — 3 cột -->
                    <UniformGrid Columns="3">
                        <StackPanel Margin="0,0,12,10">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Modbus TCP (host : port)"/>
                            <DockPanel>
                                <TextBox Style="{StaticResource FieldBox}" Width="70" DockPanel.Dock="Right" Margin="6,0,0,0"
                                         Text="{Binding ModbusPort, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Style="{StaticResource FieldBox}"
                                         Text="{Binding ModbusHost, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,10">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="PLC (host : port)"/>
                            <DockPanel>
                                <TextBox Style="{StaticResource FieldBox}" Width="70" DockPanel.Dock="Right" Margin="6,0,0,0"
                                         Text="{Binding PlcPort, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Style="{StaticResource FieldBox}"
                                         Text="{Binding PlcHost, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Robot (host : port)"/>
                            <DockPanel>
                                <TextBox Style="{StaticResource FieldBox}" Width="70" DockPanel.Dock="Right" Margin="6,0,0,0"
                                         Text="{Binding RobotPort, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Style="{StaticResource FieldBox}"
                                         Text="{Binding RobotHost, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Scanner (host : port)"/>
                            <DockPanel>
                                <TextBox Style="{StaticResource FieldBox}" Width="70" DockPanel.Dock="Right" Margin="6,0,0,0"
                                         Text="{Binding ScannerPort, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Style="{StaticResource FieldBox}"
                                         Text="{Binding ScannerHost, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="IO ADAM (host : port)"/>
                            <DockPanel>
                                <TextBox Style="{StaticResource FieldBox}" Width="70" DockPanel.Dock="Right" Margin="6,0,0,0"
                                         Text="{Binding AdamPort, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Style="{StaticResource FieldBox}"
                                         Text="{Binding AdamHost, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="OPC-UA endpoint"/>
                            <TextBox Style="{StaticResource FieldBox}"
                                     Text="{Binding OpcUaEndpoint, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </UniformGrid>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <StackPanel.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Text.SecondaryBrush}"/>
                            </Style>
                        </StackPanel.Resources>
                        <TextBlock Text="EtherNet/IP host:" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Style="{StaticResource FieldBox}" Width="160"
                                 Text="{Binding EthernetIpHost, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <DockPanel Margin="0,14,0,0">
                        <Button DockPanel.Dock="Left" Height="34" Padding="18,0" Cursor="Hand"
                                Command="{Binding SaveCommand}" IsEnabled="{Binding CanEdit}"
                                Content="{Binding [Machine.Save], Source={x:Static loc:Loc.Strings}}"
                                Background="{DynamicResource Button.PrimaryBrush}"
                                Foreground="{DynamicResource Status.ForegroundBrush}" BorderThickness="0"/>
                        <TextBlock Text="{Binding StatusText}" Margin="12,0,0,0" VerticalAlignment="Center"
                                   TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource Text.PrimaryBrush}"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- ═ Toàn vẹn file cấu hình (manifest SHA-256) ═ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Height="30" Padding="12,0" Cursor="Hand"
                                Command="{Binding ResignCommand}" IsEnabled="{Binding CanEdit}"
                                Content="{Binding [Machine.Resign], Source={x:Static loc:Loc.Strings}}"/>
                        <TextBlock Style="{StaticResource SectionTitle}" Margin="0"
                                   VerticalAlignment="Center"
                                   Text="{Binding [Machine.Integrity], Source={x:Static loc:Loc.Strings}}"/>
                    </DockPanel>
                    <TextBlock Text="{Binding [Machine.IntegrityHint], Source={x:Static loc:Loc.Strings}}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                               Foreground="{DynamicResource Text.SecondaryBrush}"/>
                    <ItemsControl ItemsSource="{Binding IntegrityRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding StateText, Mode=OneWay}"
                                               FontSize="12" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Status.NormalBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBad}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Status.AlarmBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsUnsigned}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Warn.TextBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding FileName, Mode=OneWay}" FontFamily="Consolas" FontSize="12"
                                               Foreground="{DynamicResource Text.PrimaryBrush}"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
