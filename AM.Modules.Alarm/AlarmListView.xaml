<UserControl x:Class="AM.Modules.Alarm.AlarmListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:AM.Modules.Alarm.Converters"
             mc:Ignorable="d"
             Background="{DynamicResource Screen.BackgroundBrush}">

    <UserControl.Resources>
        <conv:AlarmLevelToColorConverter x:Key="LevelToColor"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header + toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="⚠ Alarm đang active"
                           FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource Text.HeadingBrush}"/>
                <Border CornerRadius="10" Padding="8,2" Margin="12,0,0,0"
                        Background="{DynamicResource Status.AlarmBrush}">
                    <TextBlock Text="{Binding ActiveCount, Mode=OneWay}"
                               Foreground="{DynamicResource Text.PrimaryBrush}" FontWeight="Bold"/>
                </Border>
            </StackPanel>
            <Button Grid.Column="1" Content="🗑 Clear All"
                    Command="{Binding ClearAllCommand}"
                    Height="36" Padding="14,0" FontWeight="SemiBold"
                    Background="{DynamicResource Status.InterlockBrush}"
                    Foreground="{DynamicResource Text.PrimaryBrush}" BorderThickness="0"/>
        </Grid>

        <!-- Alarm DataGrid -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding ActiveAlarms}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  Background="{DynamicResource Panel.BackgroundBrush}"
                  Foreground="{DynamicResource Text.PrimaryBrush}"
                  BorderBrush="{DynamicResource Border.DefaultBrush}"
                  RowBackground="{DynamicResource Panel.BackgroundBrush}"
                  AlternatingRowBackground="{DynamicResource Panel.BackgroundAltBrush}"
                  HorizontalScrollBarVisibility="Disabled">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource Header.BackgroundBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Text.SecondaryBrush}"/>
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Border.DefaultBrush}"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <!-- Level indicator -->
                <DataGridTemplateColumn Header="Mức" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Ellipse Width="14" Height="14" HorizontalAlignment="Center"
                                     Fill="{Binding Level, Converter={StaticResource LevelToColor}}"
                                     ToolTip="{Binding Level}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Code" Binding="{Binding AlarmCode}" Width="80"/>
                <DataGridTextColumn Header="Station" Binding="{Binding Station}" Width="130"/>
                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                <DataGridTextColumn Header="Thời gian" Binding="{Binding RaisedAt, StringFormat=HH:mm:ss}" Width="90"/>
                <DataGridCheckBoxColumn Header="Ack" Binding="{Binding IsAcknowledged}" Width="50"/>

                <!-- Action buttons -->
                <DataGridTemplateColumn Header="" Width="170">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="4,2">
                                <Button Content="Ack" Width="64" Margin="0,0,4,0"
                                        Command="{Binding DataContext.AcknowledgeCommand,
                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Background="{DynamicResource Status.ManualBrush}"
                                        Foreground="{DynamicResource Text.PrimaryBrush}" BorderThickness="0"/>
                                <Button Content="Clear" Width="64"
                                        Command="{Binding DataContext.ClearCommand,
                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Background="{DynamicResource Status.NormalBrush}"
                                        Foreground="{DynamicResource Text.PrimaryBrush}" BorderThickness="0"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
