<UserControl x:Class="AM.Modules.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:AM.Modules.Dashboard.Converters"
             xmlns:dash="clr-namespace:AM.Modules.Dashboard"
             xmlns:loc="clr-namespace:AM.UI.Localization;assembly=AM.UI.Localization"
             mc:Ignorable="d"
             Background="{DynamicResource Screen.BackgroundBrush}">

    <!--
    Home v2.1 — template v2 §3.4/§3.5 + tinh chỉnh nội dung (ADR 0010, Session 74):
    WORK AREA (trái, co giãn): card "Kết quả gần nhất" (thumb camera + KQ lớn + SN/cycle/recipe)
    → bảng truy vết SN (empty state có hướng dẫn, KQ chip màu).
    RIGHT RAIL (560px): KPI ca (số 26px, màu chỉ khi >0) → Thao tác nhanh (2 hàng tiện ích/rủi ro,
    lý do khoá ở tooltip, Gọi KT = Andon viền hổ phách) → Trạm & an toàn → Nhật ký.
    Lệnh máy ở ACTION BAR của Shell — Home KHÔNG lặp nút (một lệnh một chỗ).
    -->

    <UserControl.Resources>
        <conv:MachineStateToColorConverter x:Key="StateToColor"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Card vùng lớn -->
        <Style x:Key="ZoneCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource Panel.BackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.DefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <!-- Tiêu đề section trên rail -->
        <Style x:Key="RailTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.SecondaryBrush}"/>
        </Style>
        <!-- Ô KPI (kc): trắng viền nhẹ, caption 12 + giá trị 16-18 đậm -->
        <Style x:Key="KpiCell" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Card.BackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Card.BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>
        <Style x:Key="KpiCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.SecondaryBrush}"/>
        </Style>
        <!-- Số KPI to hơn nhãn rõ rệt (ISA-101: data 16-20pt+) — nhãn 12 mờ trên, số 26 đậm dưới -->
        <Style x:Key="KpiNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.PrimaryBrush}"/>
        </Style>
        <!-- Nút thao tác nhanh: 64px, icon trên + nhãn dưới; mờ khi khoá.
             Lý do khoá KHÔNG lặp thành dòng chữ trên nút — chuyển hết vào tooltip
             (+ icon khoá nhỏ khi thiếu quyền); Andon (Gọi kỹ thuật) viền hổ phách. -->
        <Style x:Key="QuickButton" TargetType="Button">
            <Setter Property="Height" Value="64"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Background" Value="{DynamicResource Card.BackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.DefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.PrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="ToolTip" Value="{Binding SubText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource Panel.BackgroundHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsAndon}" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{StaticResource Status.WarningBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource Warn.TextBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsOn}" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{StaticResource Status.InfoBrush}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{StaticResource Info.BackgroundBrush}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- SubText rỗng → không hiện tooltip rỗng -->
                <DataTrigger Binding="{Binding SubText}" Value="">
                    <Setter Property="ToolTip" Value="{x:Null}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12,12,12,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="560"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ WORK AREA — sub-tab "Sản phẩm" ═══════════════════════════════════ -->
        <Border Grid.Column="0" Style="{StaticResource ZoneCard}">
            <DockPanel>
                <!-- Sub-tab bar (HomeSubViews config — demo có 1 tab "Sản phẩm").
                     Bộ đếm gộp lên góc phải header thay vì chiếm một dòng footer riêng. -->
                <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource Border.DefaultBrush}">
                    <DockPanel Margin="12,0">
                        <TextBlock DockPanel.Dock="Right" FontSize="13" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Text.PlaceholderBrush}">
                            <Run Text="{Binding Total, Mode=OneWay}"/>
                            <Run Text="{Binding [Dash.RecordsFooter], Source={x:Static loc:Loc.Strings}, Mode=OneWay}"/>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal">
                            <Border BorderThickness="0,0,0,3" BorderBrush="{StaticResource Status.InfoBrush}"
                                    Padding="20,11">
                                <TextBlock Text="{Binding [Dash.ProductTab], Source={x:Static loc:Loc.Strings}}"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.PrimaryBrush}"/>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid Margin="12,12,12,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Card "Kết quả gần nhất" — thứ operator liếc đầu tiên: ảnh cycle (TODO vision
                         service) + KQ OK/NG chữ lớn + SN/Cycle/Recipe. Live view liên tục ở tab Vision. -->
                    <Border Grid.Row="0" Margin="0,0,0,12" CornerRadius="8" Padding="12,10"
                            Background="{DynamicResource Card.BackgroundBrush}"
                            BorderBrush="{DynamicResource Card.BorderBrush}" BorderThickness="1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" FontSize="12" VerticalAlignment="Top"
                                       Foreground="{DynamicResource Text.PlaceholderBrush}"
                                       Text="{Binding [Vision.LastResult], Source={x:Static loc:Loc.Strings}}"/>
                            <StackPanel Orientation="Horizontal">
                                <!-- Thumb camera gọn (ảnh kết quả per cycle = TODO vision service).
                                     Trạng thái camera = chấm màu + tên xám — không chữ xanh khi bình thường. -->
                                <ItemsControl ItemsSource="{Binding Cameras}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="96" Height="62" CornerRadius="6" Margin="0,0,12,0"
                                                    Background="{StaticResource Vision.PreviewBrush}"
                                                    ToolTip="{Binding [Dash.VisionHint], Source={x:Static loc:Loc.Strings}}">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="11" HorizontalAlignment="Center"
                                                               Foreground="{StaticResource Vision.PreviewTextBrush}"/>
                                                    <Ellipse Width="8" Height="8" Margin="0,5,0,0" HorizontalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{StaticResource Status.AlarmBrush}"/>
                                                                <Setter Property="ToolTip" Value="{Binding [Dash.CamOff], Source={x:Static loc:Loc.Strings}}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Connected}" Value="True">
                                                                        <Setter Property="Fill" Value="{StaticResource Status.NormalBrush}"/>
                                                                        <Setter Property="ToolTip" Value="{Binding [Dash.CamReady], Source={x:Static loc:Loc.Strings}}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Chip KQ lớn: xám "—" khi chưa có cycle, xanh OK / đỏ NG khi có -->
                                <Border CornerRadius="8" Padding="20,10" VerticalAlignment="Center" Margin="2,0,16,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource Notice.OkBrush}"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding HasLatest}" Value="True"/>
                                                        <Condition Binding="{Binding LatestIsPassed}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Background" Value="{StaticResource Ok.BackgroundBrush}"/>
                                                </MultiDataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding HasLatest}" Value="True"/>
                                                        <Condition Binding="{Binding LatestIsPassed}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Background" Value="{StaticResource Ng.BackgroundBrush}"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding LatestResultText}" FontSize="22" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Text.SecondaryBrush}"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding HasLatest}" Value="True"/>
                                                            <Condition Binding="{Binding LatestIsPassed}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Foreground" Value="{StaticResource Status.NormalBrush}"/>
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding HasLatest}" Value="True"/>
                                                            <Condition Binding="{Binding LatestIsPassed}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Foreground" Value="{StaticResource Status.AlarmBrush}"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <!-- SN · Cycle · Recipe của cycle gần nhất -->
                                <Grid VerticalAlignment="Center"
                                      Visibility="{Binding HasLatest, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="SN" FontSize="12" Margin="0,0,16,1"
                                               Foreground="{DynamicResource Text.PlaceholderBrush}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LatestSn}" FontSize="13"
                                               Foreground="{DynamicResource Text.PrimaryBrush}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Cycle" FontSize="12" Margin="0,0,16,1"
                                               Foreground="{DynamicResource Text.PlaceholderBrush}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LatestCycleText}" FontSize="13"
                                               Foreground="{DynamicResource Text.PrimaryBrush}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" FontSize="12" Margin="0,0,16,0"
                                               Text="{Binding [Param.Recipe], Source={x:Static loc:Loc.Strings}}"
                                               Foreground="{DynamicResource Text.PlaceholderBrush}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LatestRecipeName}" FontSize="13"
                                               Foreground="{DynamicResource Text.PrimaryBrush}"/>
                                </Grid>

                                <!-- Chưa có cycle → nói rõ thay vì để trống -->
                                <TextBlock VerticalAlignment="Center" FontSize="13"
                                           Foreground="{DynamicResource Text.PlaceholderBrush}"
                                           Text="{Binding [Dash.NoCycle], Source={x:Static loc:Loc.Strings}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasLatest}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Bảng truy vết sản phẩm (dòng ≥40px; CHỈ dòng NG có màu) -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding RecentRecords}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              RowHeight="40" FontSize="14"
                              Background="Transparent" BorderThickness="0"
                              Foreground="{DynamicResource Text.SecondaryBrush}"
                              HorizontalGridLinesBrush="{DynamicResource Card.BorderBrush}"
                              HorizontalScrollBarVisibility="Disabled">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text.PlaceholderBrush}"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="FontWeight" Value="Normal"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPassed}" Value="False">
                                        <Setter Property="Background" Value="{StaticResource Ng.BackgroundBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SN" Binding="{Binding SerialNumber}" Width="170">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="{StaticResource Text.LinkBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPassed}" Value="False">
                                                <Setter Property="Foreground" Value="{StaticResource Text.ErrorBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{Binding [Col.In], Source={x:Static loc:Loc.Strings}}"
                                                Binding="{Binding TimeText}" Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
            <!-- Cột số căn phải để đọc dọc nhanh -->
                            <DataGridTextColumn Header="Cycle" Binding="{Binding CycleText}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Margin" Value="0,0,8,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{Binding [Col.Data], Source={x:Static loc:Loc.Strings}}"
                                                Binding="{Binding DataText}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{Binding [Param.Recipe], Source={x:Static loc:Loc.Strings}}"
                                                Binding="{Binding RecipeName}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
            <!-- KQ = chip màu (cột được quét mắt nhiều nhất) -->
                            <DataGridTemplateColumn Header="{Binding [Col.Result], Source={x:Static loc:Loc.Strings}}"
                                                    Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="12,3" HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource Ok.BackgroundBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPassed}" Value="False">
                                                            <Setter Property="Background" Value="{StaticResource Ng.BackgroundBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding ResultText}" FontWeight="Bold" FontSize="13">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource Status.NormalBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPassed}" Value="False">
                                                                <Setter Property="Foreground" Value="{StaticResource Status.AlarmBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty state — vùng trống phải nói cho operator biết bước tiếp theo -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RecentRecords.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Text.PlaceholderBrush}"/>
                        <TextBlock Text="{Binding [Dash.EmptyTitle], Source={x:Static loc:Loc.Strings}}"
                                   FontSize="15" Margin="0,8,0,2" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Text.SecondaryBrush}"/>
                        <TextBlock Text="{Binding [Dash.EmptyHint], Source={x:Static loc:Loc.Strings}}"
                                   FontSize="13" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Text.PlaceholderBrush}"/>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ═══ RIGHT RAIL 560px — KPI ca → Thao tác nhanh → Trạm & an toàn → Nhật ký ═ -->
        <Border Grid.Column="2" Style="{StaticResource ZoneCard}">
            <DockPanel Margin="16,14">
                <!-- 1. Sản xuất — ca hiện tại (3×2) -->
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Style="{StaticResource RailTitle}"
                               Text="{Binding [Dash.Production], Source={x:Static loc:Loc.Strings}}"/>
                    <UniformGrid Columns="3">
                        <Border Style="{StaticResource KpiCell}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource KpiCaption}"
                                           Text="{Binding [Prod.Total], Source={x:Static loc:Loc.Strings}}"/>
                                <TextBlock Style="{StaticResource KpiNumber}" Text="{Binding Total}"/>
                            </StackPanel>
                        </Border>
                        <!-- ISA-101: màu CHỈ khi có ý nghĩa — Đạt/Lỗi = 0 hiển thị xám trung tính -->
                        <Border Style="{StaticResource KpiCell}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource KpiCaption}"
                                           Text="{Binding [Prod.OK], Source={x:Static loc:Loc.Strings}}"/>
                                <TextBlock Text="{Binding Passed}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource KpiNumber}">
                                            <Setter Property="Foreground" Value="{StaticResource Status.NormalBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Passed}" Value="0">
                                                    <Setter Property="Foreground" Value="{DynamicResource Text.PrimaryBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCell}" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Style="{StaticResource KpiCaption}"
                                           Text="{Binding [Prod.NG], Source={x:Static loc:Loc.Strings}}"/>
                                <TextBlock Text="{Binding Failed}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource KpiNumber}">
                                            <Setter Property="Foreground" Value="{StaticResource Status.AlarmBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Failed}" Value="0">
                                                    <Setter Property="Foreground" Value="{DynamicResource Text.PrimaryBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCell}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource KpiCaption}"
                                           Text="{Binding [Prod.Yield], Source={x:Static loc:Loc.Strings}}"/>
                                <!-- "—" khi chưa có dữ liệu (0.0 % gây hiểu nhầm).
                                     Màu-khi-có-nghĩa (P4.4): dưới ngưỡng Warn = vàng, dưới Alarm = đỏ (config). -->
                                <TextBlock Text="{Binding YieldText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource KpiNumber}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding YieldLevel}" Value="1">
                                                    <Setter Property="Foreground" Value="{StaticResource Warn.TextBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding YieldLevel}" Value="2">
                                                    <Setter Property="Foreground" Value="{StaticResource Status.AlarmBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCell}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource KpiCaption}"
                                           Text="{Binding [Prod.UPH], Source={x:Static loc:Loc.Strings}}"/>
                                <TextBlock Style="{StaticResource KpiNumber}"
                                           Text="{Binding UnitsPerHour, StringFormat={}{0:F0}}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCell}" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Style="{StaticResource KpiCaption}"
                                           Text="{Binding [Prod.Cycle], Source={x:Static loc:Loc.Strings}}"/>
                                <!-- Tự đổi đơn vị ms→s (cycle máy lắp ráp thực tế toàn giây) -->
                                <TextBlock Style="{StaticResource KpiNumber}" Text="{Binding AvgCycleText}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>

                <!-- 2. Thao tác nhanh (≥64px, icon trên + nhãn dưới; mờ + lý do khi chưa có HAL) -->
                <StackPanel DockPanel.Dock="Top" Margin="0,10,0,0">
                    <TextBlock Style="{StaticResource RailTitle}"
                               Text="{Binding [Dash.QuickActions], Source={x:Static loc:Loc.Strings}}"/>
                    <ItemsControl ItemsSource="{Binding QuickActions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Lý do khoá ở tooltip (style QuickButton) — không lặp 6 dòng chữ trên nút;
                                     thiếu quyền → icon khoá nhỏ góc trên phải -->
                                <Button Style="{StaticResource QuickButton}"
                                        IsEnabled="{Binding IsEnabled}"
                                        dash:HoldToConfirm.DurationMs="{Binding HoldMs}"
                                        Command="{Binding DataContext.QuickActionCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding Id}">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center" Margin="14,0">
                                            <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                            <TextBlock Text="{Binding Label}" FontSize="13" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                   HorizontalAlignment="Right" VerticalAlignment="Top"
                                                   Margin="0,-4,-6,0"
                                                   Foreground="{DynamicResource Text.PlaceholderBrush}"
                                                   Visibility="{Binding NeedsRole, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- 3. Trạm & an toàn (2 cột) -->
                <StackPanel DockPanel.Dock="Top" Margin="0,10,0,0">
                    <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Border.DefaultBrush}"
                            Padding="0,10,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource RailTitle}"
                                       Text="{Binding [Dash.StationSafety], Source={x:Static loc:Loc.Strings}}"/>
                            <ItemsControl ItemsSource="{Binding Stations}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,3,18,3">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding StateText}" FontSize="14"
                                                       Foreground="{DynamicResource Text.SecondaryBrush}"/>
                                            <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                                                     Fill="{Binding State, Converter={StaticResource StateToColor}}"/>
                                            <TextBlock Text="{Binding Name}" FontSize="14"
                                                       Foreground="{DynamicResource Text.PrimaryBrush}"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- An toàn: tín hiệu phần cứng (ISafetyInput event push) -->
                            <UniformGrid Columns="2"
                                         Visibility="{Binding HasSafety, Converter={StaticResource BoolToVis}}">
                                <DockPanel Margin="0,3,18,3">
                                    <TextBlock DockPanel.Dock="Right" FontSize="14">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding [Safety.Open], Source={x:Static loc:Loc.Strings}}"/>
                                                <Setter Property="Foreground" Value="{StaticResource Status.AlarmBrush}"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding GuardClosed}" Value="True">
                                                        <Setter Property="Text" Value="{Binding [Safety.Closed], Source={x:Static loc:Loc.Strings}}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource Text.SecondaryBrush}"/>
                                                        <Setter Property="FontWeight" Value="Normal"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource Status.AlarmBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding GuardClosed}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource Status.NormalBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding [Safety.Guard], Source={x:Static loc:Loc.Strings}}"
                                               FontSize="14" Foreground="{DynamicResource Text.PrimaryBrush}"/>
                                </DockPanel>
                                <DockPanel Margin="0,3,18,3">
                                    <TextBlock DockPanel.Dock="Right" FontSize="14">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding [Safety.Triggered], Source={x:Static loc:Loc.Strings}}"/>
                                                <Setter Property="Foreground" Value="{StaticResource Status.AlarmBrush}"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EStopOk}" Value="True">
                                                        <Setter Property="Text" Value="{Binding [Safety.OK], Source={x:Static loc:Loc.Strings}}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource Text.SecondaryBrush}"/>
                                                        <Setter Property="FontWeight" Value="Normal"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource Status.AlarmBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EStopOk}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource Status.NormalBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding [Safety.EStop], Source={x:Static loc:Loc.Strings}}"
                                               FontSize="14" Foreground="{DynamicResource Text.PrimaryBrush}"/>
                                </DockPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 4. Nhật ký — chiếm phần còn lại, 1 dòng/entry -->
                <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Border.DefaultBrush}"
                        Padding="0,10,0,0" Margin="0,10,0,0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Right" FontSize="12"
                                       Foreground="{DynamicResource Text.PlaceholderBrush}"
                                       Text="{Binding [Dash.LogHint], Source={x:Static loc:Loc.Strings}}"/>
                            <TextBlock Style="{StaticResource RailTitle}" Margin="0"
                                       Text="{Binding [Dash.OpLog], Source={x:Static loc:Loc.Strings}}"/>
                        </DockPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid>
                            <!-- Empty state — vùng trống nói rõ nội dung sẽ xuất hiện ở đây -->
                            <TextBlock FontSize="13" Margin="0,10,0,0" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Text.PlaceholderBrush}"
                                       Text="{Binding [Dash.LogEmpty], Source={x:Static loc:Loc.Strings}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OpLog.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding OpLog}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderThickness="0,0,0,1"
                                                BorderBrush="{DynamicResource Card.BorderBrush}" Padding="0,5">
                                            <TextBlock FontSize="13" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource Text.SecondaryBrush}"
                                                       ToolTip="{Binding Message}">
                                                <Run Text="{Binding TimeText, Mode=OneWay}"
                                                     Foreground="{StaticResource Text.PlaceholderBrush}"/>
                                                <Run Text="{Binding Level, Mode=OneWay}" FontWeight="Bold">
                                                    <Run.Style>
                                                        <Style TargetType="Run">
                                                            <Setter Property="Foreground" Value="{StaticResource Status.InfoBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Level}" Value="WARN">
                                                                    <Setter Property="Foreground" Value="{StaticResource Status.WarningBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Level}" Value="ERR">
                                                                    <Setter Property="Foreground" Value="{StaticResource Status.AlarmBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Run.Style>
                                                </Run>
                                                <Run Text="{Binding Station, Mode=OneWay}"/>
                                                <Run Text="{Binding Message, Mode=OneWay}"/>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </Grid>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
