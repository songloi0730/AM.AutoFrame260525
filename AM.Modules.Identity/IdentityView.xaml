<UserControl x:Class="AM.Modules.Identity.IdentityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:AM.Modules.Identity.Converters"
             xmlns:loc="clr-namespace:AM.UI.Localization;assembly=AM.UI.Localization"
             mc:Ignorable="d"
             Background="{DynamicResource Screen.BackgroundBrush}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding [Nav.Identity], Source={x:Static loc:Loc.Strings}}" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"
                   Foreground="{DynamicResource Text.HeadingBrush}"/>

        <Border Grid.Row="1" Width="360" VerticalAlignment="Top" HorizontalAlignment="Left"
                CornerRadius="6" Padding="20" Background="{DynamicResource Panel.BackgroundBrush}">
          <Grid>

            <!-- ── Form đăng nhập (khi CHƯA đăng nhập) ───────────────────────── -->
            <StackPanel Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis},
                                     ConverterParameter=Invert}"
                        x:Name="LoginPanel">
                <TextBlock Text="{Binding [Id.Login], Source={x:Static loc:Loc.Strings}}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,16"
                           Foreground="{DynamicResource Text.PrimaryBrush}"/>

                <TextBlock Text="{Binding [Id.Username], Source={x:Static loc:Loc.Strings}}" Margin="0,0,0,4"
                           Foreground="{DynamicResource Text.SecondaryBrush}"/>
                <TextBox Height="32" Margin="0,0,0,12" VerticalContentAlignment="Center" Padding="6,0"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="{Binding [Id.Password], Source={x:Static loc:Loc.Strings}}" Margin="0,0,0,4"
                           Foreground="{DynamicResource Text.SecondaryBrush}"/>
                <PasswordBox x:Name="PasswordField" Height="32" Margin="0,0,0,16"
                             VerticalContentAlignment="Center" Padding="6,0"
                             KeyDown="OnPasswordKeyDown"/>

                <Button Content="{Binding [Id.Login], Source={x:Static loc:Loc.Strings}}" Height="36" Click="OnLoginClick"
                        Background="{DynamicResource Button.PrimaryBrush}"
                        Foreground="{DynamicResource Status.ForegroundBrush}" BorderThickness="0"/>

                <TextBlock Text="{Binding StatusMessage}" Margin="0,12,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource Status.AlarmBrush}"/>

                <TextBlock Margin="0,16,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource Text.SecondaryBrush}"
                           Text="{Binding [Id.Hint], Source={x:Static loc:Loc.Strings}}"/>
            </StackPanel>

            <!-- ── Thông tin phiên (khi ĐÃ đăng nhập) ───────────────────────── -->
            <StackPanel Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding [Id.LoggedIn], Source={x:Static loc:Loc.Strings}}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,16"
                           Foreground="{DynamicResource Text.PrimaryBrush}"/>

                <TextBlock Text="{Binding [Id.User], Source={x:Static loc:Loc.Strings}}" Foreground="{DynamicResource Text.SecondaryBrush}"/>
                <TextBlock Text="{Binding CurrentUser}" FontSize="16" Margin="0,2,0,12"
                           Foreground="{DynamicResource Text.PrimaryBrush}"/>

                <TextBlock Text="{Binding [Id.Level], Source={x:Static loc:Loc.Strings}}" Foreground="{DynamicResource Text.SecondaryBrush}"/>
                <TextBlock Text="{Binding CurrentLevel}" FontSize="16" Margin="0,2,0,20"
                           Foreground="{DynamicResource Text.PrimaryBrush}"/>

                <Button Content="{Binding [Id.Logout], Source={x:Static loc:Loc.Strings}}" Height="36" Command="{Binding LogoutCommand}"
                        Background="{DynamicResource Panel.BackgroundAltBrush}"
                        Foreground="{DynamicResource Text.PrimaryBrush}" BorderThickness="0"/>
            </StackPanel>
          </Grid>
        </Border>
    </Grid>
</UserControl>
