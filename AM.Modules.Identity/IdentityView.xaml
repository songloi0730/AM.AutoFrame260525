<!--
    IdentityView.xaml — AM.Modules.Identity
    ISA-101 Level-4 Screen: User Identity & Permission Management
    ════════════════════════════════════════════════════════════════════════
    Layout:
      [Header] Current user chip + Logout button
      [Tabs  ]
        Login tab:      Username/Password form + Login/Change password
        Users tab:      User list DataGrid + Add/Edit/Delete (Admin+)
        Permissions:    Level permission matrix table (read-only overview)
    ════════════════════════════════════════════════════════════════════════
-->
<UserControl x:Class="AM.Modules.Identity.IdentityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{DynamicResource Screen.BackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Header -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>      <!-- Tabs -->
        </Grid.RowDefinitions>

        <!-- ═══ Header: Current User Info ══════════════════════════════════════ -->
        <Border Grid.Row="0" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Avatar + user info -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="48" Height="48" CornerRadius="24"
                            Background="{DynamicResource Button.PrimaryBrush}"
                            Margin="0,0,12,0">
                        <TextBlock Text="👤" FontSize="22"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentUserName}"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource Text.HeadingBrush}"/>
                        <TextBlock Text="{Binding CurrentLevelLabel}"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.SecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Login duration -->
                <TextBlock Grid.Column="1"
                           Text="{Binding LoginDuration}"
                           Foreground="{DynamicResource Text.SecondaryBrush}"
                           FontSize="12" VerticalAlignment="Center" Margin="16,0"/>

                <!-- Logout -->
                <Button Grid.Column="2"
                        Content="🚪 Đăng xuất"
                        Command="{Binding LogoutCommand}"
                        Style="{StaticResource ButtonBase}"
                        Width="110"
                        Background="{DynamicResource Button.NeutralBrush}"
                        Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>

        <!-- ═══ Tabs ═════════════════════════════════════════════════════════ -->
        <TabControl Grid.Row="2"
                    Background="{DynamicResource Panel.BackgroundBrush}"
                    BorderBrush="{DynamicResource Border.DefaultBrush}">

            <!-- ─── Tab 1: Login ────────────────────────────────────────── -->
            <TabItem Header="🔐 Đăng nhập">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Style="{StaticResource Card}" Width="360" Padding="24">
                        <StackPanel>
                            <TextBlock Text="Đăng nhập hệ thống"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource Text.HeadingBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,20"/>

                            <!-- Username -->
                            <TextBlock Text="Tên đăng nhập:"
                                       Foreground="{DynamicResource Text.SecondaryBrush}"
                                       FontSize="12" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding LoginUsername, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputBox}"
                                     Margin="0,0,0,12"/>

                            <!-- Password -->
                            <TextBlock Text="Mật khẩu:"
                                       Foreground="{DynamicResource Text.SecondaryBrush}"
                                       FontSize="12" Margin="0,0,0,4"/>
                            <PasswordBox x:Name="PasswordBox"
                                         Height="36" Padding="8,0"
                                         Background="{DynamicResource Input.BackgroundBrush}"
                                         Foreground="{DynamicResource Text.PrimaryBrush}"
                                         BorderBrush="{DynamicResource Input.BorderBrush}"
                                         BorderThickness="1"
                                         Margin="0,0,0,16"/>

                            <!-- Error message -->
                            <TextBlock Text="{Binding LoginError}"
                                       Foreground="{DynamicResource Status.AlarmBrush}"
                                       FontSize="12" HorizontalAlignment="Center"
                                       Margin="0,0,0,8"
                                       Visibility="{Binding HasLoginError, Converter={StaticResource BoolToVis}}"/>

                            <!-- Login button -->
                            <Button Content="🔐 Đăng nhập"
                                    Command="{Binding LoginCommand}"
                                    Style="{StaticResource ControlButton}"
                                    Background="{DynamicResource Button.PrimaryBrush}"
                                    HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ─── Tab 2: User Management (Admin+) ─────────────────────── -->
            <TabItem Header="👥 Quản lý người dùng">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Admin required banner -->
                    <Border Grid.Row="0" Padding="8,6" CornerRadius="4" Margin="0,0,0,8"
                            Background="{DynamicResource Status.WarningBrush}"
                            Visibility="{Binding IsNotAdmin, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="⚠ Yêu cầu quyền Administrator để quản lý người dùng"
                                   Foreground="#212121" FontWeight="SemiBold" FontSize="12"/>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Toolbar -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="➕ Thêm user"
                                    Command="{Binding AddUserCommand}"
                                    Style="{StaticResource ButtonBase}"
                                    Width="110" Height="36" Margin="0,0,6,0"
                                    IsEnabled="{Binding IsAdmin}"
                                    Background="{DynamicResource Status.NormalBrush}"/>
                            <Button Content="✏ Sửa"
                                    Command="{Binding EditUserCommand}"
                                    Style="{StaticResource ButtonBase}"
                                    Width="80" Height="36" Margin="0,0,6,0"
                                    IsEnabled="{Binding IsAdmin}"
                                    Background="{DynamicResource Button.PrimaryBrush}"/>
                            <Button Content="🗑 Xoá"
                                    Command="{Binding DeleteUserCommand}"
                                    Style="{StaticResource ButtonBase}"
                                    Width="80" Height="36"
                                    IsEnabled="{Binding IsAdmin}"
                                    Background="{DynamicResource Button.DangerBrush}"/>
                        </StackPanel>

                        <!-- User list -->
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Users}"
                                  SelectedItem="{Binding SelectedUser}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" GridLinesVisibility="Horizontal"
                                  Background="{DynamicResource Panel.BackgroundBrush}"
                                  Foreground="{DynamicResource Text.PrimaryBrush}"
                                  BorderBrush="{DynamicResource Border.DefaultBrush}"
                                  RowBackground="{DynamicResource Grid.RowBrush}"
                                  AlternatingRowBackground="{DynamicResource Grid.AltRowBrush}"
                                  ColumnHeaderStyle="{StaticResource GridHeaderStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Username" Binding="{Binding Username}"
                                                    Width="150"/>
                                <DataGridTextColumn Header="Cấp quyền" Binding="{Binding LevelName}"
                                                    Width="130"/>
                                <DataGridTextColumn Header="Lần đăng nhập cuối"
                                                    Binding="{Binding LastLogin, StringFormat='yyyy-MM-dd HH:mm'}"
                                                    Width="160"/>
                                <DataGridCheckBoxColumn Header="Kích hoạt" Binding="{Binding IsActive}"
                                                        Width="80" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Ghi chú" Binding="{Binding Notes}"
                                                    Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ─── Tab 3: Permission Matrix (read-only reference) ────── -->
            <TabItem Header="🔒 Ma trận phân quyền">
                <ScrollViewer Margin="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Bảng phân quyền theo cấp độ"
                                   Style="{StaticResource SectionHeader}" Margin="0,0,0,12"/>

                        <!-- Permission matrix table (hardcoded reference) -->
                        <DataGrid Grid.Row="1"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" GridLinesVisibility="All"
                                  ItemsSource="{Binding PermissionMatrix}"
                                  Background="{DynamicResource Panel.BackgroundBrush}"
                                  Foreground="{DynamicResource Text.PrimaryBrush}"
                                  BorderBrush="{DynamicResource Border.DefaultBrush}"
                                  RowBackground="{DynamicResource Grid.RowBrush}"
                                  AlternatingRowBackground="{DynamicResource Grid.AltRowBrush}"
                                  ColumnHeaderStyle="{StaticResource GridHeaderStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Chức năng" Binding="{Binding Feature}"
                                                    Width="220" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Operator (0)" Binding="{Binding Operator}"
                                                    Width="110" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Engineer (1)" Binding="{Binding Engineer}"
                                                    Width="110" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Admin (2)" Binding="{Binding Administrator}"
                                                    Width="100" IsReadOnly="True"/>
                                <DataGridTextColumn Header="SuperUser (3)" Binding="{Binding SuperUser}"
                                                    Width="110" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
