<!--
    LogView.xaml — AM.Modules.Logging
    ISA-101 Level-4 Screen: System Log Viewer
    Layout: Filter bar (Level/Source/Keyword/DateRange) + DataGrid + Export
-->
<UserControl x:Class="AM.Modules.Logging.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{DynamicResource Screen.BackgroundBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Filter bar -->
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>      <!-- Log grid -->
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>   <!-- Footer: count + export -->
        </Grid.RowDefinitions>

        <!-- ═══ Filter bar ═════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12,8">
            <WrapPanel>
                <!-- Level filter -->
                <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                    <TextBlock Text="Level:" Foreground="{DynamicResource Text.SecondaryBrush}"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding LevelFilters}"
                              SelectedItem="{Binding SelectedLevel}"
                              Style="{StaticResource InputCombo}" Width="110"/>
                </StackPanel>

                <!-- Source filter -->
                <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                    <TextBlock Text="Source:" Foreground="{DynamicResource Text.SecondaryBrush}"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding SourceFilter, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputBox}" Width="140"/>
                </StackPanel>

                <!-- Keyword search -->
                <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                    <TextBlock Text="Tìm:" Foreground="{DynamicResource Text.SecondaryBrush}"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding KeywordFilter, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputBox}" Width="180"/>
                </StackPanel>

                <!-- From date -->
                <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                    <TextBlock Text="Từ:" Foreground="{DynamicResource Text.SecondaryBrush}"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker SelectedDate="{Binding FromDate}"
                                Height="36" Width="130"
                                Background="{DynamicResource Input.BackgroundBrush}"
                                Foreground="{DynamicResource Text.PrimaryBrush}"
                                BorderBrush="{DynamicResource Input.BorderBrush}"/>
                </StackPanel>

                <!-- Refresh button -->
                <Button Content="🔍 Lọc"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource ButtonBase}"
                        Width="80" Height="36" Margin="0,0,6,4"
                        Background="{DynamicResource Button.PrimaryBrush}"/>
                <Button Content="✕ Xoá lọc"
                        Command="{Binding ClearFilterCommand}"
                        Style="{StaticResource ButtonBase}"
                        Width="90" Height="36" Margin="0,0,0,4"
                        Background="{DynamicResource Button.NeutralBrush}"/>
            </WrapPanel>
        </Border>

        <!-- ═══ Log DataGrid ════════════════════════════════════════════════ -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding FilteredLogs}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" GridLinesVisibility="Horizontal"
                  Background="{DynamicResource Panel.BackgroundBrush}"
                  Foreground="{DynamicResource Text.PrimaryBrush}"
                  BorderBrush="{DynamicResource Border.DefaultBrush}"
                  RowBackground="{DynamicResource Grid.RowBrush}"
                  AlternatingRowBackground="{DynamicResource Grid.AltRowBrush}"
                  ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  EnableRowVirtualization="True"
                  FontFamily="Consolas" FontSize="12">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Thời gian"
                                    Binding="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm:ss.fff'}"
                                    Width="180"/>
                <DataGridTemplateColumn Header="Level" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="3" Padding="4,2" Margin="4,1"
                                    Background="{Binding LevelBrush}">
                                <TextBlock Text="{Binding Level}"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Source" Binding="{Binding Source}"
                                    Width="180"/>
                <DataGridTextColumn Header="Message" Binding="{Binding Message}"
                                    Width="*"/>
            </DataGrid.Columns>

            <!-- Row style: tô màu nền theo severity -->
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Level}" Value="CRIT">
                            <Setter Property="Background" Value="#33B71C1C"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Level}" Value="ERRO">
                            <Setter Property="Background" Value="#22F44336"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Level}" Value="WARN">
                            <Setter Property="Background" Value="#22FFC107"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>

        <!-- ═══ Footer ══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Foreground="{DynamicResource Text.SecondaryBrush}" FontSize="12"
                       VerticalAlignment="Center">
                <Run Text="Hiển thị: "/><Run Text="{Binding DisplayedCount, Mode=OneWay}"/>
                <Run Text=" / "/><Run Text="{Binding TotalCount, Mode=OneWay}"/>
                <Run Text=" dòng"/>
            </TextBlock>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="📤 Export CSV"
                        Command="{Binding ExportCsvCommand}"
                        Style="{StaticResource ButtonBase}"
                        Width="110" Height="36" Margin="0,0,8,0"
                        Background="{DynamicResource Button.NeutralBrush}"/>
                <Button Content="🗑 Clear (Admin)"
                        Command="{Binding ClearLogsCommand}"
                        Style="{StaticResource ButtonBase}"
                        Width="110" Height="36"
                        Background="{DynamicResource Button.DangerBrush}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
