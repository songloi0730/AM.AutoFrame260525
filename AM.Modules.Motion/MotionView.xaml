<!--
    MotionView.xaml — AM.Modules.Motion
    ISA-101 Level-2 Screen: Motion Control & Diagnostics
    ════════════════════════════════════════════════════════════════════════
    Layout (ISA-101 §7.4 — Motion Faceplate):
      [Header] Title + Home All button + Stop All button (danger, 48px gap)
      [Body  ]
        Left panel: Axis status cards (position/speed/state/homed indicator)
        Right panel: Jog + Teach
          [Jog panel ] Axis selector + step size + JOG+/JOG-/HOME/STOP buttons
          [Teach panel] Position table (Name/X/Y/Z/W/saved) + Save/GoTo
          [Override  ] Velocity % slider, Accel % slider
    ════════════════════════════════════════════════════════════════════════
-->
<UserControl x:Class="AM.Modules.Motion.MotionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{DynamicResource Screen.BackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Axis card color by state — applied in code-behind via DataTrigger -->
        <Style x:Key="AxisCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Width" Value="180"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>

        <!-- Large jog button — SEMI S8: 60×60px min (glove-friendly) -->
        <Style x:Key="JogBtn" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Background" Value="{DynamicResource JogButton.BackgroundBrush}"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>    <!-- Header: title + global buttons -->
            <RowDefinition Height="12"/>      <!-- Spacer -->
            <RowDefinition Height="*"/>       <!-- Body -->
        </Grid.RowDefinitions>

        <!-- ═══ Header ═════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Motion Control"
                       Style="{StaticResource SectionHeader}"
                       FontSize="20" Margin="0"/>

            <!-- Global action buttons (danger gap: 48px Margin between Home All and Stop All) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="🏠 Home All"
                        Command="{Binding HomeAllCommand}"
                        Style="{StaticResource ControlButton}"
                        Width="110" Margin="0,0,48,0"
                        Background="{DynamicResource Button.PrimaryBrush}"/>
                <!-- Stop All — màu đỏ, cách 48px khỏi nút thường (ISA-101) -->
                <Button Content="⏹ STOP ALL"
                        Command="{Binding StopAllCommand}"
                        Style="{StaticResource ControlButton}"
                        Width="110"
                        Background="{DynamicResource Status.AlarmBrush}"/>
            </StackPanel>
        </Grid>

        <!-- ═══ Body ════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>        <!-- Left: Axis cards -->
                <ColumnDefinition Width="12"/>       <!-- Separator -->
                <ColumnDefinition Width="380"/>      <!-- Right: Jog + Teach -->
            </Grid.ColumnDefinitions>

            <!-- ─── Left: Axis Status Cards ──────────────────────────────────── -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Trạng thái Axis" Style="{StaticResource SectionHeader}"/>

                    <ItemsControl ItemsSource="{Binding Axes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Axis card — border color indicates state -->
                                <Border Style="{StaticResource AxisCard}"
                                        x:Name="AxisCardBorder">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource AxisCard}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMoving}" Value="True">
                                                    <Setter Property="BorderBrush"
                                                            Value="{StaticResource Status.ManualBrush}"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsAlarm}" Value="True">
                                                    <Setter Property="BorderBrush"
                                                            Value="{StaticResource Status.AlarmBrush}"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsHomed}" Value="True">
                                                    <Setter Property="BorderBrush"
                                                            Value="{StaticResource Status.NormalBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <StackPanel>
                                        <!-- Axis name + homed indicator -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Ellipse Width="10" Height="10" Margin="0,0,6,0"
                                                     VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill"
                                                                Value="{StaticResource Status.DisabledBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHomed}" Value="True">
                                                                <Setter Property="Fill"
                                                                        Value="{StaticResource Status.NormalBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsAlarm}" Value="True">
                                                                <Setter Property="Fill"
                                                                        Value="{StaticResource Status.AlarmBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="Bold" FontSize="14"
                                                       Foreground="{DynamicResource Text.HeadingBrush}"/>
                                        </StackPanel>

                                        <!-- Position (live value) -->
                                        <TextBlock Text="{Binding Position, StringFormat='{}{0:F3}'}"
                                                   Style="{StaticResource KpiValue}"
                                                   FontSize="20"/>
                                        <TextBlock Text="mm" Style="{StaticResource KpiLabel}"/>

                                        <!-- Speed -->
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                                    HorizontalAlignment="Center">
                                            <TextBlock Text="v: "
                                                       Foreground="{DynamicResource Text.SecondaryBrush}"
                                                       FontSize="11"/>
                                            <TextBlock Text="{Binding Speed, StringFormat='{}{0:F0} mm/s'}"
                                                       Foreground="{DynamicResource Text.LiveValueBrush}"
                                                       FontSize="11" FontFamily="Consolas"/>
                                        </StackPanel>

                                        <!-- State label -->
                                        <TextBlock Text="{Binding StateLabel}"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource Text.SecondaryBrush}"
                                                   FontSize="11" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ─── Right: Jog + Teach + Override ───────────────────────────── -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- Jog panel -->
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>      <!-- Teach table -->
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>   <!-- Override sliders -->
                </Grid.RowDefinitions>

                <!-- ─── Jog Panel ─────────────────────────────────────────── -->
                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Jog / Di chuyển thủ công"
                                   Style="{StaticResource SectionHeader}"/>

                        <!-- Axis selector + step size -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Axis:" FontSize="11"
                                           Foreground="{DynamicResource Text.SecondaryBrush}"
                                           Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding Axes}"
                                          SelectedItem="{Binding SelectedAxis}"
                                          DisplayMemberPath="Name"
                                          Style="{StaticResource InputCombo}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Bước (mm):" FontSize="11"
                                           Foreground="{DynamicResource Text.SecondaryBrush}"
                                           Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding JogStepSizes}"
                                          SelectedItem="{Binding SelectedJogStep}"
                                          Style="{StaticResource InputCombo}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Jog buttons — ISA-101: symmetric layout, consistent size -->
                        <Grid HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="−−" ToolTip="Jog− Fast"
                                    Command="{Binding JogNegFastCommand}"
                                    Style="{StaticResource JogBtn}"/>
                            <Button Grid.Column="1" Content="−" ToolTip="Jog−"
                                    Command="{Binding JogNegCommand}"
                                    Style="{StaticResource JogBtn}"/>
                            <Button Grid.Column="2" Content="🏠" ToolTip="Home axis"
                                    Command="{Binding HomeAxisCommand}"
                                    Style="{StaticResource JogBtn}"
                                    Background="{DynamicResource Button.PrimaryBrush}"/>
                            <!-- 20px gap (ISA-101: dangerous direction separation) -->
                            <Button Grid.Column="4" Content="+" ToolTip="Jog+"
                                    Command="{Binding JogPosCommand}"
                                    Style="{StaticResource JogBtn}"/>
                            <Button Grid.Column="5" Content="++" ToolTip="Jog+ Fast"
                                    Command="{Binding JogPosFastCommand}"
                                    Style="{StaticResource JogBtn}"/>
                        </Grid>

                        <!-- Move to absolute position -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding MoveAbsTarget, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputBox}"
                                     ToolTip="Vị trí tuyệt đối (mm)"/>
                            <Button Grid.Column="2" Content="→ Di chuyển"
                                    Command="{Binding MoveAbsCommand}"
                                    Style="{StaticResource ButtonBase}"
                                    Width="100"
                                    Background="{DynamicResource Button.PrimaryBrush}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ─── Teach Point Table ─────────────────────────────────── -->
                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Teach Points" Style="{StaticResource SectionHeader}"
                                       Margin="0"/>
                        </StackPanel>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding TeachPoints}"
                                  SelectedItem="{Binding SelectedTeachPoint}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  GridLinesVisibility="Horizontal"
                                  Background="{DynamicResource Panel.BackgroundBrush}"
                                  Foreground="{DynamicResource Text.PrimaryBrush}"
                                  BorderBrush="{DynamicResource Border.DefaultBrush}"
                                  RowBackground="{DynamicResource Grid.RowBrush}"
                                  AlternatingRowBackground="{DynamicResource Grid.AltRowBrush}"
                                  ColumnHeaderStyle="{StaticResource GridHeaderStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tên" Binding="{Binding Name}" Width="100"/>
                                <DataGridTextColumn Header="X (mm)" Binding="{Binding X, StringFormat=F3}"
                                                    Width="80" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Y (mm)" Binding="{Binding Y, StringFormat=F3}"
                                                    Width="80" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Z (mm)" Binding="{Binding Z, StringFormat=F3}"
                                                    Width="80" IsReadOnly="True"/>
                                <DataGridCheckBoxColumn Header="Saved" Binding="{Binding IsSaved}"
                                                        Width="60" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="📍 Teach Here"
                                    Command="{Binding TeachCurrentPositionCommand}"
                                    Style="{StaticResource ButtonBase}"
                                    Height="36" Width="110" Margin="0,0,6,0"
                                    Background="{DynamicResource Status.WarningBrush}"/>
                            <Button Content="▶ Go To"
                                    Command="{Binding GoToTeachPointCommand}"
                                    Style="{StaticResource ButtonBase}"
                                    Height="36" Width="80" Margin="0,0,6,0"
                                    Background="{DynamicResource Button.PrimaryBrush}"/>
                            <Button Content="💾 Save"
                                    Command="{Binding SaveTeachPointsCommand}"
                                    Style="{StaticResource ButtonBase}"
                                    Height="36" Width="80"
                                    Background="{DynamicResource Status.NormalBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ─── Override Sliders ──────────────────────────────────── -->
                <Border Grid.Row="4" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Override" Style="{StaticResource SectionHeader}"/>

                        <!-- Velocity override -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Vận tốc:"
                                       Foreground="{DynamicResource Text.SecondaryBrush}"
                                       FontSize="12" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Minimum="1" Maximum="100"
                                    Value="{Binding VelocityOverridePercent}"
                                    VerticalAlignment="Center" Margin="8,0"/>
                            <TextBlock Grid.Column="2"
                                       Foreground="{DynamicResource Text.LiveValueBrush}"
                                       FontFamily="Consolas" FontSize="12"
                                       VerticalAlignment="Center">
                                <Run Text="{Binding VelocityOverridePercent, StringFormat=F0}"/>
                                <Run Text="%"/>
                            </TextBlock>
                        </Grid>

                        <!-- Acceleration override -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Gia tốc:"
                                       Foreground="{DynamicResource Text.SecondaryBrush}"
                                       FontSize="12" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Minimum="1" Maximum="100"
                                    Value="{Binding AccelOverridePercent}"
                                    VerticalAlignment="Center" Margin="8,0"/>
                            <TextBlock Grid.Column="2"
                                       Foreground="{DynamicResource Text.LiveValueBrush}"
                                       FontFamily="Consolas" FontSize="12"
                                       VerticalAlignment="Center">
                                <Run Text="{Binding AccelOverridePercent, StringFormat=F0}"/>
                                <Run Text="%"/>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
