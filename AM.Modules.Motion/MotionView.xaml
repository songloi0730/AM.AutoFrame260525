<UserControl x:Class="AM.Modules.Motion.MotionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:AM.UI.Localization;assembly=AM.UI.Localization"
             xmlns:conv="clr-namespace:AM.Modules.Motion.Converters"
             xmlns:local="clr-namespace:AM.Modules.Motion"
             xmlns:iomon="clr-namespace:AM.Modules.IoMonitor;assembly=AM.Modules.IoMonitor"
             xmlns:calib="clr-namespace:AM.Modules.Calibration;assembly=AM.Modules.Calibration"
             mc:Ignorable="d"
             Background="{DynamicResource Screen.BackgroundBrush}">

    <!--
    Màn điều khiển trục — theo HMI_Naming_and_Axis_Point_Model + mockup hmi_axis_detail_v1.
    Trái: bảng đèn 8 tín hiệu/trục + điều khiển từng trục (servo/home/clear/move).
    Phải: jog pad (inching) + bước + phản hồi servo. Dưới: bảng điểm Set/Confirm 2-chạm.
    Bind interface-only (IMotionController + IAxisDiagnostics tuỳ chọn). Palette v2, ISA-101 phẳng.
    -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:IndexToVisibilityConverter x:Key="IndexToVis"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource Panel.BackgroundAltBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.DefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.SecondaryBrush}"/>
        </Style>
        <Style x:Key="Mono" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>

        <!-- Nút thao tác nhỏ (servo/home/clear/move) — chữ nhật phẳng -->
        <Style x:Key="MiniButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{DynamicResource Card.BackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.DefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.PrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource Panel.BackgroundHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ô nhập số nhỏ -->
        <Style x:Key="NumBox" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Width" Value="92"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Padding" Value="0,0,8,0"/>
            <Setter Property="Background" Value="{DynamicResource Input.BackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Input.BorderBrush}"/>
        </Style>

        <!-- Nút jog pad -->
        <Style x:Key="JogButton" TargetType="Button">
            <Setter Property="Width" Value="72"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{DynamicResource Card.BackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.DefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.PrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource Panel.BackgroundHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segment chọn (mode jog / mức inching) -->
        <Style x:Key="SegButton" TargetType="RadioButton">
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.SecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{DynamicResource Card.BackgroundBrush}"
                                BorderBrush="{DynamicResource Border.DefaultBrush}" BorderThickness="1"
                                Padding="10,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Info.BackgroundBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Status.InfoBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource Status.InfoBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- LED tín hiệu 16px: off = xám viền; chuyển màu theo trigger ở chỗ dùng -->
        <Style x:Key="Led" TargetType="Ellipse">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="{DynamicResource Border.DefaultBrush}"/>
        </Style>
        <Style x:Key="SigHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.SecondaryBrush}"/>
        </Style>

        <!-- Ô toạ độ bảng điểm: chạm = chọn riêng trục; hiện confirm (to) + set/▲lệch (nhỏ) -->
        <DataTemplate x:Key="CellTemplate">
            <Button HorizontalContentAlignment="Stretch" Cursor="Hand"
                    Command="{Binding DataContext.SelectCellCommand,
                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" Padding="6,2"
                                BorderBrush="{StaticResource Status.InfoBrush}" BorderThickness="0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Panel.BackgroundHoverBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Info.BackgroundBrush}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel>
                    <TextBlock Text="{Binding ConfirmText}" TextAlignment="Right" FontFamily="Consolas" FontSize="13"
                               Foreground="{DynamicResource Text.PrimaryBrush}"/>
                    <TextBlock Text="{Binding SetText}" TextAlignment="Right" FontFamily="Consolas" FontSize="10">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Text.PlaceholderBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasDelta}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Status.AlarmBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Vận hành tay: dải khóa trạng thái (CỐ ĐỊNH) + sub-tab + nội dung pane -->
    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- dải khóa trạng thái -->
            <RowDefinition Height="Auto"/>   <!-- thanh sub-tab -->
            <RowDefinition Height="*"/>      <!-- nội dung pane -->
        </Grid.RowDefinitions>

        <!-- ═══ Dải khóa trạng thái (§1.3 — máy chạy thì khóa điều chỉnh) ════════ -->
        <Border Grid.Row="0" CornerRadius="8" Padding="14,9" Margin="0,0,0,10">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource Ok.BackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Status.NormalBrush}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAdjustAllowed}" Value="False">
                            <Setter Property="Background" Value="{DynamicResource Panel.BackgroundHoverBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource Border.DefaultBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding LockText}" FontSize="14" FontWeight="SemiBold">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource Text.SuccessBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAdjustAllowed}" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource Text.SecondaryBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <!-- ═══ Thanh sub-tab: Điều khiển trục · Bảng điểm · Thao tác trạm · Override ═ -->
        <Border Grid.Row="1" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Border.DefaultBrush}"
                Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="RadioButton" x:Key="SubTab">
                        <Setter Property="MinWidth" Value="130"/>
                        <Setter Property="Height" Value="40"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Foreground" Value="{DynamicResource Text.SecondaryBrush}"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="Bd" Background="Transparent" Padding="18,0"
                                            BorderThickness="0,0,0,3" BorderBrush="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Panel.BackgroundHoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Status.InfoBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Text.PrimaryBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </StackPanel.Resources>
                <RadioButton Style="{StaticResource SubTab}" GroupName="mtab" IsChecked="True"
                             Command="{Binding SelectSubTabCommand}" CommandParameter="0"
                             Content="{Binding [Manual.Tab.Axis], Source={x:Static loc:Loc.Strings}}"/>
                <RadioButton Style="{StaticResource SubTab}" GroupName="mtab"
                             Command="{Binding SelectSubTabCommand}" CommandParameter="1"
                             Content="{Binding [Manual.Tab.Points], Source={x:Static loc:Loc.Strings}}"/>
                <RadioButton Style="{StaticResource SubTab}" GroupName="mtab"
                             Command="{Binding SelectSubTabCommand}" CommandParameter="2"
                             Content="{Binding [Manual.Tab.Io], Source={x:Static loc:Loc.Strings}}"/>
                <RadioButton Style="{StaticResource SubTab}" GroupName="mtab"
                             Command="{Binding SelectSubTabCommand}" CommandParameter="3"
                             Content="{Binding [Manual.Tab.Station], Source={x:Static loc:Loc.Strings}}"/>
                <RadioButton Style="{StaticResource SubTab}" GroupName="mtab"
                             Command="{Binding SelectSubTabCommand}" CommandParameter="4"
                             Foreground="{StaticResource Status.AlarmBrush}"
                             Content="{Binding [Manual.Tab.Override], Source={x:Static loc:Loc.Strings}}"/>
                <!-- Hiệu chỉnh routine — TỰ ẨN khi máy không khai routine (HMI_Calibration_Model §2) -->
                <RadioButton Style="{StaticResource SubTab}" GroupName="mtab"
                             Command="{Binding SelectSubTabCommand}" CommandParameter="5"
                             Visibility="{Binding Calibration.HasRoutines, Converter={StaticResource BoolToVis}}"
                             Content="{Binding [Manual.Tab.Calib], Source={x:Static loc:Loc.Strings}}"/>
            </StackPanel>
        </Border>

        <!-- ═══ Nội dung pane (hiện đúng một theo SubTabIndex) ═══════════════════ -->
        <Grid Grid.Row="2">

            <!-- ══ PANE 0: Điều khiển trục ══ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding SubTabIndex, Converter={StaticResource IndexToVis}, ConverterParameter=0}">
                <StackPanel>

            <!-- ═══ HÀNG TRÊN: (trái) tín hiệu + điều khiển trục · (phải) jog + phản hồi ═══ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="356"/>
                </Grid.ColumnDefinitions>

                <!-- ── Cột trái ─────────────────────────────────────────────────── -->
                <StackPanel Grid.Column="0">

                    <!-- Bảng đèn 8 tín hiệu (chỉ khi có IAxisDiagnostics) -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                            Visibility="{Binding HasDiagnostics, Converter={StaticResource BoolToVis}}">
                        <Grid Grid.IsSharedSizeScope="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Style="{StaticResource CardTitle}"
                                       Text="{Binding [Axis.SignalTable], Source={x:Static loc:Loc.Strings}}"/>

                            <!-- Header -->
                            <Grid Grid.Row="1" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.6*" SharedSizeGroup="cName"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource SigHeader}" HorizontalAlignment="Left"
                                           Text="{Binding [Axis.Col], Source={x:Static loc:Loc.Strings}}"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource SigHeader}" Text="Alarm&#x0a;报警"/>
                                <TextBlock Grid.Column="2" Style="{StaticResource SigHeader}" Text="+Limit&#x0a;正限位"/>
                                <TextBlock Grid.Column="3" Style="{StaticResource SigHeader}" Text="−Limit&#x0a;负限位"/>
                                <TextBlock Grid.Column="4" Style="{StaticResource SigHeader}" Text="Origin&#x0a;原点"/>
                                <TextBlock Grid.Column="5" Style="{StaticResource SigHeader}" Text="E-Stop&#x0a;急停"/>
                                <TextBlock Grid.Column="6" Style="{StaticResource SigHeader}" Text="Zero&#x0a;零位"/>
                                <TextBlock Grid.Column="7" Style="{StaticResource SigHeader}" Text="In-Pos&#x0a;到位"/>
                                <TextBlock Grid.Column="8" Style="{StaticResource SigHeader}" Text="Servo&#x0a;励磁"/>
                            </Grid>

                            <ItemsControl Grid.Row="2" ItemsSource="{Binding Axes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="34" Background="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.6*" SharedSizeGroup="cName"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.ColumnSpan="9" BorderThickness="0,1,0,0"
                                                    BorderBrush="{DynamicResource Card.BorderBrush}"/>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"
                                                       FontWeight="SemiBold" FontSize="13"
                                                       Foreground="{DynamicResource Text.PrimaryBrush}"/>
                                            <!-- Alarm (đỏ khi true) -->
                                            <Ellipse Grid.Column="1" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse" BasedOn="{StaticResource Led}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Alarm}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource Status.AlarmBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <Ellipse Grid.Column="2" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse" BasedOn="{StaticResource Led}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PlusLimit}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource Status.AlarmBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <Ellipse Grid.Column="3" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse" BasedOn="{StaticResource Led}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding MinusLimit}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource Status.AlarmBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <Ellipse Grid.Column="4" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse" BasedOn="{StaticResource Led}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Origin}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource Status.NormalBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <Ellipse Grid.Column="5" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse" BasedOn="{StaticResource Led}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EStop}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource Status.AlarmBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <Ellipse Grid.Column="6" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse" BasedOn="{StaticResource Led}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Zero}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource Status.NormalBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <Ellipse Grid.Column="7" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse" BasedOn="{StaticResource Led}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding InPosition}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource Status.NormalBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <Ellipse Grid.Column="8" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse" BasedOn="{StaticResource Led}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ServoOn}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource Status.NormalBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <!-- Điều khiển từng trục — khóa khi máy đang chạy (IsAdjustAllowed) -->
                    <Border Style="{StaticResource Card}" IsEnabled="{Binding IsAdjustAllowed}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Style="{StaticResource CardTitle}" Margin="0"
                                           Text="{Binding [Axis.PerAxis], Source={x:Static loc:Loc.Strings}}"/>
                            </DockPanel>

                            <!-- Thanh nhóm + lệnh toàn cục -->
                            <DockPanel Margin="0,0,0,8">
                                <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding AxisGroups}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Padding="10,6" Margin="0,0,6,0"
                                                    Background="{DynamicResource Card.BackgroundBrush}">
                                                <TextBlock Text="{Binding}" FontSize="13"
                                                           Foreground="{DynamicResource Text.SecondaryBrush}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource MiniButton}" Command="{Binding ClearAllErrorsCommand}"
                                            BorderBrush="{StaticResource Status.WarningBrush}"
                                            Foreground="{StaticResource Status.WarningBrush}"
                                            Content="{Binding [Axis.ClearAll], Source={x:Static loc:Loc.Strings}}"/>
                                    <Button Style="{StaticResource MiniButton}" Margin="0" Command="{Binding HomeAllCommand}"
                                            BorderBrush="{StaticResource Status.NormalBrush}"
                                            Foreground="{StaticResource Status.NormalBrush}"
                                            Content="{Binding [Axis.HomeAll], Source={x:Static loc:Loc.Strings}}"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- ═ Phanh trục Z (Gói D S92): nhả = confirm 2 bước Engineer;
                                 đang nhả = banner đỏ + nút đóng; rời màn/đổi user = tự đóng ═ -->
                            <Border Margin="0,8,0,4" CornerRadius="6" Padding="12,8"
                                    Visibility="{Binding HasBrake, Converter={StaticResource BoolToVis}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource Panel.BackgroundAltBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBrakeReleased}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource Status.AlarmBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <!-- Bình thường: mô tả + nút nhả (bước 1) -->
                                    <DockPanel>
                                        <DockPanel.Style>
                                            <Style TargetType="DockPanel">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBrakeReleased}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsConfirmingBrake}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DockPanel.Style>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource MiniButton}" Margin="12,0,0,0"
                                                Command="{Binding RequestReleaseBrakeCommand}"
                                                BorderBrush="{StaticResource Status.WarningBrush}"
                                                Foreground="{StaticResource Status.WarningBrush}"
                                                Content="{Binding [Brake.Release], Source={x:Static loc:Loc.Strings}}"/>
                                        <TextBlock VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap"
                                                   Text="{Binding [Brake.Hint], Source={x:Static loc:Loc.Strings}}"
                                                   Foreground="{DynamicResource Text.SecondaryBrush}"/>
                                    </DockPanel>

                                    <!-- Bước 2: cảnh báo + Xác nhận/Hủy -->
                                    <DockPanel Visibility="{Binding IsConfirmingBrake, Converter={StaticResource BoolToVis}}">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                                            <Button Style="{StaticResource MiniButton}"
                                                    Command="{Binding ConfirmReleaseBrakeCommand}"
                                                    BorderBrush="{StaticResource Status.AlarmBrush}"
                                                    Foreground="{StaticResource Status.AlarmBrush}"
                                                    Content="{Binding [Brake.Confirm], Source={x:Static loc:Loc.Strings}}"/>
                                            <Button Style="{StaticResource MiniButton}" Margin="8,0,0,0"
                                                    Command="{Binding CancelBrakeConfirmCommand}"
                                                    Content="{Binding [Brake.Cancel], Source={x:Static loc:Loc.Strings}}"/>
                                        </StackPanel>
                                        <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding [Brake.Warn], Source={x:Static loc:Loc.Strings}}"
                                                   Foreground="{StaticResource Status.AlarmBrush}"/>
                                    </DockPanel>

                                    <!-- Đang nhả: banner đỏ + nút đóng (1 chạm) -->
                                    <DockPanel Visibility="{Binding IsBrakeReleased, Converter={StaticResource BoolToVis}}">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource MiniButton}" Margin="12,0,0,0"
                                                Command="{Binding EngageBrakeCommand}"
                                                BorderBrush="{DynamicResource Status.ForegroundBrush}"
                                                Foreground="{DynamicResource Status.ForegroundBrush}"
                                                Content="{Binding [Brake.Engage], Source={x:Static loc:Loc.Strings}}"/>
                                        <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="Bold"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding [Brake.ReleasedBanner], Source={x:Static loc:Loc.Strings}}"
                                                   Foreground="{DynamicResource Status.ForegroundBrush}"/>
                                    </DockPanel>
                                </Grid>
                            </Border>

                            <!-- Hàng mỗi trục -->
                            <ItemsControl ItemsSource="{Binding VisibleAxes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Card.BorderBrush}"
                                                Padding="0,8" Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Trái: tên + vị trí + servo/home/clear -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Width="92" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource Text.PrimaryBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Alarm}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource Status.AlarmBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                        <Run Text="{Binding Name, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Width="104" VerticalAlignment="Center" FontFamily="Consolas"
                                                               FontSize="17" TextAlignment="Right" Margin="0,0,10,0"
                                                               Text="{Binding Position, StringFormat={}{0:F3}}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource Text.LiveValueBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMoving}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource Status.InfoBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Alarm}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource Status.AlarmBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <!-- Servo ON (chỉ khi có IAxisDiagnostics) -->
                                                    <Button Visibility="{Binding HasDiagnostics, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.ToggleServoCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource MiniButton}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ServoOn}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource Ok.BackgroundBrush}"/>
                                                                        <Setter Property="BorderBrush" Value="{StaticResource Status.NormalBrush}"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource Status.NormalBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <TextBlock>
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="OFF"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ServoOn}" Value="True">
                                                                            <Setter Property="Text" Value="ON"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Button>
                                                    <Button Style="{StaticResource MiniButton}"
                                                            Content="{Binding [Axis.Home], Source={x:Static loc:Loc.Strings}}"
                                                            Command="{Binding DataContext.HomeAxisCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Style="{StaticResource MiniButton}"
                                                            BorderBrush="{StaticResource Status.WarningBrush}"
                                                            Foreground="{StaticResource Status.WarningBrush}"
                                                            Content="{Binding [Axis.Clear], Source={x:Static loc:Loc.Strings}}"
                                                            Command="{Binding DataContext.ClearErrorCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>

                                                <!-- Phải: đích + di chuyển + tốc độ (ẩn khi alarm) -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                                            VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal"
                                                                Visibility="{Binding Alarm, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding [Axis.ServoAlarmClear], Source={x:Static loc:Loc.Strings}}"
                                                                   VerticalAlignment="Center" FontSize="12"
                                                                   Foreground="{StaticResource Status.AlarmBrush}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding [Axis.MoveTo], Source={x:Static loc:Loc.Strings}}"
                                                               VerticalAlignment="Center" Margin="0,0,6,0"
                                                               Foreground="{DynamicResource Text.SecondaryBrush}"/>
                                                    <TextBox Style="{StaticResource NumBox}"
                                                             Text="{Binding MoveTarget, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F3}}"/>
                                                    <Button Style="{StaticResource MiniButton}" Margin="6,0,6,0"
                                                            BorderBrush="{StaticResource Status.InfoBrush}"
                                                            Foreground="{StaticResource Status.InfoBrush}"
                                                            Content="{Binding [Axis.Move], Source={x:Static loc:Loc.Strings}}"
                                                            Command="{Binding DataContext.MoveAbsCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"/>
                                                    <TextBlock Text="{Binding [Axis.Speed], Source={x:Static loc:Loc.Strings}}"
                                                               VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12"
                                                               Foreground="{DynamicResource Text.PlaceholderBrush}"/>
                                                    <TextBox Style="{StaticResource NumBox}" Width="56"
                                                             Text="{Binding SpeedPercent, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F0}}"/>
                                                    <TextBlock Text="%" VerticalAlignment="Center" Margin="4,0,0,0"
                                                               Foreground="{DynamicResource Text.SecondaryBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ── Cột phải: jog (khóa khi chạy) + phản hồi (luôn xem) ──────── -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12" IsEnabled="{Binding IsAdjustAllowed}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}">
                                <Run Text="{Binding [Axis.Jog], Source={x:Static loc:Loc.Strings}, Mode=OneWay}"/>
                                <Run Text="{Binding SelectedAxis.Name, Mode=OneWay}"
                                     Foreground="{StaticResource Status.InfoBrush}"/>
                            </TextBlock>

            <!-- Mode tương đối / tuyệt đối (Absolute radio TwoWay; Relative là trạng thái còn lại của nhóm) -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <RadioButton Style="{StaticResource SegButton}" GroupName="jogmode" IsChecked="True"
                                             Content="{Binding [Axis.Relative], Source={x:Static loc:Loc.Strings}}"/>
                                <RadioButton Style="{StaticResource SegButton}" GroupName="jogmode"
                                             IsChecked="{Binding AbsoluteJog, Mode=TwoWay}"
                                             Content="{Binding [Axis.Absolute], Source={x:Static loc:Loc.Strings}}"/>
                            </StackPanel>

                            <!-- Jog pad 3×3 (slot0=X giữa, slot1=Y, slot2=Z, slot3=U).
                                 GIỮ-ĐỂ-CHẠY (P1.5): nhấn giữ = velocity-jog + KeepAlive deadman;
                                 nhả/rời nút = dừng. HAL không hỗ trợ IAxisJog → mỗi nhấn = 1 bước inching. -->
                            <UniformGrid Rows="3" Columns="3" HorizontalAlignment="Center">
                                <Button Style="{StaticResource JogButton}" Content="U +"
                                        Visibility="{Binding JogSlots[3], Converter={StaticResource NullToVis}}"
                                        local:JogHold.DownCommand="{Binding JogHoldPlusCommand}"
                                        local:JogHold.UpCommand="{Binding JogHoldStopCommand}"
                                        local:JogHold.Parameter="{Binding JogSlots[3]}"/>
                                <Button Style="{StaticResource JogButton}" Content="Y ↑"
                                        Visibility="{Binding JogSlots[1], Converter={StaticResource NullToVis}}"
                                        local:JogHold.DownCommand="{Binding JogHoldPlusCommand}"
                                        local:JogHold.UpCommand="{Binding JogHoldStopCommand}"
                                        local:JogHold.Parameter="{Binding JogSlots[1]}"/>
                                <Button Style="{StaticResource JogButton}" Content="Z ↑"
                                        Visibility="{Binding JogSlots[2], Converter={StaticResource NullToVis}}"
                                        local:JogHold.DownCommand="{Binding JogHoldPlusCommand}"
                                        local:JogHold.UpCommand="{Binding JogHoldStopCommand}"
                                        local:JogHold.Parameter="{Binding JogSlots[2]}"/>

                                <Button Style="{StaticResource JogButton}" Content="X −"
                                        Visibility="{Binding JogSlots[0], Converter={StaticResource NullToVis}}"
                                        local:JogHold.DownCommand="{Binding JogHoldMinusCommand}"
                                        local:JogHold.UpCommand="{Binding JogHoldStopCommand}"
                                        local:JogHold.Parameter="{Binding JogSlots[0]}"/>
                                <Button Style="{StaticResource JogButton}" Content="STOP" Command="{Binding StopMotionCommand}"
                                        BorderBrush="{StaticResource Status.AlarmBrush}"
                                        Foreground="{StaticResource Status.AlarmBrush}" FontWeight="Bold"/>
                                <Button Style="{StaticResource JogButton}" Content="X +"
                                        Visibility="{Binding JogSlots[0], Converter={StaticResource NullToVis}}"
                                        local:JogHold.DownCommand="{Binding JogHoldPlusCommand}"
                                        local:JogHold.UpCommand="{Binding JogHoldStopCommand}"
                                        local:JogHold.Parameter="{Binding JogSlots[0]}"/>

                                <Button Style="{StaticResource JogButton}" Content="U −"
                                        Visibility="{Binding JogSlots[3], Converter={StaticResource NullToVis}}"
                                        local:JogHold.DownCommand="{Binding JogHoldMinusCommand}"
                                        local:JogHold.UpCommand="{Binding JogHoldStopCommand}"
                                        local:JogHold.Parameter="{Binding JogSlots[3]}"/>
                                <Button Style="{StaticResource JogButton}" Content="Y ↓"
                                        Visibility="{Binding JogSlots[1], Converter={StaticResource NullToVis}}"
                                        local:JogHold.DownCommand="{Binding JogHoldMinusCommand}"
                                        local:JogHold.UpCommand="{Binding JogHoldStopCommand}"
                                        local:JogHold.Parameter="{Binding JogSlots[1]}"/>
                                <Button Style="{StaticResource JogButton}" Content="Z ↓"
                                        Visibility="{Binding JogSlots[2], Converter={StaticResource NullToVis}}"
                                        local:JogHold.DownCommand="{Binding JogHoldMinusCommand}"
                                        local:JogHold.UpCommand="{Binding JogHoldStopCommand}"
                                        local:JogHold.Parameter="{Binding JogSlots[2]}"/>
                            </UniformGrid>

                            <!-- Bước inching -->
                            <TextBlock Text="{Binding [Axis.InchingStep], Source={x:Static loc:Loc.Strings}}"
                                       FontSize="12" Margin="0,12,0,4"
                                       Foreground="{DynamicResource Text.SecondaryBrush}"/>
                            <UniformGrid Columns="3">
                                <RadioButton Style="{StaticResource SegButton}" GroupName="step" Command="{Binding StepFineCommand}">
                                    <StackPanel><TextBlock Text="0.001" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding [Axis.Fine], Source={x:Static loc:Loc.Strings}}" FontSize="10"
                                                   HorizontalAlignment="Center" Foreground="{DynamicResource Text.PlaceholderBrush}"/></StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource SegButton}" GroupName="step" IsChecked="True" Command="{Binding StepMediumCommand}">
                                    <StackPanel><TextBlock Text="0.01" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding [Axis.Med], Source={x:Static loc:Loc.Strings}}" FontSize="10"
                                                   HorizontalAlignment="Center" Foreground="{DynamicResource Text.PlaceholderBrush}"/></StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource SegButton}" GroupName="step" Command="{Binding StepCoarseCommand}">
                                    <StackPanel><TextBlock Text="0.1" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding [Axis.Coarse], Source={x:Static loc:Loc.Strings}}" FontSize="10"
                                                   HorizontalAlignment="Center" Foreground="{DynamicResource Text.PlaceholderBrush}"/></StackPanel>
                                </RadioButton>
                            </UniformGrid>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                <RadioButton Style="{StaticResource SegButton}" GroupName="step" MinWidth="56"
                                             Command="{Binding StepCustomCommand}"
                                             Content="{Binding [Axis.Custom], Source={x:Static loc:Loc.Strings}}"/>
                                <TextBox Style="{StaticResource NumBox}" Width="80" Margin="6,0"
                                         Text="{Binding CustomStep, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F3}}"/>
                                <TextBlock Text="mm" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Text.PlaceholderBrush}"/>
                            </StackPanel>

                            <!-- Nudge +/− -->
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource MiniButton}" Content="−" FontSize="18"
                                        Command="{Binding NudgeMinusCommand}"/>
                                <TextBlock Grid.Column="1" Text="{Binding CurrentStep, StringFormat={}{0:F3}}"
                                           FontFamily="Consolas" FontSize="14" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Text.PrimaryBrush}"/>
                                <Button Grid.Column="2" Style="{StaticResource MiniButton}" Margin="0" Content="+" FontSize="18"
                                        Command="{Binding NudgePlusCommand}"/>
                            </Grid>

                            <TextBlock Text="{Binding [Axis.JogHint], Source={x:Static loc:Loc.Strings}}"
                                       FontSize="11.5" Margin="0,10,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Text.PlaceholderBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Phản hồi servo trục đang chọn -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Margin="0,0,0,6">
                                <Run Text="{Binding [Axis.Feedback], Source={x:Static loc:Loc.Strings}, Mode=OneWay}"/>
                                <Run Text="{Binding SelectedAxis.Name, Mode=OneWay}"/>
                            </TextBlock>
                            <DockPanel Margin="0,3">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mono}" Text="{Binding FeedbackFollowingError}"
                                           Foreground="{DynamicResource Text.PrimaryBrush}"/>
                                <TextBlock Text="Following error" Foreground="{DynamicResource Text.SecondaryBrush}"/>
                            </DockPanel>
                            <DockPanel Margin="0,3">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mono}" Text="{Binding FeedbackVelocity}"
                                           Foreground="{DynamicResource Text.PrimaryBrush}"/>
                                <TextBlock Text="Feedback velocity" Foreground="{DynamicResource Text.SecondaryBrush}"/>
                            </DockPanel>
                            <DockPanel Margin="0,3">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mono}" Text="{Binding FeedbackTorque}"
                                           Foreground="{DynamicResource Text.PrimaryBrush}"/>
                                <TextBlock Text="Feedback torque" Foreground="{DynamicResource Text.SecondaryBrush}"/>
                            </DockPanel>
                            <DockPanel Margin="0,3">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mono}" Text="{Binding FeedbackMotorLoad}"
                                           Foreground="{DynamicResource Text.PrimaryBrush}"/>
                                <TextBlock Text="Motor load" Foreground="{DynamicResource Text.SecondaryBrush}"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- ══ PANE 1: Bảng điểm ══ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding SubTabIndex, Converter={StaticResource IndexToVis}, ConverterParameter=1}">
            <Border Style="{StaticResource Card}" IsEnabled="{Binding IsAdjustAllowed}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}"
                               Text="{Binding [Axis.PointTable], Source={x:Static loc:Loc.Strings}}"/>

                    <!-- Header -->
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="#" Foreground="{DynamicResource Text.PlaceholderBrush}" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="{Binding [Axis.PointName], Source={x:Static loc:Loc.Strings}}"
                                   Foreground="{DynamicResource Text.PlaceholderBrush}" FontSize="12"/>
                        <TextBlock Grid.Column="2" Text="X" TextAlignment="Right" Foreground="{DynamicResource Text.PlaceholderBrush}" FontSize="12"/>
                        <TextBlock Grid.Column="3" Text="Y" TextAlignment="Right" Foreground="{DynamicResource Text.PlaceholderBrush}" FontSize="12"/>
                        <TextBlock Grid.Column="4" Text="Z" TextAlignment="Right" Foreground="{DynamicResource Text.PlaceholderBrush}" FontSize="12"/>
                        <TextBlock Grid.Column="5" Text="U" TextAlignment="Right" Foreground="{DynamicResource Text.PlaceholderBrush}" FontSize="12"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding PointRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Card.BorderBrush}">
                                    <Grid Height="40">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Ordinal}" VerticalAlignment="Center"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource Text.SecondaryBrush}"/>

                                        <!-- Tên điểm: chạm = chọn cả điểm -->
                                        <Button Grid.Column="1" HorizontalContentAlignment="Left" Cursor="Hand"
                                                Command="{Binding DataContext.SelectPointRowCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="Transparent" Padding="2,0">
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Panel.BackgroundHoverBrush}"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Info.BackgroundBrush}"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                       Foreground="{DynamicResource Text.PrimaryBrush}"/>
                                        </Button>

                                        <!-- 4 ô toạ độ X/Y/Z/U: chạm = chọn riêng trục -->
                                        <ContentControl Grid.Column="2" Content="{Binding Cells[0]}"
                                                        ContentTemplate="{StaticResource CellTemplate}" VerticalAlignment="Center"/>
                                        <ContentControl Grid.Column="3" Content="{Binding Cells[1]}"
                                                        ContentTemplate="{StaticResource CellTemplate}" VerticalAlignment="Center"/>
                                        <ContentControl Grid.Column="4" Content="{Binding Cells[2]}"
                                                        ContentTemplate="{StaticResource CellTemplate}" VerticalAlignment="Center"/>
                                        <ContentControl Grid.Column="5" Content="{Binding Cells[3]}"
                                                        ContentTemplate="{StaticResource CellTemplate}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Thanh chọn + Tới/Teach/Lưu -->
                    <Border CornerRadius="8" Padding="12,8" Margin="0,10,0,0"
                            Background="{DynamicResource Info.BackgroundBrush}"
                            BorderBrush="{StaticResource Status.InfoBrush}" BorderThickness="1"
                            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource MiniButton}"
                                        BorderBrush="{StaticResource Status.InfoBrush}"
                                        Foreground="{StaticResource Status.InfoBrush}"
                                        Content="{Binding [Axis.GoToSel], Source={x:Static loc:Loc.Strings}}"
                                        Command="{Binding GoToSelectionCommand}"/>
                                <Button Style="{StaticResource MiniButton}"
                                        Content="{Binding [Axis.TeachSel], Source={x:Static loc:Loc.Strings}}"
                                        Command="{Binding TeachSelectionCommand}"/>
                                <Button Style="{StaticResource MiniButton}" Margin="0"
                                        BorderBrush="{StaticResource Status.NormalBrush}"
                                        Foreground="{StaticResource Status.NormalBrush}"
                                        Content="{Binding [Axis.SavePoints], Source={x:Static loc:Loc.Strings}}"
                                        Command="{Binding SavePointsCommand}"/>
                            </StackPanel>
                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Text.PrimaryBrush}">
                                <Run Text="{Binding [Axis.Selecting], Source={x:Static loc:Loc.Strings}, Mode=OneWay}"/>
                                <Run Text="{Binding SelectionScope, Mode=OneWay}" FontWeight="SemiBold"
                                     Foreground="{StaticResource Status.InfoBrush}"/>
                            </TextBlock>
                        </DockPanel>
                    </Border>

                    <TextBlock Text="{Binding [Axis.PointHint], Source={x:Static loc:Loc.Strings}}"
                               FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Text.PlaceholderBrush}"/>
                    <TextBlock Text="{Binding StatusMessage}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource Status.AlarmBrush}"/>
                </StackPanel>
            </Border>
            </ScrollViewer>

            <!-- ══ PANE 2: Giám sát I/O (nhúng IoMonitorView — gộp Motion/IO) ══ -->
            <Border Visibility="{Binding SubTabIndex, Converter={StaticResource IndexToVis}, ConverterParameter=2}">
                <iomon:IoMonitorView DataContext="{Binding IoMonitor}"/>
            </Border>

            <!-- ══ PANE 3: Thao tác trạm (RecoveryActions R1) — guard tầng 3 + audit ══ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding SubTabIndex, Converter={StaticResource IndexToVis}, ConverterParameter=3}">
                <StackPanel DataContext="{Binding StationOps}">
                    <!-- Empty-state khi máy chưa khai thao tác nào -->
                    <Border VerticalAlignment="Top">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasActions}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Margin="8,16" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="32"
                                       HorizontalAlignment="Center" Margin="0,0,0,10"
                                       Foreground="{DynamicResource Text.PlaceholderBrush}"/>
                            <TextBlock Text="{Binding [Manual.Station.Pending], Source={x:Static loc:Loc.Strings}}"
                                       MaxWidth="640" TextWrapping="Wrap" TextAlignment="Center" FontSize="13"
                                       Foreground="{DynamicResource Text.SecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Danh sách thao tác phục hồi (mờ + lý do khi bị guard chặn) -->
                    <ItemsControl ItemsSource="{Binding Actions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,3" Padding="12,10" HorizontalContentAlignment="Stretch"
                                        Command="{Binding DataContext.ExecuteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding IsEnabled}" Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding IconHex}" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0"
                                                   Foreground="{DynamicResource Text.PrimaryBrush}"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Text.PrimaryBrush}"/>
                                            <TextBlock Text="{Binding SubText}" FontSize="12"
                                                       Foreground="{DynamicResource Text.SecondaryBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SubText}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <Border Grid.Column="2" CornerRadius="3" Padding="7,2" VerticalAlignment="Center"
                                                Background="{DynamicResource Status.WarningBrush}">
                                            <TextBlock Text="{Binding RiskLabel}" FontSize="11" FontWeight="Bold"
                                                       Foreground="{DynamicResource Status.ForegroundBrush}"/>
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ══ PANE 4: Supervised Override — vượt guard, xác nhận 1 người (2 bước + đếm ngược) ══ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding SubTabIndex, Converter={StaticResource IndexToVis}, ConverterParameter=4}">
                <StackPanel DataContext="{Binding Override}">
                    <!-- Empty-state khi máy chưa khai override -->
                    <Border VerticalAlignment="Top">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasActions}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Margin="8,16" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="32"
                                       HorizontalAlignment="Center" Margin="0,0,0,10"
                                       Foreground="{StaticResource Status.AlarmBrush}"/>
                            <TextBlock Text="{Binding [Manual.Override.Pending], Source={x:Static loc:Loc.Strings}}"
                                       MaxWidth="640" TextWrapping="Wrap" TextAlignment="Center" FontSize="13"
                                       Foreground="{DynamicResource Text.SecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Danh sách override (LUÔN hiện; mờ + lý do khi chưa đủ quyền/máy chạy) -->
                    <ItemsControl ItemsSource="{Binding Actions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,3" Padding="12,10" HorizontalContentAlignment="Stretch"
                                        Command="{Binding DataContext.StartConfirmCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding IsEnabled}" Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding IconHex}" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0"
                                                   Foreground="{DynamicResource Status.AlarmBrush}"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Text.PrimaryBrush}"/>
                                            <TextBlock Text="{Binding SubText}" FontSize="12"
                                                       Foreground="{DynamicResource Text.SecondaryBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SubText}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <Border Grid.Column="2" CornerRadius="3" Padding="7,2" VerticalAlignment="Center"
                                                Background="{DynamicResource Status.AlarmBrush}">
                                            <TextBlock Text="OVERRIDE" FontSize="10" FontWeight="Bold"
                                                       Foreground="{DynamicResource Status.ForegroundBrush}"/>
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Card xác nhận 1 người: cảnh báo + lý do (bắt buộc) + đếm ngược -->
                    <Border CornerRadius="6" Padding="16" Margin="0,10,0,0" BorderThickness="2"
                            BorderBrush="{DynamicResource Status.AlarmBrush}" Background="#1FC0392B"
                            Visibility="{Binding IsConfirming, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding WarningText}" TextWrapping="Wrap" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Status.AlarmBrush}" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding [Override.Reason], Source={x:Static loc:Loc.Strings}}"
                                       FontSize="12" Foreground="{DynamicResource Text.SecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding ReasonText, UpdateSourceTrigger=PropertyChanged}"
                                     MinHeight="48" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,12"
                                     VerticalContentAlignment="Top"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="{Binding [Override.Cancel], Source={x:Static loc:Loc.Strings}}"
                                        Command="{Binding CancelCommand}" Padding="16,6" Margin="0,0,10,0" Cursor="Hand"/>
                                <Button Content="{Binding ConfirmLabel}" Command="{Binding ConfirmCommand}"
                                        IsEnabled="{Binding CanConfirm}" Padding="16,6" Cursor="Hand"
                                        Background="{DynamicResource Status.AlarmBrush}"
                                        Foreground="{DynamicResource Status.ForegroundBrush}" BorderThickness="0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ══ PANE 5: Hiệu chỉnh routine (wizard 2 nhánh — HMI_Calibration_Model_v1.0) ══ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding SubTabIndex, Converter={StaticResource IndexToVis}, ConverterParameter=5}">
                <calib:CalibrationPanelView DataContext="{Binding Calibration}"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
