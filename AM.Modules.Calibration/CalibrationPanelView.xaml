<UserControl x:Class="AM.Modules.Calibration.CalibrationPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:AM.UI.Localization;assembly=AM.UI.Localization"
             mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <!-- Máy không có routine loại này — thông điệp thay vì trống trơn -->
        <TextBlock Text="{Binding [Calib.Empty], Source={x:Static loc:Loc.Strings}}"
                   Foreground="{DynamicResource Text.SecondaryBrush}" FontSize="14" Margin="4,8">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasRoutines}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Grid Visibility="{Binding HasRoutines, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Trái: danh sách routine ─────────────────────────────────────── -->
            <Border Grid.Column="0" CornerRadius="8" Padding="12" VerticalAlignment="Top"
                    Background="{DynamicResource Panel.BackgroundBrush}"
                    BorderBrush="{DynamicResource Border.DefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding [Calib.ListTitle], Source={x:Static loc:Loc.Strings}}"
                               FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"
                               Foreground="{DynamicResource Text.HeadingBrush}"/>
                    <ListBox ItemsSource="{Binding Routines}" SelectedItem="{Binding SelectedRoutine}"
                             BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,8">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text.PrimaryBrush}"/>
                                    <TextBlock Text="{Binding Meta}" FontSize="12" Margin="0,2,0,0"
                                               Foreground="{DynamicResource Text.SecondaryBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- ── Phải: wizard card ───────────────────────────────────────────── -->
            <StackPanel Grid.Column="2">
                <TextBlock Text="{Binding [Calib.SelectPrompt], Source={x:Static loc:Loc.Strings}}"
                           Foreground="{DynamicResource Text.SecondaryBrush}" FontSize="14" Margin="4,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelection}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Border CornerRadius="8" Padding="16"
                        Background="{DynamicResource Panel.BackgroundBrush}"
                        BorderBrush="{DynamicResource Border.DefaultBrush}" BorderThickness="1"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <!-- Trạng thái + ngưỡng -->
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="13"
                                       Foreground="{DynamicResource Text.SecondaryBrush}">
                                <Run Text="{Binding [Calib.Threshold], Source={x:Static loc:Loc.Strings}}"/>
                                <Run Text="{Binding ThresholdText, Mode=OneWay}" FontWeight="SemiBold"/>
                            </TextBlock>
                            <TextBlock Text="{Binding StateText}" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource Text.HeadingBrush}"/>
                        </DockPanel>

                        <!-- Thông điệp chặn quyền -->
                        <TextBlock Text="{Binding RoleGateText}" FontSize="13" Margin="0,0,0,8"
                                   Foreground="{DynamicResource Warn.TextBrush}" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RoleGateText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Kết quả đo -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="{Binding [Calib.LastResult], Source={x:Static loc:Loc.Strings}}"
                                       FontSize="13" VerticalAlignment="Bottom" Margin="0,0,10,3"
                                       Foreground="{DynamicResource Text.SecondaryBrush}"/>
                            <TextBlock Text="{Binding OffsetText}" FontSize="30" FontWeight="Bold"
                                       Foreground="{DynamicResource Text.PrimaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding DetailText}" FontSize="13" Margin="0,0,0,12"
                                   Foreground="{DynamicResource Text.SecondaryBrush}"/>

                        <!-- Hướng dẫn chỉnh tay (nhánh vượt ngưỡng) -->
                        <Border CornerRadius="6" Padding="12" Margin="0,0,0,12"
                                Background="{StaticResource Warn.BackgroundBrush}"
                                Visibility="{Binding ShowGuide, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding [Calib.Guide], Source={x:Static loc:Loc.Strings}}"
                                           FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"
                                           Foreground="{DynamicResource Text.PrimaryBrush}"/>
                                <ItemsControl ItemsSource="{Binding GuideSteps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="13" Margin="0,2"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource Text.PrimaryBrush}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Nút hành động (≥44px cảm ứng) -->
                        <StackPanel Orientation="Horizontal">
                            <Button Height="44" MinWidth="120" Padding="18,0" FontSize="14" FontWeight="SemiBold"
                                    Cursor="Hand" Command="{Binding MeasureCommand}"
                                    IsEnabled="{Binding CanMeasure}"
                                    Content="{Binding [Calib.Measure], Source={x:Static loc:Loc.Strings}}"/>
                            <Button Height="44" MinWidth="120" Padding="18,0" Margin="10,0,0,0"
                                    FontSize="14" FontWeight="SemiBold" Cursor="Hand"
                                    Command="{Binding ApplyCommand}" IsEnabled="{Binding CanApply}"
                                    Content="{Binding [Calib.Apply], Source={x:Static loc:Loc.Strings}}"/>
                            <Button Height="44" MinWidth="100" Padding="18,0" Margin="10,0,0,0"
                                    FontSize="14" Cursor="Hand" Command="{Binding ResetWizardCommand}"
                                    Content="{Binding [Calib.Reset], Source={x:Static loc:Loc.Strings}}"/>
                        </StackPanel>

                        <!-- Lịch sử -->
                        <TextBlock Text="{Binding [Calib.History], Source={x:Static loc:Loc.Strings}}"
                                   FontSize="13" FontWeight="SemiBold" Margin="0,16,0,4"
                                   Foreground="{DynamicResource Text.HeadingBrush}"/>
                        <ItemsControl ItemsSource="{Binding History}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="12" Margin="0,2"
                                               FontFamily="Consolas"
                                               Foreground="{DynamicResource Text.SecondaryBrush}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
