<Window x:Class="AM.Application.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:AM.UI.Localization;assembly=AM.UI.Localization"
        xmlns:conv="clr-namespace:AM.Application.Shell.Converters"
        mc:Ignorable="d"
        Title="AutoMachine Framework"
        Height="900" Width="1440" MinHeight="640" MinWidth="1024"
        WindowState="Maximized" WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize" SizeToContent="Manual"
        FontSize="15"
        Background="{DynamicResource Screen.BackgroundBrush}">

    <!--
    Shell v3 — 4 vùng Persistent Frame (gộp từ 7 vùng v2, tối ưu 1920×1080; ADR 0009):
    1 Header+Nav gộp 56  (logo · chip AUTO/LOCAL/state · tab điều hướng · recipe · clock+heartbeat · ngôn ngữ · user)
    2 Alarm banner co giãn: 36 khi sạch → 52 khi có alarm chưa ACK (nút ACK vẫn ≥40px — spec §1.8)
    3 Content *
    4 Action bar 76 gộp connection: nút lệnh máy 64px (Master Index §2.9 — lệnh chính ≥64) nằm ngang trái
      · Dry run/Manual 48px · chip "Thiết bị n/m · Host n/m" + popup chi tiết phải
    Ngân sách chrome: 56+36+76 = 168px → nội dung ~912px (~84%) ở 1080p (v2 là 284px chrome).

    Kiosk KHÔNG hardcode: bật qua appsettings AutoMachine:KioskMode (IPC sản xuất);
    Ctrl+Shift+F11 (Engineer+) vào/thoát kiosk lúc chạy — xem MainWindow.xaml.cs.
    Lệnh máy KHÔNG ở nửa trên màn hình (SEMI E95 — vùng điều khiển cố định ở đáy).
    -->

    <Window.Resources>
        <conv:MachineStateToBrushConverter x:Key="StateBrush"/>
        <conv:ConnectionToBrushConverter x:Key="ConnBrush"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Chip trạng thái header (26px — viền + chữ màu trạng thái trên nền trắng, yên tĩnh) -->
        <Style x:Key="StateChip" TargetType="Border">
            <Setter Property="Height" Value="26"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="{DynamicResource Panel.BackgroundAltBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Nút header (recipe / user) — 44px (adoption v2: min touch trong header 56px) -->
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="{DynamicResource Panel.BackgroundAltBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.DefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.PrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource Panel.BackgroundHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab điều hướng — RadioButton cao hết header (56px), gạch chân 3px khi chọn.
             Code-behind tạo tab từ [ModuleNavigation]: FindResource("NavTabButton") —
             GroupName trong style cho hành vi loại trừ lẫn nhau. KHÔNG set Foreground
             trên nội dung tab (icon/label kế thừa từ trigger của template). -->
        <Style x:Key="NavTabButton" TargetType="RadioButton">
            <Setter Property="GroupName" Value="NavTabs"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.SecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <ContentPresenter x:Name="Cp" HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                            <Rectangle x:Name="Indicator" Height="3" VerticalAlignment="Bottom"
                                       Fill="{DynamicResource Status.InfoBrush}" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text.HeadingBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Text.PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút action bar v3 — nằm ngang (icon trái + nhãn phải), mờ khi khoá.
             48px cho nút phụ (Dry run/Manual); lệnh máy dùng MachineActionButton 64px. -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="MinWidth" Value="108"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="{DynamicResource Panel.BackgroundAltBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.DefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.PrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource Panel.BackgroundHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Lệnh máy (Init/Start/Pause/Stop/Reset) — 64px theo Master Index §2.9: lệnh chính ≥64px -->
        <Style x:Key="MachineActionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Height" Value="64"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Padding" Value="20,0"/>
        </Style>

        <!-- Icon MDL2 nằm ngang trong nút action -->
        <Style x:Key="ActionIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,9,0"/>
        </Style>
        <Style x:Key="ActionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Chip kết nối (ToggleButton mở popup chi tiết) — 44px touch -->
        <Style x:Key="ConnChip" TargetType="ToggleButton">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="{DynamicResource Panel.BackgroundAltBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.DefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource Panel.BackgroundHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{DynamicResource Status.InfoBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Một dòng kết nối trong popup — dùng chung cho Thiết bị và Host -->
        <DataTemplate x:Key="ConnItemTemplate">
            <StackPanel Orientation="Horizontal" Margin="0,3" VerticalAlignment="Center">
                <TextBlock FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="✕"/>
                            <Setter Property="Foreground" Value="{StaticResource Status.AlarmBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Connected}" Value="True">
                                    <Setter Property="Text" Value="●"/>
                                    <Setter Property="Foreground" Value="{StaticResource Status.NormalBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Name}" FontSize="14" VerticalAlignment="Center"
                           Foreground="{DynamicResource Text.SecondaryBrush}"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>   <!-- 1 Header + Nav gộp -->
            <RowDefinition Height="Auto"/> <!-- 2 Alarm banner co giãn 36→52 -->
            <RowDefinition Height="*"/>    <!-- 3 Content -->
            <RowDefinition Height="76"/>   <!-- 4 Action bar + connection -->
        </Grid.RowDefinitions>

        <!-- ═══ 1 HEADER + NAV — một hàng 56px ═══════════════════════════════════ -->
        <Border Grid.Row="0" Background="{DynamicResource Header.BackgroundBrush}"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Border.DefaultBrush}">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Logo + chip trạng thái -->
                    <ColumnDefinition Width="*"/>    <!-- Tab điều hướng -->
                    <ColumnDefinition Width="Auto"/> <!-- Recipe · clock · ngôn ngữ · user -->
                </Grid.ColumnDefinitions>

                <!-- Trái: logo + chip AUTO/DRY · LOCAL · state (nhận diện máy trong 1 lượt nhìn) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="8"
                            Background="{DynamicResource Info.BackgroundBrush}"
                            ToolTip="{StaticResource Shell.Title}">
                        <TextBlock Text="AM" FontWeight="SemiBold" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Status.InfoBrush}"/>
                    </Border>

                    <!-- Chip chế độ AUTO/DRY -->
                    <Border Style="{StaticResource StateChip}" Margin="14,0,0,0"
                            BorderBrush="{StaticResource Status.InfoBrush}">
                        <TextBlock Text="{Binding ModeText}" FontWeight="Bold" FontSize="13"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Status.InfoBrush}"/>
                    </Border>

                    <!-- Chip LOCAL (GEM control state — REMOTE khi có SECS/GEM, TODO) -->
                    <Border Style="{StaticResource StateChip}" Margin="6,0,0,0"
                            BorderBrush="{DynamicResource Border.DefaultBrush}"
                            ToolTip="{Binding [Shell.LocalTip], Source={x:Static loc:Loc.Strings}}">
                        <TextBlock Text="{Binding [Shell.Local], Source={x:Static loc:Loc.Strings}}"
                                   FontWeight="Bold" FontSize="13" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Text.SecondaryBrush}"/>
                    </Border>

                    <!-- Chip trạng thái máy (ISA-88) -->
                    <Border Style="{StaticResource StateChip}" Margin="6,0,0,0"
                            BorderBrush="{Binding MachineState, Converter={StaticResource StateBrush}}">
                        <TextBlock Text="{Binding StateText}" FontWeight="Bold" FontSize="13"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding MachineState, Converter={StaticResource StateBrush}}"/>
                    </Border>
                </StackPanel>

                <!-- Giữa: tab tự sinh từ [ModuleNavigation] — style NavTabButton (RadioButton).
                     ScrollViewer + panning đề phòng thêm module hoặc màn 1366×768 không đủ ngang. -->
                <ScrollViewer Grid.Column="1" Margin="18,0,0,0" PanningMode="HorizontalOnly"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="NavPanel" Orientation="Horizontal"/>
                </ScrollViewer>

                <!-- Phải: recipe + clock + heartbeat + ngôn ngữ + user -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource HeaderButton}" Click="RecipeButton_Click"
                            ToolTip="{Binding [Shell.RecipeTip], Source={x:Static loc:Loc.Strings}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding [Param.Recipe], Source={x:Static loc:Loc.Strings}}"
                                       Foreground="{DynamicResource Text.SecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text=" " VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding RecipeText}" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Text.PrimaryBrush}"/>
                        </StackPanel>
                    </Button>

                    <!-- Clock MinWidth cố định để giây nhảy không làm xô layout -->
                    <StackPanel Orientation="Horizontal" Margin="14,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ClockText}" FontSize="14" MinWidth="126"
                                   TextAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Text.SecondaryBrush}"/>
                        <!-- Heartbeat 1Hz — ngừng nháy = UI treo (template v3 §3.1) -->
                        <Ellipse Width="9" Height="9" Margin="7,0,0,0" VerticalAlignment="Center"
                                 Fill="{StaticResource Status.NormalBrush}"
                                 ToolTip="{Binding [Shell.HeartbeatTip], Source={x:Static loc:Loc.Strings}}">
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="1" To="0.15" AutoReverse="True"
                                                             Duration="0:0:0.5"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                    </StackPanel>

                    <!-- Ngôn ngữ: glyph địa cầu + combo (đổi runtime) -->
                    <Border Height="44" CornerRadius="8" Padding="10,0" Margin="0,0,10,0"
                            Background="{DynamicResource Panel.BackgroundAltBrush}"
                            BorderBrush="{DynamicResource Border.DefaultBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{DynamicResource Text.SecondaryBrush}"/>
                            <ComboBox x:Name="LanguageCombo" Width="88" Height="28" VerticalAlignment="Center"
                                      BorderThickness="0" Background="Transparent"
                                      SelectionChanged="LanguageCombo_SelectionChanged"
                                      ToolTip="{Binding [Common.Language], Source={x:Static loc:Loc.Strings}}"/>
                        </StackPanel>
                    </Border>

                    <!-- User (góc ngoài cùng phải — quy ước danh tính phiên) -->
                    <Button Style="{StaticResource HeaderButton}" Click="UserButton_Click"
                            ToolTip="{Binding [Shell.UserTip], Source={x:Static loc:Loc.Strings}}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="28" Height="28" CornerRadius="14"
                                    Background="{DynamicResource Info.BackgroundBrush}">
                                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Status.InfoBrush}"/>
                            </Border>
                            <TextBlock Text="{Binding UserText}" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Text.PrimaryBrush}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ 2 ALARM BANNER — co giãn: 36 sạch → 52 khi có alarm (ACK vẫn 40px) ═
             EEMUA 201: chỉ hiện 1 alarm ưu tiên cao nhất chưa ACK + chip "+N khác". -->
        <Border Grid.Row="1" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Border.DefaultBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Height" Value="36"/>
                    <Setter Property="Background" Value="{DynamicResource Notice.OkBrush}"/>
                    <Style.Triggers>
                        <!-- Cảnh báo mật khẩu mặc định (0012) — đặt ĐẦU: trạng thái khẩn hơn phía dưới đè lên -->
                        <DataTrigger Binding="{Binding HasSecurityNotice}" Value="True">
                            <Setter Property="Background" Value="{StaticResource Warn.BackgroundBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HasUnackedAlarm}" Value="True">
                            <Setter Property="Height" Value="52"/>
                            <Setter Property="Background" Value="{StaticResource Warn.BackgroundBrush}"/>
                        </DataTrigger>
                        <!-- Operator prompt từ sequence engine — cùng cấp khẩn với alarm chưa ACK -->
                        <DataTrigger Binding="{Binding HasOperatorPrompt}" Value="True">
                            <Setter Property="Height" Value="52"/>
                            <Setter Property="Background" Value="{StaticResource Warn.BackgroundBrush}"/>
                        </DataTrigger>
                        <!-- Service prompt (station hỏi lúc init — P1.6) -->
                        <DataTrigger Binding="{Binding HasServicePrompt}" Value="True">
                            <Setter Property="Height" Value="52"/>
                            <Setter Property="Background" Value="{StaticResource Warn.BackgroundBrush}"/>
                        </DataTrigger>
                        <!-- Gate từng-bước (P4.1) — banner cao 52 để chứa nút "Bước tiếp" -->
                        <DataTrigger Binding="{Binding HasStepGate}" Value="True">
                            <Setter Property="Height" Value="52"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsBannerError}" Value="True">
                            <Setter Property="Height" Value="52"/>
                            <Setter Property="Background" Value="{StaticResource Ng.BackgroundBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel Margin="20,0">
                <!-- Glyph trạng thái: ✓ sạch / ⚠ có alarm -->
                <TextBlock VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold" FontSize="15">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="✓"/>
                            <Setter Property="Foreground" Value="{StaticResource Status.NormalBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSecurityNotice}" Value="True">
                                    <Setter Property="Text" Value="⚠"/>
                                    <Setter Property="Foreground" Value="{StaticResource Warn.TextBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasUnackedAlarm}" Value="True">
                                    <Setter Property="Text" Value="⚠"/>
                                    <Setter Property="Foreground" Value="{StaticResource Warn.TextBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasOperatorPrompt}" Value="True">
                                    <Setter Property="Text" Value="⚠"/>
                                    <Setter Property="Foreground" Value="{StaticResource Warn.TextBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasServicePrompt}" Value="True">
                                    <Setter Property="Text" Value="⚠"/>
                                    <Setter Property="Foreground" Value="{StaticResource Warn.TextBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsBannerError}" Value="True">
                                    <Setter Property="Text" Value="⚠"/>
                                    <Setter Property="Foreground" Value="{StaticResource Status.AlarmBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Nút ACK (≥40px — spec §1.8) — chỉ hiện khi có alarm, banner lúc đó cao 52 -->
                <Button DockPanel.Dock="Right" VerticalAlignment="Center" Height="40" Padding="22,0"
                        Margin="12,0,0,0" FontWeight="Bold" FontSize="14" Cursor="Hand"
                        Content="{Binding [Alarm.Ack], Source={x:Static loc:Loc.Strings}}"
                        Command="{Binding AcknowledgeAlarmCommand}"
                        Visibility="{Binding HasUnackedAlarm, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource Panel.BackgroundAltBrush}"
                        BorderBrush="{StaticResource Warn.TextBrush}" BorderThickness="1"
                        Foreground="{StaticResource Warn.TextBrush}"/>

                <!-- Nút "Bước tiếp" — engine đứng ở gate từng-bước (P4.1) -->
                <Button DockPanel.Dock="Right" VerticalAlignment="Center" Height="40" Padding="22,0"
                        Margin="12,0,0,0" FontWeight="Bold" FontSize="14" Cursor="Hand"
                        Content="{Binding [Shell.StepNext], Source={x:Static loc:Loc.Strings}}"
                        Command="{Binding StepNextCommand}"
                        Visibility="{Binding HasStepGate, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource Panel.BackgroundAltBrush}"
                        BorderBrush="{StaticResource Status.InfoBrush}" BorderThickness="1"
                        Foreground="{StaticResource Status.InfoBrush}"/>

                <!-- Nút trả lời operator prompt (sequence engine): Thử lại · Bỏ qua (Engineer+) · Dừng máy.
                     Engine chờ Respond — không popup chặn thread (ADR 0011 §4.3). -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="12,0,0,0"
                            Visibility="{Binding HasOperatorPrompt, Converter={StaticResource BoolToVis}}">
                    <Button Height="40" Padding="18,0" FontWeight="Bold" FontSize="14" Cursor="Hand"
                            Content="{Binding [Shell.PromptRetry], Source={x:Static loc:Loc.Strings}}"
                            Command="{Binding PromptRetryCommand}"
                            Background="{DynamicResource Panel.BackgroundAltBrush}"
                            BorderBrush="{StaticResource Status.NormalBrush}" BorderThickness="1"
                            Foreground="{StaticResource Status.NormalBrush}"/>
                    <Button Height="40" Padding="18,0" FontSize="14" Cursor="Hand" Margin="8,0,0,0"
                            Content="{Binding [Shell.PromptSkip], Source={x:Static loc:Loc.Strings}}"
                            Command="{Binding PromptSkipCommand}"
                            Visibility="{Binding PromptCanSkip, Converter={StaticResource BoolToVis}}"
                            Background="{DynamicResource Panel.BackgroundAltBrush}"
                            BorderBrush="{DynamicResource Border.DefaultBrush}" BorderThickness="1"
                            Foreground="{DynamicResource Text.PrimaryBrush}"/>
                    <Button Height="40" Padding="18,0" FontWeight="Bold" FontSize="14" Cursor="Hand"
                            Margin="8,0,0,0"
                            Content="{Binding [Shell.PromptAbort], Source={x:Static loc:Loc.Strings}}"
                            Command="{Binding PromptAbortCommand}"
                            Background="{DynamicResource Panel.BackgroundAltBrush}"
                            BorderBrush="{StaticResource Status.AlarmBrush}" BorderThickness="1"
                            Foreground="{StaticResource Status.AlarmBrush}"/>
                </StackPanel>

                <!-- Chip "+N cảnh báo khác" -->
                <Border DockPanel.Dock="Right" VerticalAlignment="Center" CornerRadius="13"
                        Padding="12,3" Background="{DynamicResource Panel.BackgroundAltBrush}"
                        BorderBrush="{DynamicResource Border.DefaultBrush}" BorderThickness="1"
                        Visibility="{Binding HasExtraAlarms, Converter={StaticResource BoolToVis}}">
                    <TextBlock FontSize="13" Foreground="{DynamicResource Text.SecondaryBrush}">
                        <Run Text="+"/><Run Text="{Binding ExtraAlarmCount, Mode=OneWay}"/>
                        <Run Text="{Binding [Shell.MoreAlarms], Source={x:Static loc:Loc.Strings}, Mode=OneWay}"/>
                    </TextBlock>
                </Border>

                <!-- Ghi chú điều hướng chỉ hiện khi banner sạch — khi có alarm nhường chỗ cho nội dung alarm -->
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="13"
                           Margin="12,0,0,0"
                           Foreground="{DynamicResource Text.PlaceholderBrush}"
                           Text="{Binding [Shell.AlarmNote], Source={x:Static loc:Loc.Strings}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasUnackedAlarm}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasOperatorPrompt}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasServicePrompt}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Nút động của service prompt (station hỏi — vd liệu sót: Máy tự thoát / Đã lấy tay) -->
                <ItemsControl DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0"
                              ItemsSource="{Binding ServicePromptChoices}"
                              Visibility="{Binding HasServicePrompt, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Height="40" Padding="16,0" Margin="0,0,8,0" FontSize="14"
                                    FontWeight="Bold" Cursor="Hand"
                                    Content="{Binding}"
                                    Command="{Binding DataContext.RespondServicePromptCommand,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Background="{DynamicResource Panel.BackgroundAltBrush}"
                                    BorderBrush="{StaticResource Warn.TextBrush}" BorderThickness="1"
                                    Foreground="{StaticResource Warn.TextBrush}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Nội dung service prompt -->
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource Warn.TextBrush}"
                           Visibility="{Binding HasServicePrompt, Converter={StaticResource BoolToVis}}">
                    <Run Text="{Binding [Shell.PromptPrefix], Source={x:Static loc:Loc.Strings}, Mode=OneWay}"/>
                    <Run Text=" — "/><Run Text="{Binding ServicePromptText, Mode=OneWay}"/>
                </TextBlock>

                <!-- Nội dung operator prompt — chiếm chỗ BannerText khi engine chờ quyết định -->
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource Warn.TextBrush}"
                           Visibility="{Binding HasOperatorPrompt, Converter={StaticResource BoolToVis}}">
                    <Run Text="{Binding [Shell.PromptPrefix], Source={x:Static loc:Loc.Strings}, Mode=OneWay}"/>
                    <Run Text=" — "/><Run Text="{Binding PromptText, Mode=OneWay}"/>
                </TextBlock>

                <TextBlock Text="{Binding BannerText}" VerticalAlignment="Center" FontWeight="SemiBold"
                           FontSize="14" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Text.SecondaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasUnackedAlarm}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Warn.TextBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsBannerError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Status.AlarmBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasOperatorPrompt}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasServicePrompt}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- ═══ 3 CONTENT (Home tự chia work area + right rail) ══════════════════ -->
        <Border Grid.Row="2" Background="{DynamicResource Screen.BackgroundBrush}">
            <ContentControl x:Name="MainContent" Margin="8,0"/>
        </Border>

        <!-- ═══ LOGIN OVERLAY — chỉ phủ vùng content (SEMI E95: không che alarm/nav/action) ═══ -->
        <Border x:Name="LoginOverlay" Grid.Row="2" Visibility="Collapsed"
                Background="#66000000" MouseLeftButtonDown="LoginBackdrop_MouseDown">
            <Border Width="400" CornerRadius="10" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource Panel.BackgroundBrush}"
                    BorderBrush="{DynamicResource Border.DefaultBrush}" BorderThickness="1"
                    MouseLeftButtonDown="LoginCard_MouseDown">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Background="{DynamicResource Header.BackgroundBrush}">
                        <TextBlock Text="{Binding [Id.Login], Source={x:Static loc:Loc.Strings}}"
                                   Margin="18,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text.PrimaryBrush}"/>
                        <Button HorizontalAlignment="Right" Width="44" Height="40" Content="✕"
                                FontSize="14" Cursor="Hand" Click="CloseLogin_Click"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource Text.SecondaryBrush}"/>
                    </Grid>
                    <ContentControl x:Name="LoginHost"/>
                </DockPanel>
            </Border>
        </Border>

        <!-- ═══ 4 ACTION BAR 76px — lệnh máy 64px trái · Dry run/Manual 48px · chip kết nối phải ═══ -->
        <Border Grid.Row="3" Background="{DynamicResource Header.BackgroundBrush}"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Border.DefaultBrush}">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Init (ISA-88: Uninitialized → Initializing; PackML không có — adoption §9) -->
                    <Button Style="{StaticResource MachineActionButton}" Margin="0,0,10,0"
                            Command="{Binding InitializeCommand}"
                            ToolTip="{Binding [Shell.InitTip], Source={x:Static loc:Loc.Strings}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ActionIcon}" Text="&#xE7E8;"/>
                            <TextBlock Style="{StaticResource ActionLabel}"
                                       Text="{Binding [Dash.Btn.Init], Source={x:Static loc:Loc.Strings}}"/>
                        </StackPanel>
                    </Button>

                    <!-- Start — nút duy nhất có viền nhấn -->
                    <Button Style="{StaticResource MachineActionButton}" Margin="0,0,10,0"
                            BorderBrush="{StaticResource Status.NormalBrush}"
                            Foreground="{StaticResource Status.NormalBrush}" FontWeight="Bold"
                            Command="{Binding StartCommand}"
                            ToolTip="{Binding [Shell.StartTip], Source={x:Static loc:Loc.Strings}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ActionIcon}" Text="&#xE768;"/>
                            <TextBlock Style="{StaticResource ActionLabel}" FontWeight="Bold"
                                       Text="{Binding [Dash.Btn.Start], Source={x:Static loc:Loc.Strings}}"/>
                        </StackPanel>
                    </Button>

                    <!-- Pause/Resume — một nút, nhãn tự đổi -->
                    <Button Style="{StaticResource MachineActionButton}" Margin="0,0,10,0"
                            Command="{Binding PauseResumeCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ActionIcon}" Text="&#xE769;"/>
                            <TextBlock Style="{StaticResource ActionLabel}" Text="{Binding PauseResumeText}"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MachineActionButton}" Margin="0,0,10,0"
                            Command="{Binding StopCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ActionIcon}" Text="&#xE71A;"/>
                            <TextBlock Style="{StaticResource ActionLabel}"
                                       Text="{Binding [Dash.Btn.Stop], Source={x:Static loc:Loc.Strings}}"/>
                        </StackPanel>
                    </Button>

                    <!-- Reset tách khỏi cụm vận hành (divider) — đứng sát Dừng dễ bấm nhầm lúc vội;
                         enable đã guard theo state machine (chỉ InitAlarm/RunAlarm — CanReset) -->
                    <Border Width="1" Height="32" Background="{DynamicResource Border.DefaultBrush}"
                            Margin="6,0,16,0"/>

                    <Button Style="{StaticResource MachineActionButton}"
                            Command="{Binding ResetCommand}"
                            ToolTip="{Binding [Shell.ResetTip], Source={x:Static loc:Loc.Strings}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ActionIcon}" Text="&#xE72C;"/>
                            <TextBlock Style="{StaticResource ActionLabel}"
                                       Text="{Binding [Dash.Btn.Reset], Source={x:Static loc:Loc.Strings}}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ActionButton}" Margin="0,0,10,0"
                            Command="{Binding ToggleDryRunCommand}"
                            ToolTip="{Binding [Shell.DryRunTip], Source={x:Static loc:Loc.Strings}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ActionIcon}" Text="&#xE72A;"/>
                            <TextBlock Style="{StaticResource ActionLabel}"
                                       Text="{Binding [Shell.DryRun], Source={x:Static loc:Loc.Strings}}"/>
                        </StackPanel>
                    </Button>
                    <!-- Từng bước (P4.1, Engineer+): engine dừng ở ranh giới sau mỗi nhóm bước; ● = đang bật -->
                    <Button Style="{StaticResource ActionButton}" Margin="0,0,10,0"
                            Command="{Binding ToggleSingleStepCommand}"
                            IsEnabled="{Binding CanToggleSingleStep}"
                            ToolTip="{Binding [Shell.SingleStepTip], Source={x:Static loc:Loc.Strings}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ActionIcon}" Text="&#xE76C;"/>
                            <TextBlock Style="{StaticResource ActionLabel}"
                                       Text="{Binding [Shell.SingleStep], Source={x:Static loc:Loc.Strings}}"/>
                            <TextBlock Style="{StaticResource ActionLabel}" Text=" ●"
                                       Foreground="{StaticResource Status.InfoBrush}"
                                       Visibility="{Binding IsSingleStep, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Button>
                    <!-- Manual → màn Vận hành tay (tab MotionView, S48). Thiếu quyền: mờ + tooltip lý do (P1.2) -->
                    <Button Style="{StaticResource ActionButton}" Margin="0,0,16,0"
                            IsEnabled="{Binding CanOpenManual}" Click="ManualButton_Click"
                            ToolTip="{Binding [Shell.ManualTip], Source={x:Static loc:Loc.Strings}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ActionIcon}" Text="&#xE7C9;"/>
                            <TextBlock Style="{StaticResource ActionLabel}"
                                       Text="{Binding [Shell.Manual], Source={x:Static loc:Loc.Strings}}"/>
                        </StackPanel>
                    </Button>

                    <Border Width="1" Height="28" Background="{DynamicResource Border.DefaultBrush}"
                            Margin="0,0,16,0"/>

                    <!-- Chip kết nối tổng hợp — thay connection bar 40px cũ (v2).
                         VM: DeviceOnlineText "14/15", HostOnlineText "2/2", AllConnectionsOk. -->
                    <ToggleButton x:Name="ConnChipButton" Style="{StaticResource ConnChip}"
                                  Checked="ConnChip_Checked"
                                  ToolTip="{Binding [Shell.ConnLegend], Source={x:Static loc:Loc.Strings}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="✕"/>
                                        <Setter Property="Foreground" Value="{StaticResource Status.AlarmBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AllConnectionsOk}" Value="True">
                                                <Setter Property="Text" Value="●"/>
                                                <Setter Property="Foreground" Value="{StaticResource Status.NormalBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock FontSize="14" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Text.PrimaryBrush}">
                                <Run Text="{Binding [Shell.Devices], Source={x:Static loc:Loc.Strings}, Mode=OneWay}"/>
                                <Run Text="{Binding DeviceOnlineText, Mode=OneWay}" FontWeight="SemiBold"/>
                                <Run Text=" · "/>
                                <Run Text="{Binding [Shell.Hosts], Source={x:Static loc:Loc.Strings}, Mode=OneWay}"/>
                                <Run Text="{Binding HostOnlineText, Mode=OneWay}" FontWeight="SemiBold"/>
                            </TextBlock>
                        </StackPanel>
                    </ToggleButton>

                    <!-- Popup chi tiết kết nối — mở phía trên chip, tự đóng khi bấm ra ngoài.
                         Guard chống double-toggle (đóng rồi mở lại ngay) xử lý ở code-behind. -->
                    <Popup x:Name="ConnPopup"
                           PlacementTarget="{Binding ElementName=ConnChipButton}" Placement="Top"
                           IsOpen="{Binding IsChecked, ElementName=ConnChipButton, Mode=TwoWay}"
                           StaysOpen="False" AllowsTransparency="True" VerticalOffset="-8">
                        <Border CornerRadius="10" Padding="18,14" MinWidth="420"
                                Background="{DynamicResource Panel.BackgroundBrush}"
                                BorderBrush="{DynamicResource Border.DefaultBrush}" BorderThickness="1">
                            <StackPanel>
                                <ScrollViewer MaxHeight="460" VerticalScrollBarVisibility="Auto">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding [Shell.Devices], Source={x:Static loc:Loc.Strings}}"
                                                       FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"
                                                       Foreground="{DynamicResource Text.PrimaryBrush}"/>
                                            <ItemsControl ItemsSource="{Binding DeviceConnections}"
                                                          ItemTemplate="{StaticResource ConnItemTemplate}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding [Shell.Hosts], Source={x:Static loc:Loc.Strings}}"
                                                       FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"
                                                       Foreground="{DynamicResource Text.PrimaryBrush}"/>
                                            <ItemsControl ItemsSource="{Binding HostConnections}"
                                                          ItemTemplate="{StaticResource ConnItemTemplate}"/>
                                        </StackPanel>
                                    </Grid>
                                </ScrollViewer>
                                <Border Height="1" Background="{DynamicResource Border.DefaultBrush}" Margin="0,12,0,8"/>
                                <TextBlock Text="{Binding VersionText}" FontSize="13"
                                           Foreground="{DynamicResource Text.PlaceholderBrush}"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
