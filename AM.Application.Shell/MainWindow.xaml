<Window x:Class="AM.Application.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="AutoMachine Framework" Height="600" Width="1024"
        Background="{DynamicResource Screen.BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>   <!-- Header / Title bar -->
            <RowDefinition Height="*"/>    <!-- Main content / Prism region -->
            <RowDefinition Height="28"/>   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource Panel.BackgroundBrush}">
            <TextBlock Text="{StaticResource Shell.Title}"
                       Foreground="{DynamicResource Text.HeadingBrush}"
                       FontWeight="Bold" FontSize="14"
                       VerticalAlignment="Center" Margin="12,0"/>
        </Border>

        <!-- Main area: side-nav + content (module nạp từ DI khi Loaded) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="NavPanel" Grid.Column="0" Width="150"
                        Background="{DynamicResource Panel.BackgroundBrush}">
                <ComboBox x:Name="LanguageCombo" Margin="8,8,8,12"
                          SelectionChanged="LanguageCombo_SelectionChanged"
                          ToolTip="{Binding [Common.Language]}"/>
                <Button x:Name="NavDashboard" Content="{Binding [Nav.Dashboard]}" Click="NavDashboard_Click"
                        Height="44" FontSize="13" HorizontalContentAlignment="Left" Padding="14,0"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource Text.PrimaryBrush}"/>
                <Button x:Name="NavAlarms" Content="{Binding [Nav.Alarms]}" Click="NavAlarms_Click"
                        Height="44" FontSize="13" HorizontalContentAlignment="Left" Padding="14,0"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource Text.PrimaryBrush}"/>
            </StackPanel>

            <Border Grid.Column="1" Background="{DynamicResource Screen.BackgroundBrush}" Margin="4">
                <ContentControl x:Name="MainContent"/>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{DynamicResource Status.ManualBrush}">
            <TextBlock x:Name="StatusText"
                       Text="{StaticResource Shell.StatusReady}"
                       Foreground="{DynamicResource Text.PrimaryBrush}" FontSize="11"
                       VerticalAlignment="Center" Margin="8,0"/>
        </Border>
    </Grid>
</Window>
