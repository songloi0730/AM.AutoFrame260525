<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>AM.Application.Shell</RootNamespace>
    <AssemblyName>AM.Application.Shell</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Prism + DryIoc DI container -->
    <PackageReference Include="Prism.DryIoc" />

    <!-- Logging: Serilog -->
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.Console" />

    <!-- Configuration — explicit reference để wpftmp build pass resolve đúng -->
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />

    <!-- EF Core + SQLite -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />

    <!-- BCrypt for password hashing (R-SEC-01) -->
    <PackageReference Include="BCrypt.Net-Next" />
  </ItemGroup>

  <ItemGroup>
    <None Update="io.map.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="axismap.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="machine.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="lang\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AM.Core\AM.Core.csproj" />
    <ProjectReference Include="..\AM.Core.Abstractions\AM.Core.Abstractions.csproj" />
    <ProjectReference Include="..\AM.UI.Localization\AM.UI.Localization.csproj" />
    <ProjectReference Include="..\AM.Infrastructure\AM.Infrastructure.csproj" />
    <ProjectReference Include="..\AM.Data\AM.Data.csproj" />
    <ProjectReference Include="..\AM.Services\AM.Services.csproj" />
    <ProjectReference Include="..\AM.Hardware.Motion\AM.Hardware.Motion.csproj" />
    <ProjectReference Include="..\AM.Hardware.Vision\AM.Hardware.Vision.csproj" />
    <ProjectReference Include="..\AM.Hardware.IO\AM.Hardware.IO.csproj" />
    <ProjectReference Include="..\AM.Hardware.Comm\AM.Hardware.Comm.csproj" />
    <ProjectReference Include="..\AM.Hardware.Scanner\AM.Hardware.Scanner.csproj" />
    <ProjectReference Include="..\AM.Modules.Dashboard\AM.Modules.Dashboard.csproj" />
    <ProjectReference Include="..\AM.Modules.Alarm\AM.Modules.Alarm.csproj" />
    <ProjectReference Include="..\AM.Modules.Identity\AM.Modules.Identity.csproj" />
    <ProjectReference Include="..\AM.Modules.IoMonitor\AM.Modules.IoMonitor.csproj" />
    <ProjectReference Include="..\AM.Modules.Motion\AM.Modules.Motion.csproj" />
    <ProjectReference Include="..\AM.Modules.Parameter\AM.Modules.Parameter.csproj" />
    <ProjectReference Include="..\AM.Modules.Engineering\AM.Modules.Engineering.csproj" />
    <ProjectReference Include="..\AM.WorkStation.Demo\AM.WorkStation.Demo.csproj" />
  </ItemGroup>

</Project>
