<!--
    ParameterView.xaml — AM.Modules.Parameter
    ISA-101 Level-2 Screen: Recipe & Parameter Management
    ════════════════════════════════════════════════════════════════════════
    Layout:
      [Header] Recipe selector combobox + Save/Load/Export buttons
      [Tabs  ] Recipe | Parameters | History
        Recipe tab:   GroupBox per [ParamView] group → auto-rendered input rows
        Param tab:    Flat table of all parameters (Name/Value/Unit/Min/Max)
        History tab:  Recipe change log DataGrid
    ════════════════════════════════════════════════════════════════════════
-->
<UserControl x:Class="AM.Modules.Parameter.ParameterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{DynamicResource Screen.BackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Parameter row template (Label + TextBox + Unit label + Min/Max hint) -->
        <DataTemplate x:Key="ParamRowTemplate">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>   <!-- Label -->
                    <ColumnDefinition Width="130"/>   <!-- Input -->
                    <ColumnDefinition Width="60"/>    <!-- Unit -->
                    <ColumnDefinition Width="*"/>     <!-- Range hint -->
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding Label}"
                           Foreground="{DynamicResource Text.PrimaryBrush}"
                           FontSize="13"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Label}"/>

                <TextBox Grid.Column="1"
                         Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                         IsReadOnly="{Binding IsReadOnly}"
                         Style="{StaticResource InputBox}"
                         Margin="0,0,8,0"/>

                <TextBlock Grid.Column="2"
                           Text="{Binding Unit}"
                           Foreground="{DynamicResource Text.SecondaryBrush}"
                           FontSize="12" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="3"
                           Foreground="{DynamicResource Text.DisabledBrush}"
                           FontSize="11" VerticalAlignment="Center">
                    <Run Text="["/><Run Text="{Binding MinValue}"/>
                    <Run Text=" – "/><Run Text="{Binding MaxValue}"/><Run Text="]"/>
                </TextBlock>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Header: Recipe selector + buttons -->
            <RowDefinition Height="12"/>     <!-- Spacer -->
            <RowDefinition Height="*"/>      <!-- TabControl content -->
        </Grid.RowDefinitions>

        <!-- ═══ Header: Recipe selector ════════════════════════════════════════ -->
        <Border Grid.Row="0" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Recipe label -->
                <TextBlock Grid.Column="0"
                           Text="Recipe:" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text.HeadingBrush}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>

                <!-- Recipe ComboBox -->
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding AvailableRecipes}"
                          SelectedItem="{Binding SelectedRecipeName}"
                          Style="{StaticResource InputCombo}"
                          DisplayMemberPath="Name"/>

                <!-- Unsaved changes indicator -->
                <TextBlock Grid.Column="2"
                           Text="● Có thay đổi chưa lưu"
                           Foreground="{DynamicResource Status.WarningBrush}"
                           FontSize="12" VerticalAlignment="Center" Margin="12,0"
                           Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVis}}"/>

                <!-- Action buttons -->
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Content="📂 Tải" Command="{Binding LoadCommand}"
                            Style="{StaticResource ButtonBase}"
                            Width="80" Margin="0,0,6,0"
                            Background="{DynamicResource Button.PrimaryBrush}"/>
                    <Button Content="💾 Lưu" Command="{Binding SaveCommand}"
                            Style="{StaticResource ButtonBase}"
                            Width="80" Margin="0,0,6,0"
                            Background="{DynamicResource Status.NormalBrush}"/>
                    <Button Content="📤 Export" Command="{Binding ExportCommand}"
                            Style="{StaticResource ButtonBase}"
                            Width="90" Margin="0,0,6,0"
                            Background="{DynamicResource Button.NeutralBrush}"/>
                    <Button Content="📥 Import" Command="{Binding ImportCommand}"
                            Style="{StaticResource ButtonBase}"
                            Width="90"
                            Background="{DynamicResource Button.NeutralBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Tab Control ══════════════════════════════════════════════════ -->
        <TabControl Grid.Row="2"
                    Background="{DynamicResource Panel.BackgroundBrush}"
                    BorderBrush="{DynamicResource Border.DefaultBrush}">

            <!-- ─── Tab 1: Recipe (grouped by [ParamView] group attr) ──── -->
            <TabItem Header="📋 Recipe">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="4">
                    <ItemsControl ItemsSource="{Binding ParameterGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- GroupBox per parameter group -->
                                <GroupBox Margin="0,0,0,12">
                                    <GroupBox.Header>
                                        <TextBlock Text="{Binding GroupName}"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{DynamicResource Text.HeadingBrush}"/>
                                    </GroupBox.Header>
                                    <ItemsControl ItemsSource="{Binding Parameters}"
                                                  ItemTemplate="{StaticResource ParamRowTemplate}"
                                                  Margin="8,4"/>
                                </GroupBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <!-- ─── Tab 2: Parameters (flat table, sortable) ─────────── -->
            <TabItem Header="📊 Tất cả tham số">
                <DataGrid ItemsSource="{Binding AllParameters}"
                          AutoGenerateColumns="False"
                          IsReadOnly="False"
                          CanUserAddRows="False"
                          GridLinesVisibility="Horizontal"
                          Background="{DynamicResource Panel.BackgroundBrush}"
                          Foreground="{DynamicResource Text.PrimaryBrush}"
                          BorderBrush="{DynamicResource Border.DefaultBrush}"
                          RowBackground="{DynamicResource Grid.RowBrush}"
                          AlternatingRowBackground="{DynamicResource Grid.AltRowBrush}"
                          ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="4">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nhóm" Binding="{Binding GroupName}"
                                            Width="130" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Tham số" Binding="{Binding Label}"
                                            Width="200" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Giá trị" Binding="{Binding Value}"
                                            Width="130"/>
                        <DataGridTextColumn Header="Đơn vị" Binding="{Binding Unit}"
                                            Width="80" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Min" Binding="{Binding MinValue}"
                                            Width="80" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Max" Binding="{Binding MaxValue}"
                                            Width="80" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Mô tả" Binding="{Binding Description}"
                                            Width="*" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- ─── Tab 3: Lịch sử thay đổi recipe ──────────────────── -->
            <TabItem Header="🕒 Lịch sử">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="🗑 Xoá lịch sử"
                                Command="{Binding ClearHistoryCommand}"
                                Style="{StaticResource ButtonBase}"
                                Width="120" Height="36"
                                Background="{DynamicResource Button.NeutralBrush}"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding RecipeHistory}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False"
                              Background="{DynamicResource Panel.BackgroundBrush}"
                              Foreground="{DynamicResource Text.PrimaryBrush}"
                              BorderBrush="{DynamicResource Border.DefaultBrush}"
                              RowBackground="{DynamicResource Grid.RowBrush}"
                              AlternatingRowBackground="{DynamicResource Grid.AltRowBrush}"
                              ColumnHeaderStyle="{StaticResource GridHeaderStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Thời gian"
                                                Binding="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                                                Width="160" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Recipe" Binding="{Binding RecipeName}"
                                                Width="150"/>
                            <DataGridTextColumn Header="Người dùng" Binding="{Binding UserName}"
                                                Width="120"/>
                            <DataGridTextColumn Header="Thay đổi" Binding="{Binding ChangeDescription}"
                                                Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
