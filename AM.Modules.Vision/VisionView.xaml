<!--
    VisionView.xaml — AM.Modules.Vision
    ISA-101 Level-2 Screen: Vision Inspection Monitor
    ════════════════════════════════════════════════════════════════════════
    Layout:
      [Header] Camera selector + Trigger + Live/Freeze toggle
      [Body  ]
        Left (60%): Camera image display + PASS/FAIL overlay banner
        Right(40%):
          [Result panel] Overall result chip + score + tool results table
          [Stats panel ] Pass/Fail/Total counters + yield %
          [Config panel] ROI + threshold sliders (Engineer+)
    ════════════════════════════════════════════════════════════════════════
-->
<UserControl x:Class="AM.Modules.Vision.VisionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{DynamicResource Screen.BackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ Header ═════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Camera:"
                           Foreground="{DynamicResource Text.SecondaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding AvailableCameras}"
                          SelectedItem="{Binding SelectedCamera}"
                          Style="{StaticResource InputCombo}"/>

                <!-- Status badges -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="12,0">
                    <Border CornerRadius="3" Padding="8,2" Margin="0,0,8,0"
                            Background="{DynamicResource Status.NormalBrush}"
                            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="🟢 Connected" FontSize="11"
                                   Foreground="{DynamicResource Status.ForegroundBrush}"
                                   FontWeight="SemiBold"/>
                    </Border>
                    <Border CornerRadius="3" Padding="8,2"
                            Background="{DynamicResource Status.ManualBrush}"
                            Visibility="{Binding IsLive, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="● LIVE" FontSize="11"
                                   Foreground="{DynamicResource Status.ForegroundBrush}"
                                   FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Content="📷 Grab"
                            Command="{Binding GrabCommand}"
                            Style="{StaticResource ButtonBase}"
                            Width="80" Margin="0,0,6,0"
                            Background="{DynamicResource Button.PrimaryBrush}"/>
                    <ToggleButton Content="⟳ Live"
                                  IsChecked="{Binding IsLive}"
                                  Width="80" Height="44" Margin="0,0,6,0"
                                  Background="{DynamicResource Button.NeutralBrush}"
                                  Foreground="{DynamicResource Text.PrimaryBrush}"
                                  BorderThickness="0"/>
                    <Button Content="🔌 Connect"
                            Command="{Binding ConnectCommand}"
                            Style="{StaticResource ButtonBase}"
                            Width="90"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Body ════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>    <!-- Image (60%) -->
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="2*"/>    <!-- Results (40%) -->
            </Grid.ColumnDefinitions>

            <!-- ─── Camera Image Panel ────────────────────────────────────── -->
            <Border Grid.Column="0" Style="{StaticResource Card}"
                    Padding="0" ClipToBounds="True">
                <Grid>
                    <!-- Camera image (BitmapSource bound from ViewModel) -->
                    <Image x:Name="CameraImage"
                           Source="{Binding CurrentFrame}"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>

                    <!-- PASS overlay (ISA-101: semantic green, semi-transparent) -->
                    <Border x:Name="PassOverlay" CornerRadius="0" Padding="16,8"
                            HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                            Background="{DynamicResource Vision.OverlayPassBrush}"
                            Visibility="{Binding IsPass, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="✔ PASS" FontSize="28" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- FAIL overlay -->
                    <Border x:Name="FailOverlay" CornerRadius="0" Padding="16,8"
                            HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                            Background="{DynamicResource Vision.OverlayFailBrush}"
                            Visibility="{Binding IsFail, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="✘ FAIL" FontSize="28" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- No image placeholder -->
                    <Border Background="{DynamicResource Panel.BackgroundAltBrush}"
                            Visibility="{Binding HasNoFrame, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="📷 Không có ảnh" FontSize="18"
                                   Foreground="{DynamicResource Text.DisabledBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ─── Results + Stats + Config ──────────────────────────────── -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- Result chip + score -->
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>      <!-- Tool results table -->
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>   <!-- Stats -->
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>   <!-- Config (Engineer+) -->
                </Grid.RowDefinitions>

                <!-- Overall result -->
                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Kết quả tổng" Style="{StaticResource KpiLabel}"
                                       HorizontalAlignment="Left" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding OverallResult}"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="{Binding ResultBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding OverallScore, StringFormat='{}{0:P0}'}"
                                       Style="{StaticResource KpiValue}" FontSize="24"/>
                            <TextBlock Text="Score" Style="{StaticResource KpiLabel}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Tool results table -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Chi tiết Tool" Style="{StaticResource SectionHeader}"/>
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding ToolResults}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" GridLinesVisibility="Horizontal"
                                  Background="{DynamicResource Panel.BackgroundBrush}"
                                  Foreground="{DynamicResource Text.PrimaryBrush}"
                                  BorderBrush="{DynamicResource Border.DefaultBrush}"
                                  RowBackground="{DynamicResource Grid.RowBrush}"
                                  AlternatingRowBackground="{DynamicResource Grid.AltRowBrush}"
                                  ColumnHeaderStyle="{StaticResource GridHeaderStyle}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="OK" Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Ellipse Width="12" Height="12" HorizontalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill"
                                                                Value="{StaticResource Vision.FailBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Passed}" Value="True">
                                                                <Setter Property="Fill"
                                                                        Value="{StaticResource Vision.PassBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Tool" Binding="{Binding ToolName}" Width="*"/>
                                <DataGridTextColumn Header="Score" Binding="{Binding Score, StringFormat=F3}"
                                                    Width="70"/>
                                <DataGridTextColumn Header="Ngưỡng" Binding="{Binding Threshold, StringFormat=F3}"
                                                    Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Stats: Pass/Fail counters + yield -->
                <Border Grid.Row="4" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding TotalCount}" Style="{StaticResource KpiValue}"
                                       FontSize="20" Foreground="{DynamicResource Text.PrimaryBrush}"/>
                            <TextBlock Text="Total" Style="{StaticResource KpiLabel}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding PassCount}" Style="{StaticResource KpiValue}"
                                       FontSize="20" Foreground="{StaticResource Status.NormalBrush}"/>
                            <TextBlock Text="Pass" Style="{StaticResource KpiLabel}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding FailCount}" Style="{StaticResource KpiValue}"
                                       FontSize="20" Foreground="{StaticResource Status.AlarmBrush}"/>
                            <TextBlock Text="Fail" Style="{StaticResource KpiLabel}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Yield, StringFormat='{}{0:P1}'}"
                                       Style="{StaticResource KpiValue}" FontSize="20"/>
                            <TextBlock Text="Yield" Style="{StaticResource KpiLabel}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Config panel (Engineer+ only) -->
                <Border Grid.Row="6" Style="{StaticResource Card}"
                        Visibility="{Binding IsConfigVisible, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="⚙ Cấu hình (Engineer+)" Style="{StaticResource SectionHeader}"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Threshold:"
                                       Foreground="{DynamicResource Text.SecondaryBrush}"
                                       FontSize="12" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="1"
                                    Value="{Binding GlobalThreshold}"
                                    VerticalAlignment="Center" Margin="4,0"/>
                            <TextBlock Grid.Column="2"
                                       Foreground="{DynamicResource Text.LiveValueBrush}"
                                       FontFamily="Consolas" FontSize="12"
                                       VerticalAlignment="Center">
                                <Run Text="{Binding GlobalThreshold, StringFormat=F2}"/>
                            </TextBlock>
                        </Grid>
                        <Button Content="💾 Save Config"
                                Command="{Binding SaveConfigCommand}"
                                Style="{StaticResource ButtonBase}"
                                Height="36" Width="120"
                                Background="{DynamicResource Status.NormalBrush}"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
