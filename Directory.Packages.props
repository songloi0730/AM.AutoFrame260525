<Project>

  <!-- =======================================================
       Central Package Management — quản lý version NuGet tập trung.
       Mọi <PackageReference> trong các .csproj KHÔNG ghi Version;
       version lấy từ <PackageVersion> dưới đây (chống version drift giữa 17 projects).
       ======================================================= -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Analyzers (áp cho mọi project qua Directory.Build.props) — CPM cấm floating, phải pin cụ thể -->
    <PackageVersion Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="9.0.0" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="9.32.0.97167" />

    <!-- Microsoft.Extensions (.NET 9) -->
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="9.0.0" />

    <!-- EF Core + SQLite -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="9.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.0" />

    <!-- UI / DI -->
    <PackageVersion Include="Prism.DryIoc" Version="9.0.537" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.3.2" />

    <!-- Logging sinks -->
    <PackageVersion Include="Serilog.Extensions.Logging" Version="9.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.0.0" />

    <!-- Security -->
    <PackageVersion Include="BCrypt.Net-Next" Version="4.0.3" />

    <!-- Hardware: chỉ System.IO.Ports đang active. Vendor SDK (NModbus4/FluentModbus/libplctag/
         OPCFoundation/Basler.Pylon) hiện COMMENT trong csproj — khi kích hoạt, thêm PackageVersion
         với version CỤ THỂ tại đây (CPM không cho phép floating version như 2.* / *). -->
    <PackageVersion Include="System.IO.Ports" Version="9.0.0" />

    <!-- Test stack -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="FluentAssertions" Version="6.12.1" />
  </ItemGroup>

</Project>
